---
/* Every AOH page: head, header, footer, and the two small scripts (scroll
   reveals and the highlighter). */
import '../styles/aoh.css';
import Icon from '../components/Icon.astro';
import { SERVICES } from '../data/aoh';
interface Props {
  title: string;
  description: string;
  /** Path for the canonical link, e.g. "/framework". */
  path: string;
  /** Social preview image path under /assets/. */
  og?: string;
  noindex?: boolean;
  /** Workshop focus: no header and a slim footer, so nothing pulls people away. The page shows its own logo. */
  focus?: boolean;
}
const { title, description, path, og = '/assets/og-home.jpg', noindex = false, focus = false } = Astro.props;
/** The check-in always opens in its own tab (it's used live in workshops). */
const CHECKIN = '/fulfilment-check-in';
const SITE = 'https://artistry-of-humanity.com';
const canonical = SITE + (path === '/' ? '/' : path);
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const NAV = [
  ['/what-we-do/keynotes-workshops', 'Keynotes'],
  ['/framework', 'Framework'],
  ['/about', 'About'],
];
const cur = (href: string) => (here === href ? 'page' : undefined);
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: 'The Artistry of Humanity', url: SITE + '/', logo: SITE + '/assets/aoh-logo-new.png', founder: { '@type': 'Person', name: 'Ian Williams' }, sameAs: ['https://www.linkedin.com/company/artistry-of-humanity'] };
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="only light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Artistry of Humanity" />
    <meta property="og:image" content={SITE + og} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) document.documentElement.classList.add('js');</script>
  </head>
  <body>
    {!focus && <header class="hd">
      <div class="wrap hd-bar">
        <a class="brand" href="/" aria-label="The Artistry of Humanity, home">
          <img src="/assets/aoh-logo-new.png" alt="" width="34" height="34" />
          <span><b>Artistry of Humanity</b><small>Culture &amp; leadership</small></span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href={NAV[0][0]} aria-current={cur(NAV[0][0])}>{NAV[0][1]}</a>
          <div class="dd">
            <a href="/what-we-do" aria-current={here.startsWith('/what-we-do') && here !== NAV[0][0] && here !== '/what-we-do/norma' ? 'page' : undefined}>Ways to work<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></a>
            <div class="dd-p">
              <div class="dd-in">
                {SERVICES.map(sv => <a href={sv.href}><span class="ico"><Icon name={sv.icon} size={20} /></span><span><b>{sv.title}</b><small>{sv.line}</small></span></a>)}
                <a class="dd-norma" href="/what-we-do/norma"><img src="/assets/norma-app-icon.png" alt="" width="44" height="44" /><span><b>nørma: wellbeing at scale</b><small>Every person, every team, every month. The rest of our work, kept going.</small></span><span class="dd-go">Meet nørma ›</span></a>
                <div class="dd-foot"><a href="/what-we-do">All ways to work ›</a></div>
              </div>
            </div>
          </div>
          {NAV.slice(1).map(([href, label]) => <a href={href} aria-current={cur(href)}>{label}</a>)}
          <a href={CHECKIN} target="_blank">Check in</a>
          <a class="norma" href="/what-we-do/norma" aria-current={cur('/what-we-do/norma')}><img src="/assets/norma-app-icon.png" alt="" width="24" height="24" />nørma</a>
        </nav>
        <div style="display:flex;align-items:center;gap:10px">
          <a class="btn btn-lime" href="/contact">Book a call</a>
          <details class="menu">
            <summary aria-label="Menu"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 8h16M4 16h16" /></svg></summary>
            <nav aria-label="Menu">
              <a href="/what-we-do/norma">nørma</a>
              <a href="/what-we-do">Ways to work</a>
              <div class="m-sub">{SERVICES.map(sv => <a href={sv.href}>{sv.title}</a>)}</div>
              {NAV.slice(1).map(([href, label]) => <a href={href}>{label}</a>)}
              <a href={CHECKIN} target="_blank">Check in</a>
              <a href="/contact">Book a call</a>
            </nav>
          </details>
        </div>
      </div>
    </header>}
    <main>
      <slot />
    </main>
    <footer class:list={['ft', { 'ft-slim': focus }]}>
      <div class="wrap">
        {!focus && <div class="ft-top">
          <div style="max-width:320px">
            <a class="brand" href="/"><img src="/assets/aoh-logo-new.png" alt="" width="34" height="34" /><span><b>Artistry of Humanity</b><small>Culture &amp; leadership consultancy</small></span></a>
            <p class="small" style="margin-top:18px;color:rgba(201,212,194,.7)">Keynotes, leadership work and nørma, for organisations that want their people at their best.</p>
          </div>
          <div class="ft-cols">
            <div><b>Work with us</b><a href="/what-we-do/keynotes-workshops">Keynotes &amp; workshops</a><a href="/what-we-do/masterclass">Masterclass</a><a href="/what-we-do/leadership-coaching">Leadership coaching</a><a href="/what-we-do/wellness-accelerator">Wellness Accelerator</a><a href="/what-we-do/culture-consulting">Culture consulting</a></div>
            <div><b>Explore</b><a href="/framework">The Five Pillars</a><a href={CHECKIN} target="_blank">Fulfilment check-in</a><a href="/human-strategy">Human strategy</a><a href="/what-we-do/norma">nørma</a><a href="https://joinnorma.com/">joinnorma.com ↗</a></div>
            <div><b>Company</b><a href="/about">About</a><a href="/contact">Contact</a><a href="https://www.linkedin.com/company/artistry-of-humanity">LinkedIn ↗</a></div>
          </div>
        </div>}
        <div class="ft-bot"><span>© 2026 The Artistry of Humanity Pty Ltd</span><span><a href="/privacy">Privacy policy</a></span></div>
      </div>
    </footer>
    <script is:inline>(() => {
      // Tabs: [data-tabs] holds role=tab buttons and role=tabpanel panels, in the
      // same order. [data-auto="ms"] moves on by itself while on screen, until
      // someone picks a tab or hovers, and never with reduced motion.
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('[data-tabs]').forEach(root => {
        const tabs = [...root.querySelectorAll('[role=tab]')].filter(t => t.closest('[data-tabs]') === root);
        const panels = [...root.querySelectorAll('[role=tabpanel]')].filter(p => p.closest('[data-tabs]') === root);
        if (!tabs.length) return;
        root.classList.add('tabs-on');
        const ms = +root.dataset.auto || 0;
        let i = 0, timer = 0, stopped = still || !ms, seen = false;
        const pick = (n, focus, moved = true) => {
          if (moved && (n + tabs.length) % tabs.length !== i) root.classList.add('tabs-moved');
          i = (n + tabs.length) % tabs.length;
          tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; const b = t.querySelector('.v-bar'); if (b) { b.classList.remove('run'); if (k === i && !stopped && seen) { void b.offsetWidth; b.style.setProperty('--t', ms + 'ms'); b.classList.add('run'); } } });
          panels.forEach((p, k) => { p.hidden = k !== i; });
          if (focus) tabs[i].focus();
          clearTimeout(timer);
          if (!stopped && seen) timer = setTimeout(() => pick(i + 1), ms);
        };
        const stop = () => { stopped = true; clearTimeout(timer); root.querySelectorAll('.v-bar.run').forEach(b => b.classList.remove('run')); };
        tabs.forEach((t, k) => {
          t.addEventListener('click', () => { stop(); pick(k); });
          t.addEventListener('keydown', e => {
            const d = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
            if (d) { e.preventDefault(); stop(); pick(i + d, true); }
          });
        });
        if (ms && !stopped) {
          root.addEventListener('mouseenter', stop, { once: true });
          root.addEventListener('focusin', stop, { once: true });
          if ('IntersectionObserver' in window) new IntersectionObserver(([e], o) => { if (e.isIntersecting) { seen = true; o.disconnect(); pick(i, false, false); } }, { threshold: .4 }).observe(root);
        }
        pick(0, false, false);
      });
    })();</script>
    <script is:inline>(() => {
      if (!document.documentElement.classList.contains('js')) return;
      const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('on'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: .15 });
      document.querySelectorAll('.mk, [data-rv]').forEach(el => io.observe(el));
      // Video facades: load the YouTube player only when someone presses play.
      document.querySelectorAll('[data-yt]').forEach(b => b.addEventListener('click', () => {
        const f = document.createElement('iframe');
        f.src = 'https://www.youtube-nocookie.com/embed/' + b.dataset.yt + '?autoplay=1&rel=0';
        f.allow = 'autoplay; encrypted-media; picture-in-picture'; f.allowFullscreen = true; f.title = b.getAttribute('aria-label') || 'Video';
        b.parentElement.replaceChildren(f);
      }));
    })();</script>
  </body>
</html>
