---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Voices from '../components/Voices.astro';
import { CLIENTS } from '../data/aoh';

const BOOKING_URL = 'https://calendar.app.google/P14aVTpPNqgrVAbHA';
const INTERESTS = ['Consulting', 'Masterclass', 'Wellness Accelerator', 'Leadership Coaching', 'Keynote or Workshop', 'nørma', 'Just exploring'];

// What people come here for. Two go straight out (the booking calendar, the
// nørma demo); two open the form with the interest already picked.
const CHOICES = [
  { icon: 'calendar', tag: 'Free · 30 min', title: 'Talk it through with Ian', text: 'A direct conversation about what’s happening in your organisation, and where we can help.', cta: 'Book a slot ↗', href: BOOKING_URL, dark: true },
  { icon: 'mic', tag: 'Keynotes', title: 'Book Ian to speak', text: 'A keynote for your conference or all-hands, or a workshop for one team.', cta: 'Ask about your event', href: '#message', interest: 'Keynote or Workshop' },
  { icon: 'board', tag: '60–90 min', title: 'A Masterclass', text: 'A working session for your leadership team, built on the Five Pillars.', cta: 'Ask about a Masterclass', href: '#message', interest: 'Masterclass' },
  { icon: 'norma', tag: 'nørma', title: 'See nørma', text: 'Wellbeing at scale: the app for your people and the dashboard for you, in a demo.', cta: 'Book a demo ↗', href: 'https://joinnorma.com/book-a-demo/', norma: true },
] as const;

const CALL = ['Get to know each other', 'Unpack the challenges you’re facing', 'Explore how a human strategy might help', 'Leave with something useful, either way'];

const FAQ = [
  { q: 'Is the first conversation really free?', a: 'Yes. Thirty minutes with Ian, free and without obligation. No pitch and no sales pressure.' },
  { q: 'What happens on the call?', a: 'You get to know each other, unpack the challenges you’re facing and explore how a human strategy might help. Either way, you leave with something useful.' },
  { q: 'How quickly will we hear back?', a: 'Within one working day.' },
  { q: 'Do you work outside Australia?', a: 'Yes. We work in person or virtually, across Australia and internationally.' },
  { q: 'We’re not sure what we need yet.', a: 'That’s what the call is for. Tell us what you’re seeing in your organisation, and we’ll show you where nørma, a keynote or the Five Pillars could help. On the form, “Just exploring” is a perfectly good answer.' },
  { q: 'Can I just send an email?', a: 'Of course. Write to <a href="mailto:ian@artistry-of-humanity.com">ian@artistry-of-humanity.com</a> for anything that doesn’t fit the form.' },
  { q: 'Where can I get a feel for how Ian thinks?', a: 'Listen to the podcast, follow along on LinkedIn, or take the free <a href="/fulfilment-check-in">Fulfilment check-in</a> and see your own picture across the Five Pillars.' },
];
---
<Base title="Contact · The Artistry of Humanity" description="Book thirty minutes with Ian Williams, or send us a message about keynotes, a Masterclass, programs or nørma. We reply within one working day." path="/contact">

  <!-- Hero: Ian, and an open door -->
  <section class="bg-dark" style="overflow:hidden">
    <div class="glow" style="right:-10%;top:-40%;width:70%;background:radial-gradient(closest-side,rgba(217,234,110,.14),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap split" style="padding-top:clamp(48px,7vw,96px);padding-bottom:clamp(110px,12vw,170px)">
      <div style="max-width:600px">
        <span class="eyebrow">Get in touch</span>
        <h1 style="color:var(--on-dark)">Let’s start a <span class="mk mk-d">conversation</span>.</h1>
        <p class="lead">Exploring a program, looking for a keynote speaker, or just want to know if we’re the right fit? Reach out. We reply within one working day.</p>
        <div class="btns">
          <a class="btn btn-lime" href={BOOKING_URL} rel="noopener">Book a free 30-minute call ↗</a>
          <a class="btn btn-ghost" href="#message">Write to us</a>
        </div>
      </div>
      <figure class="hero-ian">
        <div class="arch hero-arch"><img src="/assets/ian-portrait.webp" alt="Ian Williams" width="900" height="802" /></div>
        <figcaption class="hero-card">
          <span class="hc-ico" aria-hidden="true"><Icon name="talk" size={20} /></span>
          <span><b>Ian Williams</b><span>Founder and CEO, The Artistry of Humanity</span></span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- What would you like to do? -->
  <section class="lift" style="background:var(--cream)">
    <div class="wrap sec-tight">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">Start here</span><h2>What would you like to do?</h2></div>
        <p class="lead" style="margin-top:0">Pick the closest fit. If none of them is quite right, <a class="inl" href="#message" data-interest="Just exploring">write to us</a> and tell us what you have in mind.</p>
      </div>
      <div class="choices">
        {CHOICES.map(c => (
          <a class:list={['choice', 'dark' in c ? 'card-dark' : 'card']} href={c.href} data-interest={'interest' in c ? c.interest : undefined} rel={c.href.startsWith('http') ? 'noopener' : undefined} data-rv>
            <div class="ch-top">
              {'norma' in c ? <img src="/assets/norma-app-icon.png" alt="" width="52" height="52" class="ch-norma" /> : <span class="ico"><Icon name={c.icon} /></span>}
              <span class="pill">{c.tag}</span>
            </div>
            <h3>{c.title}</h3>
            <p class="body">{c.text}</p>
            <span class="link">{c.cta}{c.href.startsWith('#') && '\u00a0›'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- The call, or the form -->
  <section class="bg-sand lift-b">
    <div class="wrap sec split" style="align-items:start">
      <div style="flex:1 1 380px">
        <span class="eyebrow">Book time with Ian</span>
        <h2>Start with <span class="mk">a conversation</span>.</h2>
        <p class="lead">Thirty minutes with Ian, direct. Free, and without obligation.</p>
        <div class="card-dark book" data-rv>
          <div class="book-hd">
            <div class="avatar"><img src="/assets/ian-portrait.webp" alt="" width="900" height="802" /></div>
            <div>
              <span class="pill">Free · 30 minutes · No obligation</span>
              <h3 style="margin-top:10px">A direct conversation with Ian.</h3>
            </div>
          </div>
          <ol class="call">{CALL.map(x => <li>{x}</li>)}</ol>
          <div class="btns" style="margin-top:26px"><a class="btn btn-lime" href={BOOKING_URL} rel="noopener">Book a slot ↗</a></div>
        </div>
      </div>

      <div style="flex:1 1 460px" id="message">
        <span class="eyebrow">Or write us a message</span>
        <form class="card form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks" data-rv>
          <input type="hidden" name="form-name" value="contact" />
          <p hidden><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <label class="field"><span>What are you most interested in?</span>
            <select name="interest" required>
              <option value="">Choose one</option>
              {INTERESTS.map(o => <option value={o}>{o}</option>)}
            </select>
          </label>
          <div class="fields">
            <label class="field"><span>Your name</span><input type="text" name="name" autocomplete="name" maxlength="100" required /></label>
            <label class="field"><span>Work email</span><input type="email" name="email" autocomplete="email" maxlength="255" required /></label>
            <label class="field"><span>Company</span><input type="text" name="company" autocomplete="organization" maxlength="150" required /></label>
            <label class="field"><span>Phone (optional)</span><input type="tel" name="phone" autocomplete="tel" maxlength="30" /></label>
          </div>
          <label class="field"><span>Your message (optional)</span><textarea name="message" rows="5" maxlength="1000" placeholder="Tell us a little about your team, your event, or where you are right now. The more context, the better."></textarea></label>
          <button class="btn btn-lime" type="submit">Send message</button>
          <p class="trust"><span>Reply within one working day</span><span>No sales pressure</span><span>Private &amp; secure</span></p>
        </form>
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section class="lift" style="background:var(--cream)">
    <div class="wrap sec">
      <span class="eyebrow">What people say</span>
      <div style="margin-top:28px"><Voices names={['Sorin Popa', 'Cassie Fleming', 'Andreas Bicking']} /></div>
      <div class="trusted">
        <span class="eyebrow">Trusted by</span>
        <p class="names" style="margin:20px 0 0">{CLIENTS.map(c => <span>{c}</span>)}</p>
      </div>
    </div>
  </section>

  <!-- Questions, and other ways in -->
  <section class="bg-sand lift-b">
    <div class="wrap sec">
      <div class="split" style="align-items:flex-start">
        <div class="faq-hd">
          <span class="eyebrow">Good to know</span>
          <h2>Common questions</h2>
          <p class="lead">Short answers to what people usually ask before they get in touch.</p>
        </div>
        <div class="accs" style="flex:1 1 480px">
          {FAQ.map((f, i) => (
            <details class="acc" open={i === 0}>
              <summary>{f.q}</summary>
              <div class="acc-body"><p set:html={f.a} /></div>
            </details>
          ))}
        </div>
      </div>

      <div class="ways">
        <div class="feat">
          <span class="ico"><Icon name="mail" size={22} /></span>
          <div>
            <h3>Email us directly</h3>
            <p class="body">For enquiries that don’t fit the form, or if you’d rather just send a note.</p>
            <a class="link mail" href="mailto:ian@artistry-of-humanity.com">ian@artistry-of-humanity.com</a>
          </div>
        </div>
        <div class="feat pod">
          <img src="/assets/podcast-cover.webp" alt="The Artistry of Humanity podcast cover, with Ian Williams" width="900" height="900" loading="lazy" />
          <div>
            <h3>Listen to the podcast</h3>
            <p class="body">Honest conversations about leadership, culture and what it means to be human at work.</p>
            <p class="links">
              <a class="link" href="https://open.spotify.com/show/6C9jBcH8FHdlAdaQL9lfEQ" rel="noopener">Spotify ↗</a>
              <a class="link" href="https://podcasts.apple.com/ca/podcast/the-artistry-of-humanity/id1775703355" rel="noopener">Apple Podcasts ↗</a>
              <a class="link" href="https://www.youtube.com/@alignwithwillo" rel="noopener">YouTube ↗</a>
            </p>
          </div>
        </div>
        <div class="feat">
          <span class="ico"><Icon name="users" size={22} /></span>
          <div>
            <h3>Follow along</h3>
            <p class="body">See what we’re building and get a feel for how we think.</p>
            <p class="links">
              <a class="link" href="https://www.linkedin.com/company/artistry-of-humanity" rel="noopener">AOH on LinkedIn ↗</a>
              <a class="link" href="https://www.linkedin.com/in/ian-williams077/" rel="noopener">Ian on LinkedIn ↗</a>
              <a class="link" href="https://www.instagram.com/alignwithwillo/" rel="noopener">Ian on Instagram ↗</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Close: the call, and what to expect -->
  <section class="bg-dark lift">
    <div class="glow" style="left:50%;bottom:-60%;width:70%;transform:translateX(-50%);background:radial-gradient(closest-side,rgba(217,234,110,.12),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap sec-tight center close">
      <div class="close-av" aria-hidden="true"><img src="/assets/ian-portrait.webp" alt="" width="900" height="802" loading="lazy" /></div>
      <h2>Thirty minutes. <span class="mk mk-d">No pitch.</span></h2>
      <p class="assure"><span>We reply within one working day</span><span>The first conversation is always free and without obligation</span><span>In person or virtual, across Australia and internationally</span></p>
      <div class="btns"><a class="btn btn-lime" href={BOOKING_URL} rel="noopener">Book a slot ↗</a><a class="btn btn-ghost" href="#message">Write to us</a></div>
    </div>
  </section>
</Base>

<script is:inline>(() => {
  // A choice that opens the form picks its interest for you.
  const sel = document.querySelector('form[name=contact] select[name=interest]');
  document.querySelectorAll('[data-interest]').forEach(a => a.addEventListener('click', () => {
    if (!sel) return;
    sel.value = a.dataset.interest;
    sel.classList.add('picked');
    setTimeout(() => { const n = document.querySelector('form[name=contact] input[name=name]'); if (n) n.focus({ preventScroll: true }); }, 500);
  }));
})();</script>

<style>
  .wrap.sec{padding-left:var(--gut);padding-right:var(--gut)}

  /* Hero: Ian in the arch */
  .hero-ian{position:relative;margin:0;flex:0 1 400px}
  .hero-arch{position:relative;aspect-ratio:420/500;background:radial-gradient(64% 42% at 50% 22%,rgba(217,234,110,.55),rgba(217,234,110,.14) 55%,rgba(217,234,110,0) 82%),linear-gradient(180deg,#24402A,#1A3020 55%,#15281B);box-shadow:0 50px 90px -40px rgba(0,0,0,.7)}
  .hero-arch img{position:absolute;left:50%;bottom:0;width:128%;max-width:none;transform:translateX(-50%)}
  .hero-card{position:absolute;left:-8%;bottom:8%;display:flex;align-items:center;gap:12px;padding:12px 18px 12px 14px;border-radius:20px 16px 20px 14px / 16px 20px 14px 20px;background:rgba(250,248,240,.96);box-shadow:0 24px 50px -20px rgba(0,0,0,.6);color:var(--ink)}
  .hero-card b{display:block;font:600 15px/1.3 var(--sans)}
  .hero-card span span{display:block;font-size:13px;line-height:1.35;color:var(--muted-2)}
  .hc-ico{flex:none;display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:50%;background:var(--lime);color:#152213}
  @media (max-width:860px){.hero-ian{max-width:360px}.hero-card{left:0}}

  /* The four ways in */
  .inl{color:var(--ink);font-weight:600;text-decoration:underline;text-decoration-color:var(--lime-3);text-decoration-thickness:2px;text-underline-offset:3px}
  .choices{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(16px,2vw,24px);margin-top:clamp(36px,4vw,52px)}
  @media (max-width:1080px){.choices{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:600px){.choices{grid-template-columns:1fr}}
  .choice{display:flex;flex-direction:column;transition:transform .3s var(--ease)}
  .choice:hover{transform:translateY(-3px)}
  .ch-top{display:flex;align-items:center;justify-content:space-between;gap:12px}
  .ch-norma{width:52px;height:52px;border-radius:15px}
  .choice h3{margin-top:20px;font-size:clamp(22px,2vw,26px)}
  .choice .body{font-size:15.5px}
  .choice .link{margin-top:auto;padding-top:20px}

  /* The call */
  .book{margin-top:32px}
  .book-hd{display:flex;align-items:center;gap:18px}
  .avatar{flex:none;width:76px;height:76px;border-radius:50%;overflow:hidden;position:relative;background:radial-gradient(70% 60% at 50% 30%,rgba(217,234,110,.7),rgba(217,234,110,.2) 60%,rgba(217,234,110,0) 90%),#2A4630;box-shadow:0 0 0 3px var(--lime)}
  .avatar img{position:absolute;left:50%;top:4px;width:128%;max-width:none;transform:translateX(-50%)}
  @media (max-width:520px){.book-hd{flex-direction:column;align-items:flex-start}}
  .call{list-style:none;margin:24px 0 0;padding:0;counter-reset:c}
  .call li{position:relative;padding:12px 0 12px 46px;border-top:1px solid var(--line-dark);counter-increment:c;color:var(--on-dark)}
  .call li::before{content:counter(c);position:absolute;left:0;top:10px;display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:rgba(217,234,110,.14);color:var(--lime);font:600 13px var(--sans)}

  /* The form */
  .form{display:grid;gap:16px;margin-top:20px}
  .form select:invalid{color:var(--muted-2)}
  .form option{color:var(--ink)}
  .form select.picked{border-color:var(--olive);background-color:rgba(217,234,110,.18)}
  .form textarea::placeholder{color:var(--muted-2)}
  .form .btn{width:100%;margin-top:6px}
  .trust{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 18px;margin:4px 0 0;font-size:13px;color:var(--muted-2)}
  .trust span::before{content:'';display:inline-block;width:6px;height:6px;margin:0 8px 2px 0;border-radius:50%;background:var(--lime-3)}

  /* Proof */
  .trusted{margin-top:clamp(56px,6vw,88px);padding-top:32px;border-top:1px solid var(--line);text-align:center}

  /* FAQ and other ways in */
  .faq-hd{flex:0 1 380px}
  @media (min-width:900px){.faq-hd{position:sticky;top:110px}}
  .acc-body :global(a){color:var(--ink);font-weight:600;text-decoration:underline;text-decoration-color:var(--lime-3);text-decoration-thickness:2px;text-underline-offset:3px;overflow-wrap:anywhere}
  .ways{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:32px clamp(28px,4vw,56px);margin-top:clamp(56px,6vw,88px);padding-top:clamp(36px,4vw,52px);border-top:1px solid var(--line)}
  .ways h3{font-size:clamp(21px,2vw,24px)}
  .ways .body{font-size:15.5px}
  .ways .link{margin-top:10px}
  .links{display:flex;flex-direction:column;align-items:flex-start;margin:6px 0 0}
  .links .link{margin-top:8px}
  .mail{overflow-wrap:anywhere}
  .pod img{flex:none;width:72px;height:72px;border-radius:16px 12px 16px 10px / 12px 16px 10px 16px;box-shadow:0 14px 30px -14px rgba(20,35,26,.5)}

  /* Close */
  .close{position:relative}
  .close-av{position:relative;width:88px;height:88px;margin:0 auto;border-radius:50%;overflow:hidden;background:radial-gradient(70% 60% at 50% 30%,rgba(217,234,110,.7),rgba(217,234,110,.2) 60%,rgba(217,234,110,0) 90%),#2A4630;box-shadow:0 0 0 4px var(--lime)}
  .close-av img{position:absolute;left:50%;top:5px;width:128%;max-width:none;transform:translateX(-50%)}
  .close h2{margin-top:22px}
  .assure{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 26px;max-width:860px;margin:22px auto 0;font-size:15px;line-height:1.4;color:var(--on-dark-muted)}
  .assure span{display:inline-flex;align-items:center;gap:9px}
  .assure span::before{content:'';flex:none;width:7px;height:7px;border-radius:50%;background:var(--lime)}
  @media (max-width:640px){.assure{flex-direction:column;align-items:flex-start;width:fit-content;max-width:100%;text-align:left}.assure span{align-items:flex-start}.assure span::before{margin-top:7px}}
</style>
