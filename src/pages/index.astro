---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Voices from '../components/Voices.astro';
import Clients from '../components/Clients.astro';
import { KEYNOTES, PILLARS, CLIENTS, TESTIMONIALS, SHERPANY_SCORES, VIDEO } from '../data/aoh';

// Pentagon geometry, shared by the pillar diagram and the check-in card.
const corner = (cx: number, cy: number, r: number, i: number) => {
  const a = (Math.PI * 2 * i) / 5 - Math.PI / 2;
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
};
const pts = (cx: number, cy: number, r: (i: number) => number) => [0, 1, 2, 3, 4].map(i => corner(cx, cy, r(i), i));
const svgPts = (p: number[][]) => p.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');

// The Five Pillars: five corners, every one joined to every other.
const PG = { cx: 220, cy: 226, r: 152 };
const pgCorners = pts(PG.cx, PG.cy, () => PG.r);
const pgLinks = [0, 1, 2, 3, 4].flatMap(i => [[i, (i + 2) % 5]]);

// The check-in card: a shape for today, a dashed one for where it could go.
const CI = { cx: 160, cy: 166, r: 112 };
const TODAY = [72, 46, 66, 58, 80];
const NEXT = [84, 72, 80, 74, 88];
const ciRings = [0.25, 0.5, 0.75, 1].map(s => svgPts(pts(CI.cx, CI.cy, () => CI.r * s)));
const ciToday = pts(CI.cx, CI.cy, i => CI.r * TODAY[i] / 100);
const ciNext = pts(CI.cx, CI.cy, i => CI.r * NEXT[i] / 100);
const ciIcons = pts(CI.cx, CI.cy, () => CI.r + 26);

// Sherpany: one line per leader, start to week six.
const SC = { x0: 64, x1: 420, top: 26, bottom: 262 };
const y = (s: number) => SC.bottom - (s / 100) * (SC.bottom - SC.top);
// Keep value labels at least 15px apart where two scores sit close together.
const spread = (vals: number[]) => {
  const order = vals.map((v, i) => ({ i, y: y(v) })).sort((a, b) => a.y - b.y);
  for (let k = 1; k < order.length; k++) if (order[k].y - order[k - 1].y < 15) order[k].y = order[k - 1].y + 15;
  const out: number[] = [];
  order.forEach(o => (out[o.i] = o.y));
  return out;
};
const startY = spread(SHERPANY_SCORES.map(s => s[0]));
const endY = spread(SHERPANY_SCORES.map(s => s[1]));
const lines = SHERPANY_SCORES.map(([a, b], i) => ({ a, b, y0: y(a), y1: y(b), ly0: startY[i], ly1: endY[i], len: Math.hypot(SC.x1 - SC.x0, y(b) - y(a)) }));

const sorin = TESTIMONIALS.find(t => t.name === 'Sorin Popa')!;

const WAYS = [
  { href: '/what-we-do/keynotes-workshops', icon: 'mic', tag: '45 min to a full day', title: 'Keynotes & workshops', text: 'A keynote for your conference or all-hands, or a half or full-day workshop for one team. Always shaped around your event, your audience and your culture.', cta: 'Book Ian to speak', dark: true },
  { href: '/what-we-do/masterclass', icon: 'board', tag: '60–90 min', title: 'Masterclass', text: 'A working session for your leadership team. You leave with a clear picture of where your culture sits across the Five Pillars, and what it means for your people.', cta: 'Ask about a Masterclass' },
  { href: '/what-we-do/wellness-accelerator', icon: 'climb', tag: '6 weeks', title: 'Wellness Accelerator', text: 'A facilitated program that takes your team through each pillar, with structured exercises, accountability and measurable progress.', cta: 'See the program' },
  { href: '/what-we-do/leadership-coaching', icon: 'talk', tag: '1:1', title: 'Leadership coaching', text: 'For leaders who want to model what they’re asking of their teams. Private, structured and built around the whole person.', cta: 'About coaching' },
  { href: '/what-we-do/culture-consulting', icon: 'compass', tag: 'Partnership', title: 'Culture consulting', text: 'When the culture itself needs work: we diagnose what’s really going on, build the system to shift it, and stay alongside your people until it holds.', cta: 'How we work' },
] as const;
---
<Base title="The Artistry of Humanity · nørma, keynotes and culture & leadership work" description="nørma, the wellbeing operating system, plus keynotes and leadership work from Ian Williams. The Artistry of Humanity helps organisations build cultures where people are at their best, through the Five Pillars of Fulfilment." path="/">

  <!-- Hero: nørma leads, Ian and the room come with it. -->
  <section class="bg-dark" style="overflow:hidden">
    <div class="glow" style="right:-18%;top:-30%;width:70%;background:radial-gradient(closest-side,rgba(217,234,110,.14),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap split" style="padding-top:clamp(48px,7vw,96px);padding-bottom:clamp(120px,14vw,190px)">
      <div style="max-width:600px">
        <a class="new" href="#norma"><img src="/assets/norma-app-icon.png" alt="" width="30" height="30" /><span>Introducing <em>nørma</em>, our wellbeing operating system</span></a>
        <h1 style="color:var(--on-dark)">Most wellbeing programs treat the symptom. We help organisations <span class="mk mk-d">connect</span>.</h1>
        <p class="lead">nørma brings wellbeing to your whole organisation: a private app for every person, and a live read on your culture for you. Ian’s keynotes and leadership work bring the same Five Pillars of Fulfilment into the room.</p>
        <div class="btns">
          <a class="btn btn-lime" href="#norma">Meet nørma</a>
          <a class="btn btn-ghost" href="/what-we-do/keynotes-workshops#enquire">Book Ian to speak</a>
        </div>
      </div>
      <figure class="hero-fig">
        <div class="arch" style="aspect-ratio:440/540;box-shadow:0 50px 90px -40px rgba(0,0,0,.7)"><img src="/assets/ian-speaking.webp" alt="Ian Williams speaking to a room of business leaders" width="632" height="783" style="width:100%;height:100%;object-fit:cover;object-position:50% 30%" /></div>
        <div class="hero-phone"><div><img src="/assets/app-where-you-stand.webp" alt="The nørma app: where you stand across the Five Pillars" loading="eager" /></div></div>
      </figure>
    </div>
  </section>

  <!-- Who we've worked with -->
  <section class="lift" style="background:var(--cream)">
    <div class="wrap" style="padding-block:clamp(64px,7vw,92px) clamp(96px,10vw,140px)"><Clients /></div>
  </section>

  <!-- nørma first: the newest and biggest thing we do. -->
  <section id="norma" class="bg-dark lift-b">
    <div class="glow" style="left:-16%;bottom:-30%;width:60%;background:radial-gradient(closest-side,rgba(217,234,110,.12),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap sec">
      <div class="nm-head">
        <span class="eyebrow">New from The Artistry of Humanity</span>
        <h2>Meet <span class="it">nørma</span>: wellbeing <span class="mk mk-d">at scale</span>.</h2>
        <p class="lead">Everything we do in the room, for every person and every team, every month.</p>
      </div>
      <div class="nm" data-tabs data-auto="8000">
        <div class="tablist" role="tablist" aria-label="How nørma works">
          <button type="button" class="tab" role="tab" id="nm-t0" aria-controls="nm-p0"><Icon paths={PILLARS[0].paths} size={18} />For your people</button>
          <button type="button" class="tab" role="tab" id="nm-t1" aria-controls="nm-p1"><Icon name="chart" size={18} />For you</button>
          <button type="button" class="tab" role="tab" id="nm-t2" aria-controls="nm-p2"><Icon name="loop" size={18} />With us alongside</button>
        </div>
        <div class="nm-panel" role="tabpanel" id="nm-p0" aria-labelledby="nm-t0">
          <div class="nm-copy">
            <h3>A private app for their whole life.</h3>
            <p class="body">Once a month, a short check-in shows each person where they are across all five pillars, and nørma helps them work on the gaps.</p>
            <p class="nm-line"><Icon name="lock" size={18} />It’s theirs. Nobody at work can read it.</p>
          </div>
          <div class="nm-vis nm-phone"><div><img src="/assets/app-where-you-stand.webp" alt="The nørma app: where you stand across the Five Pillars" loading="lazy" /></div></div>
        </div>
        <div class="nm-panel" role="tabpanel" id="nm-p1" aria-labelledby="nm-t1">
          <div class="nm-copy">
            <h3>A live read on your culture.</h3>
            <p class="body">Those check-ins become an anonymous signal: your culture by organisation, department and team, and what needs attention first.</p>
            <p class="nm-line"><Icon name="users" size={18} />Leaders see groups of five or more, never individuals.</p>
          </div>
          <div class="nm-vis nm-dash"><img src="/assets/dash-hero.webp" alt="The nørma leader dashboard: nørma Score, Fulfilment, Culture and every department" width="1120" height="816" loading="lazy" /></div>
        </div>
        <div class="nm-panel" role="tabpanel" id="nm-p2" aria-labelledby="nm-t2">
          <div class="nm-copy">
            <h3>The room, kept going.</h3>
            <p class="body">nørma runs on the same framework Ian brings to a keynote or a program. So the work doesn’t end when the day does.</p>
            <p class="nm-line"><Icon name="calendar" size={18} />Next month shows whether it moved.</p>
          </div>
          <div class="nm-vis nm-room">
            <img src="/assets/workshop.jpg" alt="Ian Williams facilitating a workshop in a full room" width="1024" height="683" loading="lazy" />
            <div class="nm-loop" aria-hidden="true"><span>Keynote</span><i></i><span>Check-in</span><i></i><span>Team session</span><i></i><span>Next month</span></div>
          </div>
        </div>
      </div>
      <div class="nm-cta"><a class="btn btn-lime" href="https://joinnorma.com/">Explore nørma ↗</a><a class="link" href="https://joinnorma.com/book-a-demo/" style="margin-top:0">Book a demo ↗</a></div>
    </div>
  </section>

  <!-- Keynotes: Ian in the room. -->
  <section class="lift" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div>
          <span class="eyebrow">Keynotes &amp; workshops</span>
          <blockquote class="kq">“He doesn’t speak at an audience. <span class="mk">He brings them in.</span>”</blockquote>
        </div>
        <p class="lead" style="margin-top:0">Ian draws on all of it: leadership, pressure, success and personal struggle. His sessions are interactive, deeply human, and leave people thinking, feeling and acting differently. In person or virtual, across Australia and internationally.</p>
      </div>
      <div class="kn-head">
        <h3>Three keynotes Ian delivers often</h3>
        <p class="body" style="margin-top:6px">A selection, to give you a feel. Every session is tailored to your audience and context, and more themes are available.</p>
      </div>
      <div class="grid kn-grid">
        {KEYNOTES.map(k => (
          <a class="card" href="/what-we-do/keynotes-workshops#keynotes" data-rv style="padding:0;overflow:hidden;display:flex;flex-direction:column">
            <img src={k.img} alt="" width="432" height="196" loading="lazy" style="width:100%;aspect-ratio:432/220;object-fit:cover" />
            <div style="padding:clamp(22px,2.4vw,28px)">
              <span class="pill">{k.tag}</span>
              <h3 style="margin-top:14px;font-size:clamp(22px,2vw,26px)">{k.title}</h3>
              <p class="body" style="font-size:15.5px">{k.hook}</p>
            </div>
          </a>
        ))}
        <a class="card kn-own" href="/what-we-do/keynotes-workshops#enquire" data-rv>
          <span class="ico"><Icon name="plus" /></span>
          <h3 style="margin-top:18px;font-size:clamp(22px,2vw,26px)">Your theme</h3>
          <p class="body" style="font-size:15.5px">Have something else in mind for your event? Tell us what your people need to hear right now, and Ian will shape a keynote around it.</p>
          <span class="link">Talk to us about your event ›</span>
        </a>
      </div>
      <div class="split" style="margin-top:clamp(64px,7vw,96px)">
        <div class="video" data-rv>
          <img src="/assets/keynote.jpg" alt="" width="1024" height="683" loading="lazy" />
          <button type="button" data-yt={VIDEO} aria-label="Watch Ian live"><span><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5 18 12 8 18.5Z" /></svg></span>Watch Ian live</button>
        </div>
        <div>
          <h3>Most keynotes are forgotten by Monday.</h3>
          <p class="body">Ian goes first with his own story, hard parts included, and that gives people permission to be honest too. Audiences score themselves live against the Five Pillars, and leave with a framework and one clear action to take into their life.</p>
          <div class="btns"><a class="btn btn-dark" href="/what-we-do/keynotes-workshops">See the keynotes</a><a class="btn btn-ghost" href="/what-we-do/keynotes-workshops#enquire">Check a date</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- The framework, and the free check-in that has been shared everywhere. -->
  <section class="bg-sand lift-b">
    <div class="wrap sec">
      <div class="narrow center">
        <span class="eyebrow">The Five Pillars of Fulfilment</span>
        <h2>Fulfilment isn’t one thing. It’s <span class="mk">five</span>.</h2>
        <p class="lead" style="margin-left:auto;margin-right:auto">Our framework looks at the whole person, not just the job. Strengthen one pillar and the rest follow. Neglect one and the others feel it.</p>
      </div>
      <div class="split pillars" style="margin-top:clamp(40px,5vw,64px)">
        <figure class="pg" data-rv style="flex:1 1 360px;max-width:500px;margin:0 auto">
          <svg viewBox="0 0 440 440" role="img" aria-label={'The Five Pillars of Fulfilment, all connected: ' + PILLARS.map(p => p.name).join(', ')}>
            <polygon class="pg-edge" points={svgPts(pgCorners)} fill="rgba(250,248,240,.55)" stroke="rgba(20,35,26,.2)" stroke-width="1.5" stroke-linejoin="round" pathLength="100" />
            {pgLinks.map(([a, b]) => <line class="pg-link" x1={pgCorners[a][0]} y1={pgCorners[a][1]} x2={pgCorners[b][0]} y2={pgCorners[b][1]} stroke="rgba(74,107,58,.28)" stroke-width="1.2" stroke-dasharray="3 6" />)}
            <text x={PG.cx} y={PG.cy - 4} text-anchor="middle" font-family="'DM Serif Display', Georgia, serif" font-size="30" fill="#14231A">Fulfilment</text>
            <text x={PG.cx} y={PG.cy + 20} text-anchor="middle" font-family="'DM Sans', system-ui, sans-serif" font-size="10.5" font-weight="600" letter-spacing="2.2" fill="#4A6B3A">FIVE PILLARS, ONE LIFE</text>
            {PILLARS.map((p, i) => (
              <g class="pg-c" data-k={p.key} style={`--d:${i * 0.09}s`}>
                <circle cx={pgCorners[i][0]} cy={pgCorners[i][1]} r="36" fill={p.tint} stroke="#FAF8F0" stroke-width="5" />
                <g transform={`translate(${(pgCorners[i][0] - 16).toFixed(1)} ${(pgCorners[i][1] - 16).toFixed(1)}) scale(1.3333)`} fill="none" stroke="#14231A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">{p.paths.map(d => <path d={d} />)}</g>
              </g>
            ))}
          </svg>
        </figure>
        <ol class="pl-list">
          {PILLARS.map((p, i) => (
            <li data-k={p.key}>
              <span class="pl-dot" style={`background:${p.tint}`}><Icon paths={p.paths} size={22} stroke="#14231A" width={1.5} /></span>
              <div><h3>{p.name}</h3><p class="body">{p.short}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <div class="card-dark ci" style="margin-top:clamp(48px,5vw,72px)">
        <div class="ci-copy">
          <span class="eyebrow">Free · full report included</span>
          <h3 style="margin-top:10px;font-size:clamp(28px,3vw,38px)">Where are you right now?</h3>
          <p class="body">Take the Fulfilment check-in and see your own picture across the Five Pillars. Every score is a starting point: you’ll see where you’re strong, and the pillar with the most room to grow.</p>
          <div class="btns"><a class="btn btn-lime" href="/fulfilment-check-in" target="_blank">Take the check-in</a><a class="btn btn-ghost" href="/framework">The framework</a></div>
        </div>
        <figure class="ci-pg" data-rv>
          <svg viewBox="0 0 320 320" role="img" aria-label="An example check-in: a shape for today across the Five Pillars, and a larger dashed shape showing where it could grow">
            {ciRings.map(r => <polygon points={r} fill="none" stroke="rgba(228,240,214,.12)" stroke-width="1" />)}
            {pts(CI.cx, CI.cy, () => CI.r).map(([x, yy]) => <line x1={CI.cx} y1={CI.cy} x2={x} y2={yy} stroke="rgba(228,240,214,.1)" stroke-width="1" />)}
            <polygon class="ci-next" points={svgPts(ciNext)} fill="rgba(234,247,155,.06)" stroke="#EAF79B" stroke-opacity=".8" stroke-width="1.5" stroke-dasharray="4 5" stroke-linejoin="round" />
            <polygon class="ci-today" points={svgPts(ciToday)} fill="rgba(217,234,110,.26)" stroke="#D9EA6E" stroke-width="2" stroke-linejoin="round" />
            {ciToday.map(([x, yy]) => <circle class="ci-today" cx={x} cy={yy} r="3.5" fill="#D9EA6E" />)}
            <g class="ci-grow">
              <line x1={ciToday[1][0] + 6} y1={ciToday[1][1]} x2={ciNext[1][0] - 7} y2={ciNext[1][1]} stroke="#EAF79B" stroke-width="1.6" stroke-linecap="round" />
              <path d={`M${(ciNext[1][0] - 12).toFixed(1)} ${(ciNext[1][1] - 4.5).toFixed(1)} L${(ciNext[1][0] - 6).toFixed(1)} ${ciNext[1][1].toFixed(1)} L${(ciNext[1][0] - 12).toFixed(1)} ${(ciNext[1][1] + 4.5).toFixed(1)}`} fill="none" stroke="#EAF79B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              <text x={ciNext[1][0] - 20} y={ciNext[1][1] - 14} text-anchor="middle" font-family="'DM Sans', system-ui, sans-serif" font-size="9.5" font-weight="600" letter-spacing="1.4" fill="#EAF79B">ROOM TO GROW</text>
            </g>
            {PILLARS.map((p, i) => (
              <g>
                <circle cx={ciIcons[i][0]} cy={ciIcons[i][1]} r="17" fill={p.tint} fill-opacity=".16" stroke={p.tint} stroke-opacity=".5" stroke-width="1" />
                <g transform={`translate(${(ciIcons[i][0] - 10).toFixed(1)} ${(ciIcons[i][1] - 10).toFixed(1)}) scale(.8333)`} fill="none" stroke={p.tint} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">{p.paths.map(d => <path d={d} />)}</g>
              </g>
            ))}
          </svg>
          <figcaption class="ci-key"><span><i style="background:#D9EA6E"></i>Where you are today</span><span><i class="dash"></i>Where it could go</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Ways to work together -->
  <section class="lift" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">Ways to work together</span><h2>One framework. <span class="mk">Five ways in.</span></h2></div>
        <p class="lead" style="margin-top:0">Every format is built on the Five Pillars, in person or virtual, across Australia and internationally. Many organisations start with a keynote or a Masterclass, and keep the work going with nørma.</p>
      </div>
      <div class="ways" style="margin-top:clamp(44px,5vw,64px)">
        {WAYS.map(w => (
          <a class={'dark' in w ? 'card-dark' : 'card'} href={w.href} data-rv>
            <div class="way-top"><span class="ico"><Icon name={w.icon} /></span><span class="pill">{w.tag}</span></div>
            <h3 style="margin-top:20px">{w.title}</h3>
            <p class="body">{w.text}</p>
            <span class="link">{w.cta} ›</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Proof: Sherpany by Datasite -->
  <section class="bg-dark lift-b">
    <div class="wrap sec">
      <div class="split">
        <div>
          <img src="/assets/sherpany-logo.png" alt="Sherpany by Datasite" width="230" height="112" style="width:170px;filter:brightness(0) invert(1);opacity:.9" />
          <h2 style="margin-top:22px">Six weeks. One leadership team. A culture that finally had <span class="mk mk-d">a name</span> for what it was missing.</h2>
          <p class="lead">We ran the Wellness Accelerator with Sherpany’s core leadership team. The weakest pillar, Internal Work, surfaced the most honest conversations the team had ever had. By week six they had a shared framework, new accountability rituals and measurable shifts across all Five Pillars.</p>
          <div class="stats" style="grid-template-columns:repeat(2,minmax(0,1fr));max-width:400px">
            <div><div class="stat">+29%</div><p class="small" style="color:var(--on-dark-muted);margin-top:8px">team fulfilment score, start of the program vs after six weeks</p></div>
            <div><div class="stat">6</div><p class="small" style="color:var(--on-dark-muted);margin-top:8px">weeks, start to finish</p></div>
          </div>
        </div>
        <figure class="tile sc" data-rv style="margin:0">
          <span class="eyebrow">Fulfilment Score, start of the program vs after six weeks</span>
          <svg viewBox="0 0 500 300" role="img" aria-label={'Fulfilment Scores for five Sherpany leaders, start of the program and after six weeks: ' + SHERPANY_SCORES.map(([a, b]) => `${a} to ${b}`).join(', ')}>
            {[25, 50, 75, 100].map(s => <line x1={SC.x0} x2={SC.x1} y1={y(s)} y2={y(s)} stroke="rgba(228,240,214,.08)" stroke-width="1" />)}
            <line x1={SC.x0} x2={SC.x0} y1={SC.top - 6} y2={SC.bottom} stroke="rgba(228,240,214,.22)" stroke-width="1" />
            <line x1={SC.x1} x2={SC.x1} y1={SC.top - 6} y2={SC.bottom} stroke="rgba(228,240,214,.22)" stroke-width="1" />
            {lines.map((l, i) => (
              <g class="sc-l" style={`--len:${l.len.toFixed(0)};--d:${(i * 0.12).toFixed(2)}s`}>
                <line x1={SC.x0} y1={l.y0} x2={SC.x1} y2={l.y1} stroke="#D9EA6E" stroke-opacity=".85" stroke-width="2.4" stroke-linecap="round" stroke-dasharray={l.len.toFixed(0)} />
                <circle cx={SC.x0} cy={l.y0} r="4.5" fill="#0F2015" stroke="#D9EA6E" stroke-width="2" />
                <circle class="sc-end" cx={SC.x1} cy={l.y1} r="5" fill="#D9EA6E" />
                <text x={SC.x0 - 14} y={l.ly0 + 4.5} text-anchor="end" font-family="'DM Sans', system-ui, sans-serif" font-size="13" font-weight="500" fill="rgba(246,244,233,.6)">{l.a}</text>
                <text class="sc-end" x={SC.x1 + 14} y={l.ly1 + 5} text-anchor="start" font-family="'DM Serif Display', Georgia, serif" font-size="17" fill="#EAF79B">{l.b}</text>
              </g>
            ))}
            <text x={SC.x0 - 6} y="292" text-anchor="start" font-family="'DM Sans', system-ui, sans-serif" font-size="11" font-weight="600" letter-spacing="1.6" fill="rgba(246,244,233,.55)">START OF PROGRAM</text>
            <text x={SC.x1 + 6} y="292" text-anchor="end" font-family="'DM Sans', system-ui, sans-serif" font-size="11" font-weight="600" letter-spacing="1.6" fill="#DCEC85">AFTER SIX WEEKS</text>
          </svg>
