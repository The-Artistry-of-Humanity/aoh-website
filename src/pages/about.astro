---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { PILLARS, SERVICES } from '../data/aoh';

const BELIEFS = [
  { icon: 'layers', t: 'Culture is the operating system, not a benefit', d: 'How people feel inside an organisation shapes every decision they make, every conversation they have and every result they produce. Getting culture right isn’t a nice-to-have. It’s the foundation everything else is built on.' },
  { icon: 'heart', t: 'Work is one part of a whole human life', d: 'Performance, focus and resilience are shaped by everything that happens outside the office too. A tool or program that ignores the rest of a person’s life is working with half the picture.' },
  { icon: 'eye', t: 'If you can see it, you can manage it', d: 'Most organisations are navigating in the dark because they don’t have a clear, honest view of how their people are actually doing. Visibility creates accountability. Accountability creates change.' },
  { icon: 'sun', t: 'You can always find the positive', d: 'This isn’t toxic positivity or ignoring what’s hard. It’s the belief that there is always a next step, always a controllable, always a direction to move in. That orientation changes everything.' },
] as const;

const PODCAST = [
  ['Spotify', 'https://open.spotify.com/show/6C9jBcH8FHdlAdaQL9lfEQ'],
  ['Apple Podcasts', 'https://podcasts.apple.com/ca/podcast/the-artistry-of-humanity/id1775703355'],
  ['YouTube', 'https://www.youtube.com/@alignwithwillo'],
];

const QUOTE_MARK = 'M0 48V28C0 12 8 3 24 0l3 6C17 9 13 15 12.5 22H26v26zm36 0V28c0-16 8-25 24-28l3 6c-10 3-14 9-14.5 16H62v26z';
---
<Base title="About Ian Williams · The Artistry of Humanity" description="The Artistry of Humanity was founded by Ian Williams, who has spent more than thirty years leading teams and building high-performing cultures across three continents. The story behind the Five Pillars of Fulfilment." path="/about">

  <!-- Hero -->
  <section style="background:var(--cream);overflow:hidden">
    <div class="glow" style="right:-12%;top:-20%;width:56%;background:radial-gradient(closest-side,rgba(217,234,110,.26),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap split" style="padding-top:clamp(40px,6vw,88px);padding-bottom:clamp(120px,13vw,180px)">
      <div style="max-width:600px">
        <span class="eyebrow">Our story</span>
        <h1>Built from the <span class="mk">inside out</span>.</h1>
        <p class="lead">The Artistry of Humanity didn’t start with a business plan. It started with a pattern Ian Williams kept seeing for more than thirty years, inside some of the world’s largest organisations.</p>
        <ul class="facts">
          <li><Icon name="pin" size={20} /><span>Grew up in <b>Liverpool</b></span></li>
          <li><Icon name="users" size={20} /><span>Leading people since <b>17</b></span></li>
          <li><Icon name="clock" size={20} /><span><b>30+ years</b> leading teams</span></li>
          <li><Icon name="globe" size={20} /><span><b>Three continents</b></span></li>
        </ul>
        <div class="btns">
          <a class="btn btn-lime" href="/what-we-do/keynotes-workshops#enquire">Book Ian to speak</a>
          <a class="btn btn-ghost" href="/contact">Book a call</a>
        </div>
      </div>
      <figure style="margin:0;flex:0 1 400px">
        <div class="arch" style="aspect-ratio:420/520;background:radial-gradient(64% 42% at 50% 22%,rgba(217,234,110,.6),rgba(217,234,110,.16) 55%,rgba(217,234,110,0) 82%),linear-gradient(180deg,#E8EACB,#ECE8D7 52%,#E4DFCA);position:relative">
          <img src="/assets/ian-portrait.webp" alt="Ian Williams" width="900" height="802" style="position:absolute;left:50%;bottom:0;width:128%;max-width:none;transform:translateX(-50%)" />
        </div>
        <figcaption class="who" style="text-align:center;margin-top:18px">Ian Williams · Founder &amp; CEO</figcaption>
      </figure>
    </div>
  </section>

  <!-- Ian's path, as a timeline -->
  <section class="bg-sand lift">
    <div class="wrap sec">
      <div class="narrow center">
        <span class="eyebrow">Ian’s story</span>
        <h2>How a pattern became <span class="mk">a framework</span>.</h2>
      </div>

      <ol class="tl">
        <li class="tl-i" data-rv>
          <div class="tl-k"><b>Liverpool</b><span>Where it starts</span></div>
          <span class="tl-n"><Icon name="pin" size={24} /></span>
          <div class="tl-c">
            <h3>Growing up in Liverpool</h3>
            <p class="body">Ian didn’t have a theory about management or a framework for culture. Those came later, built from years of watching people.</p>
          </div>
        </li>

        <li class="tl-i" data-rv>
          <div class="tl-k"><b class="num">17</b><span>A first leadership role</span></div>
          <span class="tl-n"><Icon name="users" size={24} /></span>
          <div class="tl-c">
            <h3>The observation that never left him</h3>
            <p class="body">Ian was seventeen when he stepped into his first leadership role, and he noticed something straight away: when people felt <b>seen, trusted and supported</b>, they worked differently. They cared more. They gave more. And the results followed.</p>
          </div>
        </li>

        <li class="tl-i" data-rv>
          <div class="tl-k"><b class="num">30+</b><span>Years leading teams</span></div>
          <span class="tl-n"><Icon name="globe" size={24} /></span>
          <div class="tl-c">
            <h3>Three continents, at DHL and some of the world’s largest organisations</h3>
            <p class="body">Managing hundreds of people and running complex operations across multiple countries. Turning around underperforming businesses and building high-performing cultures from the ground up.</p>
            <ul class="tl-tags"><li>Turnarounds</li><li>High-performing cultures</li><li>Boardrooms, warehouses, leadership teams</li></ul>
          </div>
        </li>

        <li class="tl-q q-dark" data-rv>
          <figure>
            <svg class="q-mark" width="52" height="39" viewBox="0 0 64 48" aria-hidden="true"><path d={QUOTE_MARK} /></svg>
            <blockquote>The biggest asset of every company I ever worked in was the people. Not the strategy. Not the systems. <span class="mk mk-d">The people.</span></blockquote>
            <figcaption class="q-by"><img src="/assets/ian-portrait.webp" alt="" width="900" height="802" loading="lazy" /><span><b>Ian Williams</b><span>Founder &amp; CEO</span></span></figcaption>
          </figure>
        </li>

        <li class="tl-i" data-rv>
          <div class="tl-k"><b class="word">The pattern</b><span>Different every time, the same every time</span></div>
          <span class="tl-n"><Icon name="search" size={24} /></span>
          <div class="tl-c">
            <h3>What made the difference was never the plan</h3>
            <div class="two">
              <div class="two-up">
                <span class="two-k"><Icon name="climb" size={18} />The ones that outperformed</span>
                <p>Someone had built a culture where people felt they belonged, understood why their work mattered, and trusted that the person leading them actually gave a damn.</p>
              </div>
              <div class="two-down">
                <span class="two-k"><Icon name="loop" size={18} />The ones that struggled</span>
                <p>Rarely about talent or intention. It was disconnection: between the work and the lives people were living, and between what leaders said they valued and how the place felt.</p>
              </div>
            </div>
            <div class="accs" style="margin-top:20px">
              <details class="acc">
                <summary>The warning signs he kept seeing</summary>
                <div class="acc-body">
                  <ul class="list">
                    <li>The high performer running on empty.</li>
                    <li>The manager who couldn’t delegate because they’d never been taught to trust.</li>
                    <li>The employee who looked fine from the outside but was quietly falling apart.</li>
                  </ul>
                  <p>The warning signs were always there. Nobody had the language, or the structure, to act on them.</p>
                </div>
              </details>
            </div>
          </div>
        </li>

        <li class="tl-q q-lime" data-rv>
          <figure>
            <svg class="q-mark" width="52" height="39" viewBox="0 0 64 48" aria-hidden="true"><path d={QUOTE_MARK} /></svg>
            <blockquote><span class="mk mk-w">If you can see it, you can manage it.</span> The problem is that most organisations can’t see what’s actually going on.</blockquote>
            <figcaption class="q-by"><img src="/assets/ian-portrait.webp" alt="" width="900" height="802" loading="lazy" /><span><b>Ian Williams</b><span>Founder &amp; CEO</span></span></figcaption>
          </figure>
        </li>

        <li class="tl-i" data-rv>
          <div class="tl-k"><b class="num">1<small>of</small>5</b><span>Work is one pillar</span></div>
          <span class="tl-n"><Icon name="norma" size={24} /></span>
          <div class="tl-c">
            <h3>The insight: the Five Pillars of Fulfilment</h3>
            <p class="body">The tools organisations used to support their people were built on an incomplete picture of a human being. Work is one part of life. When relationships are strained, health is declining, purpose is missing or connections are thin, it shows up at work whether anyone acknowledges it or not.</p>
            <ul class="tl-pillars" aria-label="The Five Pillars of Fulfilment">
              {PILLARS.map(p => <li><span style={`background:${p.tint}`}><Icon paths={p.paths} size={20} stroke="#14231A" width={1.5} /></span>{p.name}</li>)}
            </ul>
            <a class="link" href="/framework">Explore the framework ›</a>
          </div>
        </li>

        <li class="tl-q q-paper" data-rv>
          <figure>
            <svg class="q-mark" width="52" height="39" viewBox="0 0 64 48" aria-hidden="true"><path d={QUOTE_MARK} /></svg>
            <blockquote>You can only control the controllables. But first, you have to be <span class="mk">honest about what’s actually happening</span>.</blockquote>
            <figcaption class="q-by"><img src="/assets/ian-portrait.webp" alt="" width="900" height="802" loading="lazy" /><span><b>Ian Williams</b><span>Founder &amp; CEO</span></span></figcaption>
          </figure>
        </li>

        <li class="tl-i" data-rv>
          <div class="tl-k"><b class="word">Founder</b><span>The Artistry of Humanity</span></div>
          <span class="tl-n tl-img"><img src="/assets/aoh-logo-new.png" alt="" width="56" height="56" /></span>
          <div class="tl-c">
            <h3>A better tool for organisations</h3>
            <p class="body">Ian founded The Artistry of Humanity to give organisations, and the people inside them, something that starts with the whole human, creates accountability on both sides, and treats culture as the operating system everything else runs on. Today he leads it as founder and CEO, and works with leadership teams as a consultant, facilitator and keynote speaker.</p>
            <figure class="photo tl-photo"><img src="/assets/ian-presenting.jpg" alt="Ian Williams at the front of a workshop room, beside notes from the session pinned to a brick wall" width="1024" height="683" loading="lazy" /></figure>
          </div>
        </li>

        <li class="tl-i tl-last" data-rv>
          <div class="tl-k"><b class="word">nørma</b><span>Wellbeing at scale</span></div>
          <span class="tl-n tl-img"><img src="/assets/norma-app-icon.png" alt="" width="56" height="56" /></span>
          <div class="tl-c">
            <h3>Every person, every team</h3>
            <p class="body">Keynotes, programs and coaching reach one room, one team or one leader at a time. nørma, the newest thing from The Artistry of Humanity, reaches everyone: the Five Pillars in a private app for each person, and a live, anonymous read on culture for leaders across every team.</p>
            <a class="link" href="/what-we-do/norma">Meet nørma ›</a>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Beliefs -->
  <section class="lift-b" style="background:var(--cream)">
    <div class="wrap sec split" style="align-items:start">
      <div class="bel-side">
        <span class="eyebrow">What we believe</span>
        <h2>What drives <span class="mk">everything we do</span>.</h2>
        <p class="lead">Four beliefs sit underneath every keynote, program and conversation we have with a leadership team.</p>
        <figure class="photo bel-photo" data-rv><img src="/assets/ian-speaking.webp" alt="Ian Williams speaking to a room of business leaders" width="632" height="783" loading="lazy" /></figure>
      </div>
      <div class="accs bel" data-rv>
        {BELIEFS.map((b, i) => (
          <details class="acc" open={i === 0}>
            <summary><span class="ico"><Icon name={b.icon} size={22} /></span><span><span class="bel-n">0{i + 1}</span>{b.t}</span></summary>
            <div class="acc-body"><p>{b.d}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Where the pillars came from -->
  <section class="bg-dark lift">
    <div class="glow" style="right:-16%;top:-26%;width:56%;background:radial-gradient(closest-side,rgba(217,234,110,.12),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">The framework</span><h2>Where the Five Pillars <span class="mk mk-d">came from</span>.</h2></div>
        <p class="lead" style="margin-top:0">Not designed in a workshop or borrowed from academic research. Built from more than thirty years of watching what actually makes people thrive, and what quietly destroys them.</p>
      </div>
      <ol class="cols">
        {PILLARS.map((p, i) => (
          <li data-rv style={`--t:${p.tint};--d:${i * 0.08}s`}>
            <span class="col-dot"><Icon paths={p.paths} size={26} stroke="#14231A" width={1.5} /></span>
            <span class="col-n">0{i + 1}</span>
            <h3>{p.name}</h3>
            <p class="body">{p.short}</p>
          </li>
        ))}
      </ol>
      <div class="btns cols-btns"><a class="btn btn-lime" href="/framework">Explore the framework</a><a class="btn btn-ghost" href="/fulfilment-check-in">Take the free check-in</a></div>
    </div>
  </section>

  <!-- Beyond the boardroom -->
  <section class="bg-sand lift-b">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">Ian’s other work</span><h2>The work <span class="mk">beyond the boardroom</span>.</h2></div>
        <p class="lead" style="margin-top:0">Two places where Ian goes further than the leadership room: an honest podcast, and a focused initiative for men.</p>
      </div>
      <div class="bb" data-tabs>
        <div class="tablist" role="tablist" aria-label="Ian’s other work">
          <button type="button" class="tab" role="tab" id="bb-t0" aria-controls="bb-p0"><Icon name="headphones" size={18} />The podcast</button>
          <button type="button" class="tab" role="tab" id="bb-t1" aria-controls="bb-p1"><Icon name="users" size={18} />Good Men Helping Good Men</button>
        </div>
        <div class="card bb-p" role="tabpanel" id="bb-p0" aria-labelledby="bb-t0">
          <figure class="photo bb-cover"><img src="/assets/podcast-cover.webp" alt="Cover art for The Artistry of Humanity podcast: Be the author of your story, with Ian Williams" width="900" height="900" loading="lazy" /></figure>
          <div>
            <span class="eyebrow">The podcast</span>
            <h3 style="margin-top:12px">The Artistry of Humanity podcast</h3>
            <p class="body">The best way to understand what Ian thinks, and how he thinks, is to hear him talk. Leadership, culture, human connection and what it actually means to live a fulfilled life. No scripts, no corporate polish.</p>
            <div class="btns" style="margin-top:24px">{PODCAST.map(([l, u], i) => <a class={i === 0 ? 'btn btn-dark' : 'btn btn-ghost'} href={u} rel="noopener">{l} ↗</a>)}</div>
          </div>
        </div>
        <div class="card-dark bb-p" role="tabpanel" id="bb-p1" aria-labelledby="bb-t1">
          <div class="bb-gm"><span class="ico"><Icon name="users" size={30} /></span></div>
          <div>
            <span class="eyebrow">Good Men Helping Good Men</span>
            <h3 style="margin-top:12px">Male disconnection and loneliness are at crisis levels.</h3>
            <p class="body">It’s something Ian has felt personally and seen professionally for years. Good Men Helping Good Men (GMHGM) is the focused initiative within The Artistry of Humanity that addresses it directly.</p>
            <ul class="bb-list"><li>Workshops</li><li>Peer circles</li><li>Coaching</li><li>A community app</li></ul>
            <div class="btns" style="margin-top:24px"><a class="btn btn-lime" href="https://gmhgm.com/" rel="noopener">Visit GMHGM ↗</a></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Work with us -->
  <section class="lift" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">Work with us</span><h2>Grounded in the pillars. <span class="mk">Shaped around you.</span></h2></div>
        <p class="lead" style="margin-top:0">Every engagement is built on the Five Pillars of Fulfilment. The format depends on where you are and what you need, and nørma takes it to every person and every team: wellbeing at scale.</p>
      </div>
      <div class="ways">
        <a class="way way-norma" href="/what-we-do/norma" data-rv>
          <img src="/assets/norma-app-icon.png" alt="" width="52" height="52" />
          <span><b>nørma</b><small>Wellbeing at scale. Every person, every team, every month.</small></span>
          <Icon name="arrow" size={20} />
        </a>
        {SERVICES.map(s => (
          <a class="way" href={s.href} data-rv>
            <span class="ico"><Icon name={s.icon} size={24} /></span>
            <span><b>{s.title}</b><small>{s.line}</small></span>
            <Icon name="arrow" size={20} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Close -->
  <section class="bg-sand lift-b">
    <div class="wrap sec">
      <div class="card-dark center" style="max-width:860px;margin:0 auto;padding:clamp(48px,6vw,80px) clamp(24px,5vw,64px)">
        <span class="eyebrow">Let’s start a conversation</span>
        <h2 style="margin-left:auto;margin-right:auto;max-width:14em">Ready to bring this into your organisation?</h2>
        <p class="lead" style="margin-left:auto;margin-right:auto">Start with a conversation, or ask about a Masterclass for your leadership team.</p>
        <div class="btns"><a class="btn btn-lime" href="/contact">Book a call</a><a class="btn btn-ghost" href="/what-we-do/masterclass">Ask about a Masterclass</a></div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero facts */
  .facts{list-style:none;margin:28px 0 0;padding:0;display:grid;grid-template-columns:repeat(2,max-content);gap:10px}
  .facts li span{white-space:nowrap}
  .facts li{display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:16px 12px 16px 10px / 12px 16px 10px 16px;background:rgba(250,248,240,.75);box-shadow:inset 0 0 0 1px rgba(20,35,26,.08);font-size:14.5px;line-height:1.3;color:var(--muted)}
  .facts li :global(svg){flex:none;color:var(--olive)}
  .facts b{font-weight:600;color:var(--ink)}
  @media (max-width:560px){.facts{grid-template-columns:minmax(0,1fr);gap:8px}.facts li{padding:10px 14px}}

  /* The timeline: key | node | content, joined by a dotted line. */
  .tl{--key:clamp(180px,20vw,250px);--node:64px;position:relative;list-style:none;margin:clamp(48px,6vw,80px) auto 0;padding:0;max-width:1060px}
  .tl::before{content:'';position:absolute;top:10px;bottom:40px;left:calc(var(--key) + var(--node) / 2 - 1px);width:2px;background:repeating-linear-gradient(180deg,rgba(74,107,58,.45) 0 5px,transparent 5px 11px)}
  .tl-i{position:relative;display:grid;grid-template-columns:var(--key) var(--node) minmax(0,1fr);gap:0 clamp(20px,3vw,40px);padding-bottom:clamp(48px,6vw,72px)}
  .tl-k{text-align:right;padding-top:4px}
  .tl-k b{display:block;font:400 clamp(40px,4.6vw,62px)/1 var(--serif);letter-spacing:-1px;color:var(--olive)}
  .tl-k b.word{font-size:clamp(28px,2.8vw,38px);letter-spacing:-.4px;color:var(--ink)}
  .tl-k b small{margin:0 .14em;font:600 .3em var(--sans);letter-spacing:1px;text-transform:uppercase;vertical-align:.9em;color:var(--muted-2)}
  .tl-k span{display:block;margin-top:10px;font:600 11px/1.4 var(--sans);letter-spacing:1.8px;text-transform:uppercase;color:var(--muted-2)}
  .tl-n{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;width:var(--node);height:var(--node);border-radius:50%;background:var(--dark);color:var(--lime);box-shadow:0 0 0 8px var(--sand)}
  .tl-img{background:none;overflow:hidden}
  .tl-img img{width:100%;height:100%;object-fit:cover;border-radius:50%}
  .tl-c{max-width:600px;padding-top:6px}
  .tl-c h3{font-size:clamp(24px,2.3vw,30px)}
  .tl-c .body{margin-top:12px;font-size:17px}
  .tl-c .body b{font-weight:600;color:var(--ink)}
  .tl-tags{list-style:none;display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 0;padding:0}
  .tl-tags li{padding:7px 13px;border-radius:999px;background:rgba(20,35,26,.06);font:600 13px/1.3 var(--sans);color:var(--olive)}
  .tl-pillars{list-style:none;display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 0;padding:0}
  .tl-pillars li{display:inline-flex;align-items:center;gap:8px;padding:4px 14px 4px 4px;border-radius:999px;background:rgba(250,248,240,.8);font:600 13.5px/1.3 var(--sans);color:var(--ink)}
  .tl-pillars span{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%}
  .tl-photo{margin:24px 0 0;aspect-ratio:16/10}
  .tl-last{padding-bottom:0}
  .two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:18px}
  .two > div{padding:18px 20px;border-radius:20px 16px 20px 14px / 16px 20px 14px 20px}
  .two p{margin:10px 0 0;font-size:15.5px;line-height:1.55;color:var(--muted)}
  .two-up{background:rgba(217,234,110,.34)}
  .two-down{background:rgba(250,248,240,.7);box-shadow:inset 0 0 0 1px rgba(20,35,26,.08)}
  .two-k{display:flex;align-items:center;gap:8px;font:600 11px/1.3 var(--sans);letter-spacing:1.6px;text-transform:uppercase;color:var(--ink)}
  .two-k :global(svg){flex:none;color:var(--olive)}
  .tl .accs{max-width:600px}

  /* Ian's three lines: sans, large, each on its own card across the line. */
  .tl-q{position:relative;z-index:1;padding-bottom:clamp(48px,6vw,72px)}
  .tl-q figure{margin:0;padding:clamp(30px,4vw,56px) clamp(24px,4.4vw,64px);border-radius:var(--r-a)}
  .tl-q blockquote{margin:20px 0 0;font:500 clamp(26px,3.1vw,42px)/1.22 var(--sans);letter-spacing:-.8px;text-wrap:pretty}
  .q-mark{display:block}
  .q-dark figure{background:var(--dark);color:var(--on-dark);box-shadow:0 36px 70px -34px rgba(20,35,26,.6)}
  .q-dark .q-mark{fill:var(--lime)}
  .q-lime figure{background:radial-gradient(70% 90% at 85% 0%,#EFF8A8,rgba(239,248,168,0) 70%),linear-gradient(160deg,#E2EF84,#D3E45F);color:var(--dark)}
  .q-lime .q-mark{fill:var(--dark)}
  .mk-w{--mk:rgba(250,248,240,.8)}
  .q-paper figure{background:var(--paper);color:var(--ink);box-shadow:inset 0 0 0 1px rgba(20,35,26,.07),0 30px 60px -36px rgba(20,35,26,.35)}
  .q-paper .q-mark{fill:var(--lime-3)}
