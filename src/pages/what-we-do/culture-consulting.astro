---
/* Culture consulting: a long-term partnership, not a session or a program.
   Copy from the previous site's Culture Consulting page. It never had a form of
   its own; every call to action goes to /contact. */
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { PILLARS } from '../../data/aoh';

/** The four things we do, in order, over time. */
const STAGES = [
  { short: 'Diagnose', icon: 'search', title: 'Diagnose what’s really going on',
    text: 'We start by listening, and we look past the engagement scores to the patterns underneath.',
    line: '' },
  { short: 'Build', icon: 'layers', title: 'Build the system to shift it',
    text: 'Culture doesn’t change through campaigns. We design the operating model that makes fulfilment structural.',
    line: 'Not a campaign. An operating model.' },
  { short: 'Stay alongside', icon: 'users', title: 'Stay alongside your key people',
    text: 'We work with the leaders who hold the culture in their hands, always in service of the shift you set out to make.',
    line: 'Present when it matters, quiet when it doesn’t.' },
  { short: 'Until it holds', icon: 'shield', title: 'Until it holds on its own',
    text: 'The measure of the work isn’t our presence. It’s whether the culture holds after we step back.',
    line: 'We stay until the system runs itself, and your people are the ones running it.' },
] as const;

const FOR = [
  { icon: 'target', text: 'Leadership teams who know the culture is the constraint, and are ready to treat it that way.' },
  { icon: 'eye', text: 'Organisations where the surface metrics look fine, but something underneath is off.' },
  { icon: 'climb', text: 'Businesses going through growth, restructure or new psychosocial obligations that a program alone can’t answer.' },
  { icon: 'talk', text: 'Founders and CEOs who want a partner in the room, not a deck in the inbox.' },
] as const;

const FAQ = [
  ['Is this a program?', 'No. It isn’t a session, a program or a deck. We come inside the organisation, learn it honestly, and work alongside the people who shape it until the culture you want is the culture you have.'],
  ['Where does it start?', 'With a conversation. We listen first, then decide together whether this is the right fit for the shift you want to make. The work itself starts with listening too: to leaders, to teams and to the quiet middle.'],
  ['Who do you work with day to day?', 'The leaders who hold the culture in their hands. Coaching, sparring and honest counsel, present when it matters and quiet when it doesn’t.'],
  ['How long do you stay?', 'Until it holds on its own. We stay until the system runs itself, and your people are the ones running it.'],
  ['How will we know it’s holding?', 'nørma brings wellbeing to scale: a monthly check-in across the Five Pillars for every person and every team, and a live view of your culture for you. So you can see whether the shift is holding long after we step back.'],
];

// "Until it holds": the shape the work aims for. Our presence comes down over
// time while the culture's ability to hold on its own goes up. No data, no scale.
const CH = { x0: 30, x1: 400, top: 24, bottom: 176 };
const presence = `M${CH.x0} 44 C 150 44, 210 70, 270 132 S 360 166, ${CH.x1} 168`;
const holding = `M${CH.x0} 164 C 130 162, 190 140, 250 92 S 350 40, ${CH.x1} 34`;
---
<Base title="Culture consulting · The Artistry of Humanity" description="For when the culture itself needs work. We diagnose what is really going on, build the system to shift it, and stay alongside your key people until it holds. A partnership, not a program." path="/what-we-do/culture-consulting">

  <!-- Hero -->
  <section class="bg-dark" style="overflow:hidden">
    <div class="glow" style="right:-18%;top:-30%;width:70%;background:radial-gradient(closest-side,rgba(217,234,110,.14),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap split" style="padding-top:clamp(48px,7vw,96px);padding-bottom:clamp(120px,14vw,190px)">
      <div style="max-width:600px">
        <span class="eyebrow">Culture consulting · A partnership</span>
        <h1 style="color:var(--on-dark)">For when <span class="mk mk-d">the culture itself</span> needs work.</h1>
        <p class="lead">We diagnose what is really going on, build the system to shift it, and stay alongside your key people until it holds.</p>
        <div class="btns">
          <a class="btn btn-lime" href="/contact">Start a conversation</a>
          <a class="btn btn-ghost" href="#how">How it runs</a>
        </div>
      </div>
      <figure class="hero-fig">
        <div class="photo" style="aspect-ratio:500/440;box-shadow:0 50px 90px -40px rgba(0,0,0,.7)"><img src="/assets/happy-participants.jpg" alt="A large group of workshop participants outdoors, arms raised" width="1024" height="683" style="object-position:50% 60%" /></div>
        <div class="hero-note" data-rv>
          <span class="hn-ico"><Icon name="users" size={22} /></span>
          <span><b>A partnership, not a program</b>We come inside the organisation and stay alongside your people until the culture holds.</span>
        </div>
      </figure>
    </div>
  </section>

  <!-- A program ends; a culture doesn't -->
  <section class="lift" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="split" style="align-items:center">
        <div style="flex:1 1 360px">
          <span class="eyebrow">A partnership</span>
          <h2>A program has an end date. <span class="mk">A culture doesn’t.</span></h2>
          <p class="lead">This isn’t a session, a program or a deck. We come inside the organisation, learn it honestly, and work alongside the people who shape it until the culture you want is the culture you have.</p>
        </div>
        <figure class="tl" data-rv role="img" aria-label="A program runs from a start date to an end date and stops. A culture keeps going.">
          <div class="tl-row tl-prog">
            <span class="tl-k">A program</span>
            <div class="tl-track"><span class="tl-bar"></span><span class="tl-stop"><b>End date</b></span><span class="tl-after"></span></div>
          </div>
          <div class="tl-row tl-cult">
            <span class="tl-k">A culture</span>
            <div class="tl-track"><span class="tl-bar"></span><svg class="tl-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 5l7 7-7 7" /></svg><span class="tl-tag">Keeps going</span></div>
          </div>
          <div class="tl-axis" aria-hidden="true"><span>Start</span><span>Over time</span></div>
        </figure>
      </div>
    </div>
  </section>

  <!-- How the engagement runs -->
  <section id="how" class="bg-dark lift-b">
    <div class="glow" style="left:-16%;bottom:-20%;width:56%;background:radial-gradient(closest-side,rgba(217,234,110,.1),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap sec" style="position:relative">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">How the engagement runs</span><h2>Four things, in order, <span class="mk mk-d">over time</span>.</h2></div>
        <p class="lead" style="margin-top:0">Every organisation is different, so the work is shaped around yours. The order stays the same.</p>
      </div>

      <div class="fl" data-tabs data-auto="9000">
        <div class="fl-nodes" role="tablist" aria-label="The four stages">
          {STAGES.map((s, i) => (
            <button type="button" class="fl-node" role="tab" id={`fl-t${i}`} aria-controls={`fl-p${i}`}>
              <span class="fl-dot"><Icon name={s.icon} size={24} /><i>{i + 1}</i></span>
              <span class="fl-l">{s.short}</span>
            </button>
          ))}
        </div>
        <div class="fl-stage">
          <div class="fl-panel" role="tabpanel" id="fl-p0" aria-labelledby="fl-t0">
            <div class="fl-copy"><span class="eyebrow">Stage 1 of 4</span><h3>{STAGES[0].title}</h3><p class="body">{STAGES[0].text}</p></div>
            <div class="fl-vis">
              <span class="fl-k">We listen to</span>
              <div class="chips"><span><Icon name="users" size={16} />Leaders</span><span><Icon name="users" size={16} />Teams</span><span><Icon name="users" size={16} />The quiet middle</span></div>
              <span class="fl-k" style="margin-top:22px">And look for</span>
              <ul class="fl-list"><li>What people carry</li><li>What they can’t say</li><li>What the culture rewards in practice, not in policy</li></ul>
            </div>
          </div>
          <div class="fl-panel" role="tabpanel" id="fl-p1" aria-labelledby="fl-t1">
            <div class="fl-copy"><span class="eyebrow">Stage 2 of 4</span><h3>{STAGES[1].title}</h3><p class="body">{STAGES[1].text}</p><p class="fl-line">{STAGES[1].line}</p></div>
            <div class="fl-vis">
              <span class="fl-k">The operating model covers</span>
              <ol class="om">
                <li><Icon name="compass" size={20} />How leaders lead</li>
                <li><Icon name="talk" size={20} />How teams communicate</li>
                <li><Icon name="map" size={20} />How decisions get made</li>
                <li><span class="om-pl" aria-hidden="true">{PILLARS.map(p => <i style={`background:${p.tint}`}></i>)}</span>How the Five Pillars show up day to day</li>
              </ol>
            </div>
          </div>
          <div class="fl-panel" role="tabpanel" id="fl-p2" aria-labelledby="fl-t2">
            <div class="fl-copy"><span class="eyebrow">Stage 3 of 4</span><h3>{STAGES[2].title}</h3><p class="body">{STAGES[2].text}</p><p class="fl-line">{STAGES[2].line}</p></div>
            <div class="fl-vis">
              <span class="fl-k">What that looks like</span>
              <div class="trio">
                <div><span class="ico"><Icon name="talk" /></span><b>Coaching</b></div>
                <div><span class="ico"><Icon name="spark" /></span><b>Sparring</b></div>
                <div><span class="ico"><Icon name="heart" /></span><b>Honest counsel</b></div>
              </div>
            </div>
          </div>
          <div class="fl-panel" role="tabpanel" id="fl-p3" aria-labelledby="fl-t3">
            <div class="fl-copy"><span class="eyebrow">Stage 4 of 4</span><h3>{STAGES[3].title}</h3><p class="body">{STAGES[3].text}</p><p class="fl-line">{STAGES[3].line}</p></div>
            <figure class="fl-vis hold">
              <svg viewBox="0 0 430 210" role="img" aria-label="The shape we work towards: over time our presence comes down, and the culture holds on its own">
                <line x1={CH.x0} x2={CH.x1} y1={CH.bottom + 8} y2={CH.bottom + 8} stroke="rgba(228,240,214,.2)" stroke-width="1" />
                <line x1="300" x2="300" y1={CH.top} y2={CH.bottom + 8} stroke="rgba(228,240,214,.25)" stroke-width="1" stroke-dasharray="3 5" />
                <text x="292" y={CH.bottom + 1} text-anchor="end" font-family="'DM Sans', system-ui, sans-serif" font-size="12" font-weight="600" letter-spacing="1.4" fill="rgba(201,212,194,.8)">WE STEP BACK</text>
                <path class="h-l" d={presence} fill="none" stroke="rgba(246,244,233,.55)" stroke-width="2.5" stroke-dasharray="6 6" stroke-linecap="round" />
                <path class="h-l" d={holding} fill="none" stroke="#D9EA6E" stroke-width="3.5" stroke-linecap="round" />
                <text x={CH.x0} y="34" font-family="'DM Sans', system-ui, sans-serif" font-size="14" font-weight="600" fill="rgba(246,244,233,.7)">Our presence</text>
                <text x={CH.x1} y="24" text-anchor="end" font-family="'DM Sans', system-ui, sans-serif" font-size="14" font-weight="600" fill="#EAF79B">The culture, on its own</text>
                <text x={CH.x0} y="204" font-family="'DM Sans', system-ui, sans-serif" font-size="12" font-weight="600" letter-spacing="1.4" fill="rgba(201,212,194,.6)">OVER TIME</text>
              </svg>
              <figcaption class="small" style="color:var(--on-dark-muted)">The shape we work towards, not a measurement.</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who it is for -->
  <section class="bg-sand lift">
    <div class="wrap sec split">
      <figure style="margin:0;flex:0 1 420px" data-rv>
        <div class="arch" style="aspect-ratio:420/520;box-shadow:0 50px 90px -40px rgba(20,35,26,.5)"><img src="/assets/ian-speaking.webp" alt="Ian Williams speaking with a room of business leaders" width="632" height="783" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 30%" /></div>
      </figure>
      <div>
        <span class="eyebrow">Who it’s for</span>
        <h2>For leaders who want <span class="mk">a partner in the room</span>.</h2>
        <ul class="fr">{FOR.map(f => <li data-rv><span class="ico"><Icon name={f.icon} size={22} /></span><span>{f.text}</span></li>)}</ul>
        <div class="ian">
          <b>30+ years</b>
          <span>Ian has spent more than thirty years leading teams, turning around underperforming businesses and building high-performing cultures across three continents. That operational experience is what we bring into the room. <a class="link" style="margin-top:0" href="/about">Ian’s story ›</a></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Alongside the work: keynotes and nørma -->
  <section class="lift-b" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">Alongside the work</span><h2>Bring everyone in. <span class="mk">See if it holds.</span></h2></div>
        <p class="lead" style="margin-top:0">Culture work lives with your leaders, but it has to reach everyone. Two things help it travel, and show you whether it’s sticking.</p>
      </div>
      <div class="al">
        <a class="al-tile al-photo" href="/what-we-do/keynotes-workshops" data-rv>
          <img src="/assets/keynote.jpg" alt="" width="1024" height="683" loading="lazy" />
          <span class="al-txt">
            <span class="pill">Keynotes &amp; workshops</span>
            <b>Start the conversation with everyone</b>
            <span>A keynote from Ian puts the whole organisation in the same conversation, built on the same Five Pillars as the consulting work.</span>
            <span class="link">See the keynotes ›</span>
          </span>
        </a>
        <a class="al-tile al-norma" href="/what-we-do/norma" data-rv>
          <span class="al-shot"><img src="/assets/dash-hero.webp" alt="The nørma leader dashboard" width="1120" height="816" loading="lazy" /></span>
          <span class="al-txt">
            <span class="pill">nørma · Wellbeing at scale</span>
            <b>Keep the picture current</b>
            <span>Consulting works closely with a few key people. nørma reaches every person and every team, every month, and shows you whether the shift is holding long after we step back.</span>
            <span class="link">How nørma fits ›</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Questions and close -->
  <section class="bg-sand lift">
    <div class="wrap sec">
      <div class="cl">
        <div>
          <span class="eyebrow">Questions leaders ask</span>
          <h2 style="font-size:clamp(30px,3.4vw,42px)">Before we start.</h2>
          <div class="accs" style="margin-top:26px">
            {FAQ.map(([q, a]) => <details class="acc"><summary>{q}</summary><div class="acc-body"><p>{a}</p></div></details>)}
          </div>
        </div>
        <div class="card-dark cl-card">
          <span class="eyebrow">Every engagement starts with a conversation</span>
          <h2>Ready to talk about what your culture <span class="mk mk-d">actually needs</span>?</h2>
          <p class="lead">We listen first, then decide together whether this is the right fit for the shift you want to make.</p>
          <div class="btns"><a class="btn btn-lime" href="/contact">Start a conversation</a><a class="btn btn-ghost" href="/what-we-do">Other ways to work with us</a></div>
          <p class="small" style="margin-top:24px;color:rgba(201,212,194,.7)">Or email <a href="mailto:ian@artistry-of-humanity.com" style="color:#EAF79B">ian@artistry-of-humanity.com</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero: the photo, with the four stages as a strip. */
  .hero-fig { position: relative; margin: 0; flex: 0 1 500px; padding-bottom: 44px; }
  .hero-note { position: absolute; left: -8%; bottom: 0; display: flex; align-items: flex-start; gap: 14px; max-width: 360px; padding: 16px 20px 16px 16px; font-size: 13.5px; line-height: 1.45; color: var(--on-dark-muted); border-radius: 22px 16px 22px 14px / 16px 22px 14px 22px; background: rgba(15, 32, 21, .84); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: inset 0 0 0 1px rgba(228, 240, 214, .1), 0 30px 60px -20px rgba(0, 0, 0, .7); }
  .hero-note b { display: block; margin-bottom: 2px; font: 600 15px/1.3 var(--sans); color: var(--on-dark); }
  .hn-ico { flex: none; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 14px 11px 14px 10px / 11px 14px 10px 14px; background: var(--lime); color: #152213; }
  @media (max-width: 860px) { .hero-note { left: 0; right: 0; max-width: none; } }

  /* A program ends, a culture keeps going */
  .tl { flex: 1 1 420px; margin: 0; padding: clamp(26px, 3vw, 40px); border-radius: var(--r-b); background: linear-gradient(150deg, rgba(250, 248, 240, .9), rgba(244, 242, 230, .7)); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .75), 0 30px 60px -36px rgba(20, 35, 26, .3); }
  .tl-row + .tl-row { margin-top: 30px; }
  .tl-k { display: block; font: 400 clamp(22px, 2.2vw, 26px)/1.2 var(--serif); color: var(--ink); }
  .tl-track { position: relative; display: flex; align-items: center; height: 44px; margin-top: 10px; }
  .tl-prog .tl-bar { flex: 0 0 52%; height: 14px; border-radius: 7px 3px 3px 7px; background: rgba(20, 35, 26, .22); }
  .tl-stop { position: relative; flex: none; width: 3px; height: 40px; border-radius: 2px; background: var(--ink); }
  .tl-stop b { position: absolute; left: 10px; top: -4px; white-space: nowrap; font: 600 11px var(--sans); letter-spacing: 1.6px; text-transform: uppercase; color: var(--ink); }
  .tl-after { flex: 1; height: 2px; margin-left: 8px; background: repeating-linear-gradient(90deg, rgba(20, 35, 26, .15) 0 4px, transparent 4px 10px); }
  .tl-cult .tl-bar { flex: 1; height: 14px; border-radius: 7px 0 0 7px; background: linear-gradient(90deg, var(--olive), var(--lime-3) 70%, rgba(211, 228, 95, .4)); }
  .tl-arrow { flex: none; margin-left: -2px; color: var(--olive); }
  .tl-tag { position: absolute; right: 26px; top: -14px; font: 600 11px var(--sans); letter-spacing: 1.6px; text-transform: uppercase; color: var(--olive); }
  .tl-axis { display: flex; justify-content: space-between; margin-top: 18px; padding-top: 10px; border-top: 1px solid var(--line); font: 600 10.5px var(--sans); letter-spacing: 1.6px; text-transform: uppercase; color: var(--muted-2); }
  :global(.js) .tl .tl-bar { transform: scaleX(0); transform-origin: left; transition: transform 1.2s var(--ease) .3s; }
  :global(.js) .tl.on .tl-bar { transform: none; }
  :global(.js) .tl .tl-cult .tl-bar { transition-delay: .5s; transition-duration: 1.3s; }

  /* The four stages: nodes on a line, one panel at a time */
  .fl { margin-top: clamp(44px, 5vw, 64px); }
  .fl-nodes { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .fl-nodes::before { content: ''; position: absolute; left: 12.5%; right: 12.5%; top: 31px; height: 2px; background: repeating-linear-gradient(90deg, rgba(217, 234, 110, .4) 0 5px, transparent 5px 11px); }
  .fl-node { position: relative; display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 0 4px 14px; border: 0; background: none; color: var(--on-dark-muted); font: inherit; cursor: pointer; border-radius: 18px; }
  .fl-dot { position: relative; display: flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 50%; background: #13281A; color: var(--lime); box-shadow: inset 0 0 0 1.5px rgba(217, 234, 110, .4), 0 0 0 6px var(--dark); transition: background .25s ease, color .25s ease, transform .3s var(--ease); }
  .fl-dot i { position: absolute; right: -4px; top: -4px; display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: var(--dark); box-shadow: inset 0 0 0 1.5px rgba(217, 234, 110, .5); font: normal 600 11px var(--sans); color: var(--lime); }
  .fl-l { font: 600 15px/1.25 var(--sans); text-align: center; }
  .fl-node:hover .fl-dot { transform: scale(1.06); }
  .fl-node[aria-selected=true] { color: var(--on-dark); }
  .fl-node[aria-selected=true] .fl-dot { background: var(--lime); color: #152213; box-shadow: 0 0 0 6px var(--dark), 0 0 0 7px rgba(217, 234, 110, .5); }
  .fl-node[aria-selected=true] .fl-dot i { background: var(--dark); color: var(--lime); box-shadow: none; }
  .fl-node[aria-selected=true]::after { content: ''; position: absolute; left: 50%; bottom: 0; width: 28px; height: 3px; margin-left: -14px; border-radius: 2px; background: var(--lime); }
  .fl-stage { margin-top: clamp(28px, 3vw, 40px); padding: clamp(26px, 3.4vw, 48px); border-radius: var(--r-a); background: rgba(228, 240, 214, .05); box-shadow: inset 0 0 0 1px rgba(228, 240, 214, .08); }
  .fl-stage > .fl-panel + .fl-panel { margin-top: 48px; padding-top: 40px; border-top: 1px solid var(--line-dark); }
  @media (min-width: 861px) {
    .tabs-on .fl-stage { display: grid; }
    .tabs-on .fl-stage > .fl-panel { grid-area: 1 / 1; margin-top: 0; padding-top: 0; border-top: 0; }
    .tabs-on .fl-stage > .fl-panel[hidden] { display: grid !important; visibility: hidden; }
  }
  .tabs-on .fl-stage > .fl-panel { margin-top: 0; padding-top: 0; border-top: 0; }
  .fl-panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
  .fl-copy h3 { margin-top: 12px; font-size: clamp(28px, 3vw, 38px); }
  .fl-line { margin: 18px 0 0; padding-left: 16px; border-left: 2px solid var(--lime); font: 500 17px/1.45 var(--sans); color: var(--on-dark); }
  .fl-vis { margin: 0; }
  .fl-k { display: block; font: 600 11px var(--sans); letter-spacing: 2px; text-transform: uppercase; color: #DCEC85; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .chips span { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px 0 12px; border-radius: 999px; background: rgba(217, 234, 110, .12); color: var(--on-dark); font: 600 14.5px var(--sans); }
  .chips :global(svg) { color: var(--lime); }
  .fl-list { list-style: none; margin: 10px 0 0; padding: 0; }
  .fl-list li { position: relative; padding: 10px 0 10px 26px; border-top: 1px solid var(--line-dark); font: 500 16px/1.45 var(--sans); color: var(--on-dark); }
  .fl-list li:first-child { border-top: 0; }
  .fl-list li::before { content: ''; position: absolute; left: 2px; top: 18px; width: 9px; height: 9px; border-radius: 50%; background: var(--lime); }
  .om { list-style: none; margin: 12px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
