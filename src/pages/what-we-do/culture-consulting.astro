---
import Base from '../../layouts/Base.astro';

// Culture consulting: a long-term partnership, not a session or a program.
// Copy from the previous site's Culture Consulting page. It never had a form of
// its own; every call to action goes to /contact.

const STEPS = [
  ['Diagnose what’s really going on', 'We start by listening: to leaders, to teams, to the quiet middle. We look past the engagement scores to the patterns underneath. What people carry, what they can’t say, and what the culture rewards in practice rather than in policy.'],
  ['Build the system to shift it', 'Culture doesn’t change through campaigns. We design the operating model that makes fulfilment structural: how leaders lead, how teams communicate, how decisions get made, and how the Five Pillars show up day to day.'],
  ['Stay alongside your key people', 'We work with the leaders who hold the culture in their hands. Coaching, sparring and honest counsel. Present when it matters, quiet when it doesn’t, always in service of the shift you set out to make.'],
  ['Until it holds on its own', 'The measure of the work isn’t our presence. It’s whether the culture holds after we step back. We stay until the system runs itself, and your people are the ones running it.'],
];

const FOR = [
  'Leadership teams who know the culture is the constraint, and are ready to treat it that way.',
  'Organisations where the surface metrics look fine, but something underneath is off.',
  'Businesses going through growth, restructure or new psychosocial obligations that a program alone can’t answer.',
  'Founders and CEOs who want a partner in the room, not a deck in the inbox.',
];
---
<Base title="Culture consulting · The Artistry of Humanity" description="For when the culture itself needs work. We diagnose what is really going on, build the system to shift it, and stay alongside your key people until it holds. A partnership, not a program." path="/what-we-do/culture-consulting">

  <!-- Hero -->
  <section class="bg-dark" style="overflow:hidden">
    <div class="glow" style="right:-18%;top:-30%;width:70%;background:radial-gradient(closest-side,rgba(217,234,110,.14),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap split" style="padding-top:clamp(48px,7vw,96px);padding-bottom:clamp(120px,14vw,190px)">
      <div style="max-width:600px">
        <span class="eyebrow">Culture consulting</span>
        <h1 style="color:var(--on-dark)">For when <span class="mk mk-d">the culture itself</span> needs work.</h1>
        <p class="lead">We diagnose what is really going on, build the system to shift it, and stay alongside your key people until it holds.</p>
        <div class="btns">
          <a class="btn btn-lime" href="/contact">Start a conversation</a>
          <a class="btn btn-ghost" href="#how">How it runs</a>
        </div>
      </div>
      <figure style="margin:0;flex:0 1 500px">
        <div class="photo" style="aspect-ratio:500/440;box-shadow:0 50px 90px -40px rgba(0,0,0,.7)"><img src="/assets/happy-participants.jpg" alt="A large group of workshop participants outdoors, arms raised" width="1024" height="683" style="object-position:50% 60%" /></div>
      </figure>
    </div>
  </section>

  <!-- A partnership, and how it runs -->
  <section id="how" class="lift" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div>
          <span class="eyebrow">A partnership</span>
          <h2>A program has an end date.<br /> <span class="mk">A culture doesn’t.</span></h2>
        </div>
        <p class="lead" style="margin-top:0">This isn’t a session, a program or a deck. We come inside the organisation, learn it honestly, and work alongside the people who shape it until the culture you want is the culture you have.</p>
      </div>
      <span class="eyebrow" style="margin-top:clamp(64px,7vw,96px)">How the engagement runs: four things, in order, over time</span>
      <div class="grid g2x2" style="margin-top:24px">
        {STEPS.map(([t, d], i) => (
          <div class={i === 0 ? 'card-dark' : 'card'} data-rv><span class="num">0{i + 1}</span><h3 style="margin-top:18px">{t}</h3><p class="body">{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who it is for -->
  <section class="bg-dark lift-b">
    <div class="glow" style="left:-16%;bottom:-20%;width:56%;background:radial-gradient(closest-side,rgba(217,234,110,.1),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap sec split">
      <figure style="margin:0;flex:0 1 420px" data-rv>
        <div class="arch" style="aspect-ratio:420/520;box-shadow:0 50px 90px -40px rgba(0,0,0,.7)"><img src="/assets/ian-speaking.webp" alt="Ian Williams speaking with a room of business leaders" width="632" height="783" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 30%" /></div>
      </figure>
      <div>
        <span class="eyebrow">Who it’s for</span>
        <h2>For leaders who want <span class="mk mk-d">a partner in the room</span>.</h2>
        <ul class="list" style="margin-top:30px">{FOR.map(f => <li>{f}</li>)}</ul>
        <p class="body" style="margin-top:26px">Ian has spent more than thirty years leading teams, turning around underperforming businesses and building high-performing cultures across three continents. That operational experience is what we bring into the room.</p>
        <a class="link" href="/about">Ian’s story ›</a>
      </div>
    </div>
  </section>

  <!-- Alongside the work: keynotes and nørma -->
  <section class="bg-sand lift">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">Alongside the work</span><h2>Bring everyone in.<br /> <span class="mk">See if it holds.</span></h2></div>
        <p class="lead" style="margin-top:0">Culture work lives with your leaders, but it has to reach everyone. Two things help it travel and help you see whether it’s sticking.</p>
      </div>
      <div class="grid g2" style="margin-top:clamp(44px,5vw,64px)">
        <a class="card" href="/what-we-do/keynotes-workshops" data-rv style="padding:0;overflow:hidden;display:flex;flex-direction:column">
          <img src="/assets/keynote.jpg" alt="" width="1024" height="683" loading="lazy" style="width:100%;aspect-ratio:16/8;object-fit:cover;object-position:50% 35%" />
          <div style="padding:clamp(24px,2.8vw,34px)">
            <span class="pill">Keynotes &amp; workshops</span>
            <h3 style="margin-top:14px">Start the conversation with everyone</h3>
            <p class="body">A keynote from Ian puts the whole organisation in the same conversation, in person or virtual, built on the same Five Pillars as the consulting work.</p>
            <span class="link">See the keynotes ›</span>
          </div>
        </a>
        <a class="card-dark" href="/what-we-do/norma" data-rv style="padding:0;overflow:hidden;display:flex;flex-direction:column">
          <div style="background:#F6F5EE;padding:clamp(18px,2.4vw,28px) clamp(18px,2.4vw,28px) 0"><img src="/assets/dash-hero.webp" alt="The nørma leader dashboard" width="1120" height="816" loading="lazy" style="width:100%;aspect-ratio:16/8;object-fit:cover;object-position:top;border-radius:14px 14px 0 0" /></div>
          <div style="padding:clamp(24px,2.8vw,34px)">
            <span class="pill">nørma</span>
            <h3 style="margin-top:14px">Keep the picture current</h3>
            <p class="body">nørma gives your people a monthly check-in across the Five Pillars and gives you a live view of your culture, so you can see whether the shift is holding long after we step back.</p>
            <span class="link">How nørma fits ›</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Close -->
  <section class="lift-b" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="card-dark center" style="max-width:860px;margin:0 auto;padding:clamp(48px,6vw,80px) clamp(24px,5vw,64px)">
        <span class="eyebrow">Every engagement starts with a conversation</span>
        <h2 style="margin-left:auto;margin-right:auto;max-width:15em">Ready to talk about what your culture <span class="mk mk-d">actually needs</span>?</h2>
        <p class="lead" style="margin-left:auto;margin-right:auto">We listen first, then decide together whether this is the right fit for the shift you want to make.</p>
        <div class="btns"><a class="btn btn-lime" href="/contact">Start a conversation</a><a class="btn btn-ghost" href="/what-we-do">Other ways to work with us</a></div>
        <p class="small" style="margin-top:24px;color:rgba(201,212,194,.7)">Or email <a href="mailto:ian@artistry-of-humanity.com" style="color:#EAF79B">ian@artistry-of-humanity.com</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* .sec resets .wrap's side padding when both sit on one element; keep the gutter. */
  .wrap.sec{padding-left:var(--gut);padding-right:var(--gut)}
  .num{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:16px 12px 16px 10px / 12px 16px 10px 16px;background:var(--dark);color:var(--lime);font:600 13px var(--sans);letter-spacing:.5px}
  .card-dark .num{background:rgba(217,234,110,.14);color:#EAF79B}
</style>
