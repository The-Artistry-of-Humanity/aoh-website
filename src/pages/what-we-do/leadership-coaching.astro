---
/* 1:1 leadership coaching, grounded in the Five Pillars. Copy from the previous
   site's Leadership Coaching page; the enquiry form keeps the old contact
   form's fields, with the interest fixed to coaching. */
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { PILLARS } from '../../data/aoh';

const SIGNS = [
  'Your best people keep leaving, and you’re not sure why',
  'You’ve invested in culture initiatives. Nothing seems to stick.',
  'The team respects you, but they’re not really with you',
  'Engagement scores aren’t moving despite everything you’ve tried',
  'You’re carrying more than anyone around you realises',
  'You know the culture needs to change, but not where to start',
];

const FOR_YOU = [
  { icon: 'pulse', tab: 'Something feels off', title: 'You’re performing well on paper, but something feels off', sub: 'The results are there. You’re running on empty.',
    text: 'From the outside everything looks fine. The results are there and the team respects you. Underneath, you’re running on empty, working from habit rather than intention. You need a space to be honest about that, with someone who can handle it.' },
  { icon: 'climb', tab: 'You ask more than you model', title: 'You’re asking your team to grow in ways you haven’t yourself', sub: 'You know modelling it matters.',
    text: 'You’re investing in culture, wellbeing and leadership development across the organisation. If you’re honest, you’re not modelling what you’re asking for, and you want to change that, not because it looks good, but because you know it matters.' },
  { icon: 'target', tab: 'Initiatives aren’t landing', title: 'Your culture initiatives aren’t landing', sub: 'People nod in the room, then nothing changes.',
    text: 'You’ve tried the programs, the workshops and the values statements. People nod in the room and go back to the same patterns. The missing piece isn’t another initiative. It’s the leader modelling something different every day.' },
] as const;

const HOW = [
  { icon: 'target', title: 'It starts with the Fulfilment Score', sub: 'Your baseline',
    text: 'Every engagement begins with an honest assessment across all Five Pillars. That gives you a clear baseline: where you are right now, across every part of your life that affects how you lead.' },
  { icon: 'talk', title: 'Structured, but not rigid', sub: '60–90 minute sessions',
    text: 'Sessions are typically 60–90 minutes, held regularly over an agreed period. The framework gives structure, and the conversation goes where it needs to go. There’s no fixed curriculum.' },
  { icon: 'check', title: 'Accountability is built in', sub: 'Commitments between sessions',
    text: 'Between sessions you hold a few commitments: small, specific and honest. Not a to-do list, but intentions that keep the work moving. Progress is tracked against your Fulfilment Score over time.' },
] as const;

// The coaching loop: your score, then sessions and commitments, measured
// against the score again. Three nodes on a ring, clockwise.
const C = { x: 250, y: 222, r: 124 };
const at = (deg: number, r = C.r) => [C.x + r * Math.cos((deg * Math.PI) / 180), C.y + r * Math.sin((deg * Math.PI) / 180)];
const NODES = [
  { deg: -90, icon: 'target', label: 'Your score', sub: 'the baseline', lx: 46, ly: -20, start: true },
  { deg: 30, icon: 'talk', label: 'Sessions', sub: '60–90 minutes', lx: 0, ly: 66 },
  { deg: 150, icon: 'check', label: 'Commitments', sub: 'between sessions', lx: 0, ly: 66 },
];
const CHEVRONS = [-30, 90, 210].map(d => { const [x, y] = at(d); return { x, y, rot: d + 90 }; });
const ICONS: Record<string, string[]> = {
  target: ['M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z', 'M17 12a5 5 0 1 1-10 0 5 5 0 0 1 10 0z', 'M12.5 12a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0z'],
  talk: ['M3.5 6.5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H9.5L6 16.5v-3h-.5a2 2 0 0 1-2-2z', 'M18.5 9h.5a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-.5v3L15 18h-3a2 2 0 0 1-2-2v-.5'],
  check: ['M5 12.5l4.5 4.5L19 7.5'],
};

const NEXT = [
  { href: '/what-we-do/wellness-accelerator', icon: 'climb', tag: 'For the team', title: 'Wellness Accelerator', text: 'Six weeks through the Five Pillars with your leadership team, one pillar at a time.' },
  { href: '/what-we-do/keynotes-workshops', icon: 'mic', tag: 'For everyone', title: 'Keynotes', text: 'Take the conversation to the wider organisation with Ian on stage, in person or virtual.' },
  { href: '/what-we-do/norma', icon: 'norma', tag: 'Wellbeing at scale', title: 'nørma', text: 'Coaching works with one leader. nørma reaches every person and every team, every month.' },
] as const;
---
<Base title="Leadership coaching · The Artistry of Humanity" description="1:1 leadership coaching with Ian Williams, grounded in the Five Pillars of Fulfilment. Private, structured and honest, for leaders who want to model what they ask of their teams. In person or virtual." path="/what-we-do/leadership-coaching">

  <!-- Hero -->
  <section class="bg-dark" style="overflow:hidden">
    <div class="glow" style="right:-18%;top:-30%;width:70%;background:radial-gradient(closest-side,rgba(217,234,110,.14),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap split" style="padding-top:clamp(48px,7vw,96px);padding-bottom:clamp(120px,14vw,190px)">
      <div style="max-width:610px">
        <span class="eyebrow">Leadership coaching · 1:1</span>
        <h1 style="color:var(--on-dark)">You can’t ask your people to do work <span class="mk mk-d">you haven’t done yourself</span>.</h1>
        <p class="lead">One-to-one coaching grounded in the Five Pillars of Fulfilment. A structured, honest process for leaders who want to show up differently, for themselves and for the people they lead.</p>
        <div class="tags">
          <span class="pill"><Icon name="calendar" size={15} width={2} />3–6 months</span><span class="pill"><Icon name="clock" size={15} width={2} />60–90 minute sessions</span><span class="pill"><Icon name="lock" size={15} width={2} />Private</span>
        </div>
        <div class="btns">
          <a class="btn btn-lime" href="#enquire">Enquire about coaching</a>
          <a class="btn btn-ghost" href="#how">How it works</a>
        </div>
      </div>
      <figure class="hero-fig">
        <div class="arch" style="aspect-ratio:420/520;position:relative;background:radial-gradient(64% 42% at 50% 22%,rgba(217,234,110,.6),rgba(217,234,110,.16) 55%,rgba(217,234,110,0) 82%),linear-gradient(180deg,#E8EACB,#ECE8D7 52%,#E4DFCA);box-shadow:0 50px 90px -40px rgba(0,0,0,.7)">
          <img src="/assets/ian-portrait.webp" alt="Ian Williams" width="900" height="802" style="position:absolute;left:50%;bottom:0;width:128%;max-width:none;transform:translateX(-50%)" />
        </div>
        <div class="hero-chip" data-rv>
          <span class="hc-dots" aria-hidden="true">{PILLARS.map((p, i) => <i style={`background:${p.tint};--d:${(0.4 + i * 0.1).toFixed(1)}s`}><Icon paths={p.paths} size={16} stroke="#14231A" width={1.6} /></i>)}</span>
          <span><b>It starts with you</b>Your own Fulfilment Score, across all Five Pillars</span>
        </div>
      </figure>
    </div>
  </section>

  <!-- Inside out: the gap between what leaders ask and what they do -->
  <section class="lift" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">Why coaching</span><h2>Leadership starts from <span class="mk">the inside out</span>.</h2></div>
        <p class="lead" style="margin-top:0">The pattern Ian sees most often in senior leaders: deeply invested in the performance and wellbeing of their teams, and far less invested in their own.</p>
      </div>

      <figure class="gap" data-rv>
        <div class="gap-side">
          <span class="gap-k">What leaders ask of their people</span>
          <ul><li>More open</li><li>More self-aware</li><li>More accountable</li></ul>
        </div>
        <div class="gap-mid">
          <svg viewBox="0 0 120 40" aria-hidden="true" preserveAspectRatio="none"><path d="M4 20h112" stroke="#4A6B3A" stroke-width="2" stroke-dasharray="4 6" stroke-linecap="round" /><path d="M10 12l-7 8 7 8M110 12l7 8-7 8" stroke="#4A6B3A" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <b>The gap</b>
          <span>People feel it even when they can’t name it.</span>
        </div>
        <div class="gap-side gap-self">
          <span class="gap-k">What leaders go back to</span>
          <ul><li>The same patterns</li><li>The same blind spots</li><li>The same way of operating</li></ul>
        </div>
        <figcaption class="small">That gap is one of the most consistent sources of cultural dysfunction in organisations.</figcaption>
      </figure>

      <div class="lens">
        <div class="lens-q">
          <span class="eyebrow">The Five Pillars, as a lens for you</span>
          <p>Where are you actually at, across all five parts of your life? <span class="mk">What is that costing you</span>, and the people around you?</p>
          <div class="lens-pl">{PILLARS.map(p => <span title={p.name} style={`background:${p.tint}`}><Icon paths={p.paths} size={20} stroke="#14231A" width={1.5} /><span class="sr">{p.name}</span></span>)}</div>
        </div>
        <div class="accs">
          <details class="acc" open>
            <summary><span class="ico"><Icon name="search" size={22} /></span>Why leaders get stuck</summary>
            <div class="acc-body"><p>They commission programs and champion culture initiatives. They ask their people to be more open, more self-aware and more accountable. Then they return to the same patterns, because nobody has ever made space for them to do anything different.</p></div>
          </details>
          <details class="acc">
            <summary><span class="ico"><Icon name="users" size={22} /></span>Not generic executive coaching</summary>
            <div class="acc-body"><p>It’s structured, honest and grounded in a framework that looks at the whole person, not just the role. It’s for leaders who are ready to stop optimising around the edges and do the deeper work that changes how they show up.</p></div>
          </details>
          <details class="acc">
            <summary><span class="ico"><Icon name="compass" size={22} /></span>Why it matters more now</summary>
            <div class="acc-body"><p>When everything is speeding up, with AI, change, pressure and expectation, the leaders who stay grounded in who they are and what they value are the ones who bring stability to the people around them.</p></div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- The line worth keeping -->
  <section class="lift-b q-band">
    <div class="wrap sec-tight">
      <figure class="q-fig" data-rv>
        <svg class="q-mark" width="52" height="39" viewBox="0 0 64 48" aria-hidden="true"><path d="M0 48V28C0 12 8 3 24 0l3 6C17 9 13 15 12.5 22H26v26zm36 0V28c0-16 8-25 24-28l3 6c-10 3-14 9-14.5 16H62v26z" fill="#14231A" /></svg>
        <blockquote>The leaders who create the most impact aren’t the ones who have it all figured out. They’re the ones willing to keep <span class="mk mk-q">looking honestly at themselves</span>.</blockquote>
      </figure>
    </div>
  </section>

  <!-- Is this you -->
  <section class="bg-sand lift">
    <div class="wrap sec">
      <span class="eyebrow">Who it’s for</span>
      <h2>This coaching is <span class="mk">for you</span> if…</h2>
      <div class="fy">
        <div class="fy-tabs" data-tabs>
          <div class="tablist" role="tablist" aria-label="Which sounds like you?">
            {FOR_YOU.map((f, i) => (
              <button type="button" class="tab" role="tab" id={`fy-t${i}`} aria-controls={`fy-p${i}`}><Icon name={f.icon} size={18} />{f.tab}</button>
            ))}
          </div>
          <div class="fy-stage">
            {FOR_YOU.map((f, i) => (
              <div class="fy-panel" role="tabpanel" id={`fy-p${i}`} aria-labelledby={`fy-t${i}`}>
                <span class="ico"><Icon name={f.icon} size={28} /></span>
                <h3>{f.title}</h3>
                <p class="fy-sub">{f.sub}</p>
                <p class="body">{f.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="card-dark sf" data-sf data-rv>
          <span class="eyebrow">Sound familiar?</span>
          <p class="sf-h">Tick whatever sounds like your organisation.</p>
          <ul class="sf-list">
            {SIGNS.map(s => <li><label><input type="checkbox" /><span class="sf-box" aria-hidden="true"><Icon name="check" size={14} width={2.4} /></span><span>{s}</span></label></li>)}
          </ul>
          <p class="sf-out"><span class="sf-n" hidden><b data-sf-n>0</b> of {SIGNS.length}.</span> These are organisational symptoms. The most effective place to address them is closer to home.</p>
          <div class="btns" style="margin-top:22px"><a class="btn btn-lime" href="#enquire">Enquire about coaching</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works: the coaching loop -->
  <section id="how" class="bg-dark lift-b">
    <div class="glow" style="right:-14%;top:-10%;width:52%;background:radial-gradient(closest-side,rgba(217,234,110,.1),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap sec" style="position:relative">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">How the coaching works</span><h2>Every leader is different. <span class="mk mk-d">The approach isn’t.</span></h2></div>
        <p class="lead" style="margin-top:0">Each engagement is shaped around the leader in front of us. The rhythm stays the same: know where you are, do the work, check it moved.</p>
      </div>
      <div class="hw">
        <figure class="loop" data-rv>
          <svg viewBox="0 0 500 420" role="img" aria-label="The coaching loop: it starts with your Fulfilment Score, then regular 60 to 90 minute sessions and commitments between them, with progress tracked against your score, over a typical three to six months">
            <circle class="lp-ring" cx={C.x} cy={C.y} r={C.r} fill="none" stroke="#D9EA6E" stroke-opacity=".5" stroke-width="2" stroke-dasharray="3 9" stroke-linecap="round" />
            {CHEVRONS.map(c => <path d="M-6 -7 L3 0 L-6 7" transform={`translate(${c.x.toFixed(1)} ${c.y.toFixed(1)}) rotate(${c.rot})`} fill="none" stroke="#D9EA6E" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />)}
            <g class="lp-start">
              <path d={`M40 ${(C.y - C.r).toFixed(0)} H${(C.x - 52).toFixed(0)}`} stroke="#EAF79B" stroke-width="2" stroke-linecap="round" />
              <path d={`M${(C.x - 60).toFixed(0)} ${(C.y - C.r - 7).toFixed(0)} L${(C.x - 51).toFixed(0)} ${(C.y - C.r).toFixed(0)} L${(C.x - 60).toFixed(0)} ${(C.y - C.r + 7).toFixed(0)}`} fill="none" stroke="#EAF79B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              <text x="40" y={C.y - C.r - 14} font-family="'DM Sans', system-ui, sans-serif" font-size="13" font-weight="600" letter-spacing="1.8" fill="#DCEC85">START</text>
            </g>
            <text x={C.x} y={C.y + 6} text-anchor="middle" font-family="'DM Serif Display', Georgia, serif" font-size="38" fill="#F6F4E9">3–6</text>
            <text x={C.x} y={C.y + 30} text-anchor="middle" font-family="'DM Sans', system-ui, sans-serif" font-size="15" fill="rgba(201,212,194,.85)">months, typically</text>
            {NODES.map((n, i) => { const [x, y] = at(n.deg); return (
              <g class="lp-node" style={`--d:${(0.2 + i * 0.18).toFixed(2)}s`}>
                <circle cx={x} cy={y} r="36" fill="#0F2015" stroke="#D9EA6E" stroke-width="2" />
                <g transform={`translate(${(x - 15).toFixed(1)} ${(y - 15).toFixed(1)}) scale(1.25)`} fill="none" stroke="#D9EA6E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">{ICONS[n.icon].map(d => <path d={d} />)}</g>
                <circle cx={x + 27} cy={y - 27} r="12" fill="#D9EA6E" />
                <text x={x + 27} y={y - 22.5} text-anchor="middle" font-family="'DM Sans', system-ui, sans-serif" font-size="13" font-weight="600" fill="#152213">{i + 1}</text>
                <text x={x + n.lx} y={y + n.ly} text-anchor={n.start ? 'start' : 'middle'} font-family="'DM Sans', system-ui, sans-serif" font-size="18" font-weight="600" fill="#F6F4E9">{n.label}</text>
                <text x={x + n.lx} y={y + n.ly + 20} text-anchor={n.start ? 'start' : 'middle'} font-family="'DM Sans', system-ui, sans-serif" font-size="14" fill="rgba(201,212,194,.85)">{n.sub}</text>
              </g>
            ); })}
          </svg>
        </figure>
        <ol class="hw-list">
          {HOW.map((h, i) => (
            <li data-rv>
              <span class="hw-n">{i + 1}</span>
              <div><span class="hw-sub">{h.sub}</span><h3>{h.title}</h3><p class="body">{h.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <div class="facts">
        <div><b>1:1</b><span>In person or virtual, across Australia and internationally</span></div>
        <div><b>60–90 min</b><span>Per session, held regularly</span></div>
        <div><b>3–6 months</b><span>A typical engagement</span></div>
      </div>
    </div>
  </section>

  <!-- Private and confidential -->
  <section class="lift" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="pv">
        <span class="pv-lock" aria-hidden="true"><Icon name="lock" size={40} width={1.4} /></span>
        <div>
          <span class="eyebrow">Private and confidential</span>
          <h2>What’s discussed in coaching <span class="mk">stays in coaching</span>.</h2>
          <ul class="pv-no">
            <li><Icon name="x" size={16} width={2.2} />No reporting back to the organisation</li>
            <li><Icon name="x" size={16} width={2.2} />No summary for HR</li>
            <li><Icon name="x" size={16} width={2.2} />No performance framing</li>
          </ul>
          <p class="lead">This is your space to think, be honest and do the work.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- When leaders grow: the ripple -->
  <section class="bg-dark lift-b">
    <div class="wrap sec">
      <div class="split">
        <figure class="rp" data-rv>
          <svg viewBox="0 0 400 400" role="img" aria-label="A ripple: a leader at the centre, the team around them, and the culture around the team">
            <circle class="rp-wave" cx="200" cy="200" r="52" fill="none" stroke="#D9EA6E" stroke-width="2" />
            <circle class="rp-wave rp-w2" cx="200" cy="200" r="52" fill="none" stroke="#D9EA6E" stroke-width="2" />
            <circle cx="200" cy="200" r="186" fill="rgba(217,234,110,.04)" stroke="rgba(217,234,110,.22)" stroke-width="1.5" />
            <circle cx="200" cy="200" r="122" fill="rgba(217,234,110,.06)" stroke="rgba(217,234,110,.3)" stroke-width="1.5" />
            <circle cx="200" cy="200" r="56" fill="#D9EA6E" />
            <text x="200" y="207" text-anchor="middle" font-family="'DM Serif Display', Georgia, serif" font-size="24" fill="#152213">You</text>
            <text x="200" y="104" text-anchor="middle" font-family="'DM Sans', system-ui, sans-serif" font-size="14" font-weight="600" letter-spacing="2" fill="#EAF79B">YOUR TEAM</text>
            <text x="200" y="42" text-anchor="middle" font-family="'DM Sans', system-ui, sans-serif" font-size="14" font-weight="600" letter-spacing="2" fill="rgba(234,247,155,.75)">YOUR CULTURE</text>
          </svg>
        </figure>
        <div>
          <span class="eyebrow">The ripple effect</span>
          <h2>When leaders grow, <span class="mk mk-d">cultures shift</span>.</h2>
          <p class="lead">There is a direct line between the inner state of a leader and the culture of the team around them. Leadership behaviour shapes team culture more than values statements, HR programs or any initiative launched from the top.</p>
          <p class="body">Leaders who go through coaching often become the most credible champions of culture change in their organisations. Not because they’ve been trained to talk about it, but because they’ve done the work themselves.</p>
        </div>
      </div>
      <div class="nx">
        <span class="eyebrow">Take it further</span>
        <div class="nx-row">
          {NEXT.map(n => (
            <a href={n.href} class="nx-item">
              {n.icon === 'norma' ? <img src="/assets/norma-app-icon.png" alt="" width="44" height="44" /> : <span class="ico"><Icon name={n.icon} size={22} /></span>}
              <span><span class="pill">{n.tag}</span><b>{n.title}</b><span>{n.text}</span></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Enquire -->
  <section id="enquire" class="bg-sand lift">
    <div class="wrap sec split" style="align-items:flex-start">
      <div>
        <span class="eyebrow">Start a conversation</span>
        <h2>Ready to <span class="mk">do the work</span>?</h2>
        <p class="lead">The first call is a no-commitment chat about where you are and whether coaching is the right fit. That’s it.</p>
        <div class="eq">
          <div class="feat"><span class="ico"><Icon name="target" /></span><div><h3>Starts with your score</h3><p class="body">Your Fulfilment Score across the Five Pillars is the baseline.</p></div></div>
          <div class="feat"><span class="ico"><Icon name="calendar" /></span><div><h3>Regular sessions</h3><p class="body">60–90 minutes each, usually over three to six months.</p></div></div>
          <div class="feat"><span class="ico"><Icon name="lock" /></span><div><h3>Fully private</h3><p class="body">Nothing is reported back to your organisation.</p></div></div>
        </div>
        <p class="body" style="margin-top:30px">Not sure yet? A <a class="link" style="margin-top:0" href="/what-we-do/masterclass">Masterclass</a> lets your leadership team experience the framework first.</p>
      </div>
      <form class="card form" name="coaching-enquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks" data-rv>
        <input type="hidden" name="form-name" value="coaching-enquiry" />
        <input type="hidden" name="interest" value="Leadership Coaching" />
        <p hidden><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <h3>Enquire about coaching</h3>
        <p class="body" style="margin-top:8px">We’ll reply within one business day.</p>
        <div class="fields" style="margin-top:24px">
          <label class="field"><span>Your name</span><input type="text" name="name" autocomplete="name" maxlength="100" required /></label>
          <label class="field"><span>Work email</span><input type="email" name="email" autocomplete="email" maxlength="255" required /></label>
          <label class="field"><span>Company</span><input type="text" name="company" autocomplete="organization" maxlength="150" required /></label>
          <label class="field"><span>Phone (optional)</span><input type="tel" name="phone" autocomplete="tel" maxlength="30" /></label>
          <label class="field wide"><span>Where are you right now? (optional)</span><textarea name="message" rows="4" maxlength="1000" placeholder="Your role, your team, what’s on your mind. Whatever helps."></textarea></label>
        </div>
        <div class="btns" style="margin-top:24px"><button class="btn btn-lime" type="submit">Send enquiry</button></div>
        <p class="small" style="margin-top:16px">One business day reply · No sales pressure · Private and secure</p>
      </form>
    </div>
  </section>
</Base>

<script is:inline>(() => {
  // "Sound familiar?": count what people tick. Nothing is sent anywhere.
  document.querySelectorAll('[data-sf]').forEach(root => {
    const boxes = [...root.querySelectorAll('input[type=checkbox]')];
    const n = root.querySelector('[data-sf-n]');
    const upd = () => { const k = boxes.filter(b => b.checked).length; n.textContent = k; n.parentElement.hidden = !k; root.classList.toggle('sf-on', k > 0); };
    boxes.forEach(b => b.addEventListener('change', upd));
  });
})();</script>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
