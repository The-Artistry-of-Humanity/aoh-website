---
/* nørma on the AOH site: a product reveal that hands over to joinnorma.com,
   which tells the full story. Copy follows joinnorma.com where the old page
   differed (for example, groups of five or more, not ten). */
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { PILLARS } from '../../data/aoh';

// The monthly loop, from the "why we built it" copy.
const LOOP = [
  { icon: 'pen', title: 'Check in', text: 'Once a month, a short check-in for each person, across all five pillars.' },
  { icon: 'eye', title: 'See what’s going on', text: 'Leaders get a clear picture of every team, as group figures.' },
  { icon: 'talk', title: 'Act on it', text: 'A session to run with the team when something needs attention.' },
  { icon: 'climb', title: 'See if it moved', text: 'Next month shows whether it moved.' },
] as const;
const LP = { cx: 180, cy: 180, r: 128 };
const at = (deg: number, r = LP.r) => [LP.cx + r * Math.cos((deg * Math.PI) / 180), LP.cy + r * Math.sin((deg * Math.PI) / 180)];
const loopNodes = [-90, 0, 90, 180].map(d => at(d));
// Chevrons on the track between nodes, pointing clockwise.
const chevrons = [-45, 45, 135, 225].map(d => {
  const [x, y] = at(d);
  const t = (d * Math.PI) / 180;
  const [tx, ty] = [-Math.sin(t), Math.cos(t)]; // clockwise tangent
  const [nx, ny] = [Math.cos(t), Math.sin(t)]; // outward normal
  const tip = [x + tx * 5, y + ty * 5];
  const a = [x - tx * 4 + nx * 6, y - ty * 4 + ny * 6];
  const b = [x - tx * 4 - nx * 6, y - ty * 4 - ny * 6];
  return `M${a[0].toFixed(1)} ${a[1].toFixed(1)} L${tip[0].toFixed(1)} ${tip[1].toFixed(1)} L${b[0].toFixed(1)} ${b[1].toFixed(1)}`;
});

// Wellbeing at scale: who each way of working reaches. A field of people,
// lit where the work reaches them.
const FIELD = Array.from({ length: 40 }, (_, k) => [k % 8, Math.floor(k / 8)] as const);
const REACH = [
  { icon: 'talk', name: 'Leadership coaching', reach: 'One leader at a time', label: 'Leadership coaching reaches one leader at a time', lit: (c: number, r: number) => c === 3 && r === 2 },
  { icon: 'board', name: 'Masterclass and Accelerator', reach: 'One team at a time', label: 'A Masterclass or the Wellness Accelerator reaches one team at a time', lit: (c: number, r: number) => c >= 2 && c <= 4 && r >= 1 && r <= 3 },
  { icon: 'mic', name: 'Keynotes and workshops', reach: 'One room, on one day', label: 'A keynote or workshop reaches one room, on one day', lit: (c: number, r: number) => c <= 5 && r <= 3 },
  { icon: 'norma', name: 'nørma', reach: 'Every person, every team, every month', label: 'nørma reaches every person and every team, every month', lit: () => true, norma: true },
] as const;

const CULTURE = ['Heard', 'Valued', 'Safe to speak'];
const PRIVATE = ['Check-in answers', 'Reflections', 'Recordings'];

const MORE = [
  { href: 'https://joinnorma.com/your-people/', icon: 'person', title: 'The app', text: 'What your people see, and how nørma helps them work on the gaps.', cta: 'See the app' },
  { href: 'https://joinnorma.com/for-leaders/', icon: 'chart', title: 'The dashboard', text: 'The nørma Score for every group, and where to look first.', cta: 'See the dashboard' },
  { href: 'https://joinnorma.com/roi/', icon: 'target', title: 'Your ROI', text: 'Work out what nørma could return for your organisation.', cta: 'Work out your ROI' },
  { href: 'https://joinnorma.com/book-a-demo/', icon: 'calendar', title: 'Book a demo', text: 'See the app and the dashboard for yourself.', cta: 'Book a demo' },
] as const;
---
<Base title="nørma · Wellbeing at scale from The Artistry of Humanity" description="nørma is wellbeing at scale from The Artistry of Humanity: an app for your people and a dashboard for leaders, for every person and every team, every month. Built on the Five Pillars of Fulfilment. Leaders see groups of five or more, never individuals." path="/what-we-do/norma">

  <!-- The reveal -->
  <section class="bg-dark n-hero" style="overflow:hidden">
    <div class="glow" style="left:50%;top:-30%;width:90%;transform:translateX(-50%);background:radial-gradient(closest-side,rgba(217,234,110,.16),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap center" style="position:relative;padding-top:clamp(48px,7vw,96px);padding-bottom:clamp(110px,12vw,170px)">
      <img class="n-icon" src="/assets/norma-app-icon.png" alt="" width="224" height="224" />
      <span class="eyebrow" style="margin-top:26px">New from The Artistry of Humanity</span>
      <h1 style="color:var(--on-dark);max-width:15em;margin-left:auto;margin-right:auto">Meet <span class="it">nørma</span>: wellbeing <span class="mk mk-d">at scale</span>.</h1>
      <p class="lead" style="margin-left:auto;margin-right:auto">Every person and every team, every month. An app for your people and a dashboard for you, built on the Five Pillars of Fulfilment. They see where their life is at. You see where your culture is at, and what to do about it.</p>
      <div class="btns">
        <a class="btn btn-lime" href="https://joinnorma.com/">Explore nørma ↗</a>
        <a class="btn btn-ghost" href="https://joinnorma.com/book-a-demo/">Book a demo ↗</a>
      </div>

      <figure class="rv">
        <div class="rv-dash">
          <div class="rv-bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <img src="/assets/dash-hero.webp" alt="The nørma leader dashboard: nørma Score, Fulfilment, Culture and every department" width="1120" height="816" />
        </div>
        <div class="rv-phone"><div><img src="/assets/app-where-you-stand.webp" alt="The nørma app after a monthly check-in: where you stand across the Five Pillars" width="780" height="1688" /></div></div>
        <figcaption class="rv-tag rv-tag-p"><Icon name="person" size={18} /><span><b>Your people</b> where their life is at</span></figcaption>
        <span class="rv-tag rv-tag-l" aria-hidden="true"><Icon name="chart" size={18} /><span><b>Leaders</b> where the culture is at</span></span>
      </figure>
    </div>
  </section>

  <!-- Wellbeing at scale: who each kind of work reaches -->
  <section class="lift" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div>
          <span class="eyebrow">Why we built it</span>
          <h2>Our work in the room reaches one team at a time. <span class="mk">nørma reaches everyone.</span></h2>
        </div>
        <p class="lead" style="margin-top:0">In our keynotes and workshops, people get honest about where their life is at, and leaders hear what is really going on. But a session is one room, on one day. nørma keeps that work going for every person and every team, every month.</p>
      </div>
      <div class="reach">
        {REACH.map(r => (
          <figure class:list={['reach-c', r.norma ? 'card-dark' : 'card']} data-rv>
            <svg viewBox="0 0 168 108" role="img" aria-label={r.label}>
              {FIELD.map(([c, rw], k) => {
                const lit = r.lit(c, rw);
                return <circle class:list={[{ lit }]} style={r.norma ? `--d:${((c + rw) * 0.12).toFixed(2)}s` : undefined} cx={10 + c * 21} cy={10 + rw * 22} r="5.5" />;
              })}
            </svg>
            <figcaption>
              <span class="reach-k">{r.norma ? <img src="/assets/norma-app-icon.png" alt="" width="28" height="28" /> : <Icon name={r.icon} size={18} />}{r.name}</span>
              <b>{r.reach}</b>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- The two sides -->
  <section class="bg-sand lift-b">
    <div class="wrap sec">
      <div class="narrow center">
        <span class="eyebrow">One system, both sides</span>
        <h2>The problem has two sides. <span class="mk">So does nørma.</span></h2>
      </div>
      <div class="sides" data-tabs style="margin-top:clamp(36px,4vw,52px)">
        <div class="seg" role="tablist" aria-label="Choose a side">
          <button type="button" class="seg-b" role="tab" id="sd-t0" aria-controls="sd-p0"><span class="seg-i"><Icon name="person" size={22} /></span><span><b>Your people</b><small>Their side: personal fulfilment</small></span></button>
          <button type="button" class="seg-b" role="tab" id="sd-t1" aria-controls="sd-p1"><span class="seg-i"><Icon name="chart" size={22} /></span><span><b>Leaders</b><small>Your side: workplace culture</small></span></button>
        </div>
        <div class="side" role="tabpanel" id="sd-p0" aria-labelledby="sd-t0">
          <figure class="sd-phones">
            <div class="sd-ph sd-ph-back"><img src="/assets/norma-app-home.webp" alt="" width="780" height="1688" loading="lazy" /></div>
            <div class="sd-ph sd-ph-front"><div><img src="/assets/app-where-you-stand.webp" alt="The nørma app after a monthly check-in, showing a score across the Five Pillars" width="780" height="1688" loading="lazy" /></div></div>
          </figure>
          <div class="sd-copy">
            <span class="eyebrow">Your people</span>
            <h3>Their life comes to work with them.</h3>
            <p class="body">Work is one pillar of five. Once a month, a short check-in shows each person where they are across all five and where the gaps are, and nørma helps them work on them.</p>
            <ul class="chips">{PILLARS.map(p => <li><span style={`background:${p.tint}`}><Icon paths={p.paths} size={18} stroke="#14231A" /></span>{p.name}</li>)}</ul>
            <p class="sd-own"><Icon name="lock" size={18} />It’s theirs. Nobody at work can read it.</p>
            <a class="link" href="https://joinnorma.com/your-people/">See the app ↗</a>
          </div>
        </div>
        <div class="side" role="tabpanel" id="sd-p1" aria-labelledby="sd-t1">
          <figure class="sd-dash">
            <div class="rv-bar" aria-hidden="true"><i></i><i></i><i></i></div>
            <img src="/assets/dash-hero.webp" alt="The nørma leader dashboard: nørma Score, Fulfilment, Culture and every department" width="1120" height="816" loading="lazy" />
          </figure>
          <div class="sd-copy">
            <span class="eyebrow">Leaders</span>
            <h3>The culture they walk into is yours to shape.</h3>
            <p class="body">You see both sides as group figures: how fulfilled your people are, and whether they feel heard, valued and safe to speak. So you know where to look first and what to do.</p>
            <ul class="chips chips-c">{CULTURE.map(c => <li><span><Icon name="check" size={16} stroke="#14231A" width={2} /></span>{c}</li>)}</ul>
            <a class="link" href="https://joinnorma.com/for-leaders/">See the dashboard ↗</a>
          </div>
        </div>
      </div>
      <p class="eq-lead">They meet in one number for each group.</p>
      <div class="eq" data-rv>
        <div class="eq-t">
          <span class="eq-ico eq-pg" aria-hidden="true">{PILLARS.map(p => <i style={`background:${p.tint}`}></i>)}</span>
          <span><b>Fulfilment</b>their side</span>
        </div>
        <span class="eq-op" aria-hidden="true">+</span>
        <div class="eq-t">
          <span class="eq-ico eq-cu" aria-hidden="true"><i></i><i></i><i></i></span>
          <span><b>Culture</b>your side</span>
        </div>
        <span class="eq-op" aria-hidden="true">=</span>
        <div class="eq-t eq-score">
          <img src="/assets/norma-app-icon.png" alt="" width="44" height="44" />
          <span><b>The nørma Score</b>one number for each group</span>
        </div>
      </div>
    </div>
  </section>

  <!-- The monthly loop -->
  <section class="bg-dark lift">
    <div class="glow" style="right:-14%;top:-10%;width:55%;background:radial-gradient(closest-side,rgba(217,234,110,.1),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap sec">
      <div class="split loop">
        <figure class="lp" data-rv>
          <svg viewBox="0 0 360 360" role="img" aria-label="The nørma loop, every month: check in, see what’s going on, act on it, see if it moved, then check in again">
            <circle cx={LP.cx} cy={LP.cy} r={LP.r} fill="none" stroke="rgba(217,234,110,.28)" stroke-width="2" stroke-dasharray="4 7" />
            {chevrons.map(d => <path d={d} fill="none" stroke="#D9EA6E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />)}
            <g class="lp-orbit"><circle cx={LP.cx} cy={LP.cy - LP.r} r="5" fill="#EAF79B" /></g>
            <text x={LP.cx} y={LP.cy - 4} text-anchor="middle" font-family="'DM Serif Display', Georgia, serif" font-size="30" fill="#F6F4E9">Every month</text>
            <text x={LP.cx} y={LP.cy + 20} text-anchor="middle" font-family="'DM Sans', system-ui, sans-serif" font-size="10.5" font-weight="600" letter-spacing="2.2" fill="#DCEC85">FOR EVERY TEAM</text>
            {loopNodes.map(([x, y], i) => (
              <g>
                <circle cx={x} cy={y} r="32" fill="#16291C" stroke="#D9EA6E" stroke-width="1.5" />
                <circle cx={x + 22} cy={y - 22} r="11" fill="#D9EA6E" />
                <text x={x + 22} y={y - 18} text-anchor="middle" font-family="'DM Sans', system-ui, sans-serif" font-size="11" font-weight="600" fill="#152213">{i + 1}</text>
              </g>
            ))}
          </svg>
          {loopNodes.map(([x, y], i) => <span class="lp-i" style={`left:${(x / 3.6).toFixed(2)}%;top:${(y / 3.6).toFixed(2)}%`} aria-hidden="true"><Icon name={LOOP[i].icon} size={24} /></span>)}
        </figure>
        <div>
          <span class="eyebrow">How it works</span>
          <h2>One loop, <span class="mk mk-d">every month</span>.</h2>
          <p class="lead">nørma keeps the work going for every team, long after the room has emptied.</p>
          <ol class="lp-steps">
            {LOOP.map(l => <li><h3>{l.title}</h3><p class="body">{l.text}</p></li>)}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Privacy -->
  <section class="lift-b" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="split" style="align-items:center">
        <div style="flex:1 1 380px">
          <span class="eyebrow">Privacy</span>
          <h2>Leaders see patterns, <span class="mk">never people</span>.</h2>
          <p class="lead">Answers become a group figure before anything reaches a dashboard, and groups below five never appear. A design decision, not a setting.</p>
          <div class="pv-own">
            <span class="small">Nobody where someone works can read their</span>
            <ul>{PRIVATE.map(x => <li><Icon name="lock" size={16} />{x}</li>)}</ul>
          </div>
        </div>
        <figure class="card-dark pv" data-rv>
          <div class="pv-row">
            <div class="pv-ppl" aria-hidden="true">{Array.from({ length: 7 }, () => <span><Icon name="person" size={18} /></span>)}</div>
            <span class="pv-arrow" aria-hidden="true"><Icon name="arrow" size={20} /></span>
            <div class="pv-out pv-yes">
              <span class="pv-five">5+</span>
              <span><b>Shown as a group figure</b>A group of five or more people</span>
            </div>
          </div>
          <div class="pv-row pv-no">
            <div class="pv-ppl" aria-hidden="true">{Array.from({ length: 3 }, () => <span><Icon name="person" size={18} /></span>)}</div>
            <span class="pv-arrow" aria-hidden="true"><Icon name="arrow" size={20} /></span>
            <div class="pv-out pv-hide">
              <span class="pv-five pv-x"><Icon name="eye" size={20} /></span>
              <span><b>Never appears</b>A group of fewer than five</span>
            </div>
          </div>
          <figcaption class="small" style="color:var(--on-dark-muted);margin-top:22px">Leaders see groups of five or more, never individuals.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Hand over to joinnorma.com -->
  <section class="bg-sand lift">
    <div class="wrap sec">
      <div class="card-dark hand">
        <img class="hand-m" src="/assets/norma-happy.png" alt="" width="253" height="340" loading="lazy" />
        <div class="hand-copy">
          <span class="eyebrow">joinnorma.com</span>
          <h2>The full story is at <span class="mk mk-d">joinnorma.com</span>.</h2>
          <p class="lead">See how the app and the dashboard work, book a demo, or work out what nørma could return for your organisation.</p>
          <div class="btns">
            <a class="btn btn-lime" href="https://joinnorma.com/">Explore nørma ↗</a>
            <a class="btn btn-ghost" href="https://joinnorma.com/book-a-demo/">Book a demo ↗</a>
          </div>
        </div>
      </div>
      <div class="more">
        {MORE.map(m => (
          <a class="card" href={m.href} data-rv>
            <span class="ico"><Icon name={m.icon} size={22} /></span>
            <h3>{m.title}</h3>
            <p class="body">{m.text}</p>
            <span class="link">{m.cta} ↗</span>
          </a>
        ))}
      </div>
      <p class="body center" style="margin-top:36px">Rather start in the room? <a class="link" style="margin:0" href="/what-we-do/keynotes-workshops">Book Ian to speak ›</a></p>
    </div>
  </section>
</Base>

<style>
  /* aoh.css: .sec resets the side padding that .wrap gives; keep the gutters. */
  .wrap.sec{padding-left:var(--gut);padding-right:var(--gut)}
  :global(.nav a.norma[aria-current]){padding:0 12px 0 6px;border-bottom:0;color:var(--on-dark)}
  .n-icon{display:block;width:88px;height:88px;margin:0 auto;border-radius:24px;box-shadow:0 24px 50px -18px rgba(0,0,0,.6)}

  /* The reveal: the dashboard rises, the app slides in front of it. */
  .rv{position:relative;max-width:980px;margin:clamp(56px,7vw,88px) auto 0;padding:0 0 0 6%}
  .rv-dash{position:relative;z-index:0;border-radius:20px 16px 22px 14px / 16px 22px 14px 20px;overflow:hidden;background:#F6F5EE;box-shadow:0 60px 120px -40px rgba(0,0,0,.8),0 0 0 1px rgba(228,240,214,.14)}
  .rv-bar,.sd-dash .rv-bar{display:flex;gap:6px;padding:11px 14px;background:#E9E7DA}
  .rv-bar i{width:9px;height:9px;border-radius:50%;background:rgba(20,35,26,.18)}
  .rv-dash img{width:100%}
  .rv-phone{position:absolute;z-index:1;left:0;bottom:-9%;width:25%;padding:6px;border-radius:32px;background:#0B140E;box-shadow:0 40px 70px -20px rgba(0,0,0,.8),0 0 0 1px rgba(228,240,214,.12)}
  .rv-phone div{border-radius:26px;overflow:hidden;aspect-ratio:390/800}
  .rv-phone img{width:100%;height:100%;object-fit:cover;object-position:top}
  .rv-tag{position:absolute;z-index:2;display:inline-flex;align-items:center;gap:10px;padding:9px 16px 9px 10px;border-radius:999px;background:rgba(11,24,16,.9);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:inset 0 0 0 1px rgba(217,234,110,.3),0 20px 40px -16px rgba(0,0,0,.7);font:400 14px/1.3 var(--sans);color:var(--on-dark-muted);text-align:left;white-space:nowrap}
  .rv-tag :global(svg){flex:none;box-sizing:content-box;padding:6px;border-radius:50%;background:var(--lime);color:#152213}
  .rv-tag b{font-weight:600;color:var(--on-dark);margin-right:4px}
  .rv-tag-p{left:-3%;top:27%}
  .rv-tag-l{right:-3%;top:-4%}
  @media (prefers-reduced-motion:no-preference){
    .rv-dash{animation:rise 1.1s var(--ease) .1s both}
    .rv-phone{animation:slide 1s var(--ease) .4s both}
    .rv-tag-p{animation:fade .6s ease .85s both}
    .rv-tag-l{animation:fade .6s ease 1s both}
  }
  @keyframes rise{from{opacity:0;transform:perspective(1400px) translateY(60px) rotateX(14deg)}to{opacity:1;transform:none}}
  @keyframes slide{from{opacity:0;transform:translate(-30px,40px)}to{opacity:1;transform:none}}
  @keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  @media (max-width:760px){
    .rv{padding:0 0 0 14%}
    .rv-phone{width:36%;bottom:-16%;padding:4px;border-radius:22px}
    .rv-phone div{border-radius:18px}
    .rv-tag{font-size:12.5px;padding:7px 12px 7px 8px}
    .rv-tag-p{left:auto;right:0;top:auto;bottom:-24%}
    .rv-tag-l{display:none}
    .n-hero .wrap{padding-bottom:clamp(150px,30vw,190px)!important}
  }

  /* Wellbeing at scale */
  .reach{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(14px,2vw,24px);margin-top:clamp(40px,5vw,64px)}
  @media (max-width:980px){.reach{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:520px){.reach{gap:12px}.reach-c{gap:14px;padding:16px}.reach-c b{font-size:18px}.reach-k{font-size:9.5px;letter-spacing:1.2px;align-items:flex-start}.reach-k :global(svg){display:none}}
  .reach-c{margin:0;display:flex;flex-direction:column;gap:20px;padding:clamp(22px,2.4vw,30px)}
  .reach-c svg{display:block;width:100%;height:auto}
  .reach-c circle{fill:none;stroke:rgba(20,35,26,.16);stroke-width:1.2}
  .reach-c circle.lit{fill:#D9EA6E;stroke:#4A6B3A;stroke-width:1.4}
  .reach-c.card-dark circle.lit{fill:#D9EA6E;stroke:none}
  .reach-c figcaption{display:flex;flex-direction:column;gap:6px;margin-top:auto}
  .reach-k{display:flex;align-items:center;gap:8px;font:600 11px var(--sans);letter-spacing:1.6px;text-transform:uppercase;color:var(--olive)}
  .reach-k img{width:28px;height:28px;border-radius:9px}
  .card-dark .reach-k{color:#DCEC85}
  .reach-c b{font:400 clamp(21px,1.9vw,25px)/1.2 var(--serif);color:var(--ink)}
  .card-dark.reach-c b{color:var(--on-dark)}
  @media (prefers-reduced-motion:no-preference){.reach-c.card-dark circle.lit{animation:month 4s ease-in-out var(--d) infinite}}
  @keyframes month{0%,70%,100%{opacity:1}35%{opacity:.45}}
  :global(.js) .reach-c:not(.on) circle.lit{fill-opacity:0}
  .reach-c circle.lit{transition:fill-opacity .6s ease .3s}

  /* The two sides: a toggle. */
  .seg{display:flex;justify-content:center;gap:8px;max-width:620px;margin:0 auto;padding:6px;border-radius:999px;background:rgba(20,35,26,.07)}
  .seg-b{flex:1 1 0;display:flex;align-items:center;gap:12px;min-width:0;padding:10px 18px 10px 10px;border:0;border-radius:999px;background:transparent;text-align:left;font:inherit;color:var(--ink);cursor:pointer;transition:background .25s ease,color .25s ease,box-shadow .25s ease}
  .seg-b b{display:block;font:600 16px/1.25 var(--sans)}
  .seg-b small{display:block;font-size:13px;line-height:1.3;color:var(--muted-2)}
