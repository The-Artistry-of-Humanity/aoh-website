---
import Base from '../../layouts/Base.astro';

// The free Masterclass: a tailored 60–90 minute diagnostic session for a
// leadership team. Copy from the previous site's Masterclass page; the booking
// form keeps the old contact form's fields (name, work email, company, phone,
// interest, message), with the interest fixed to the Masterclass.

const ROOM = [
  ['Context and the real picture', 'We open by naming what’s actually happening, in the wider world of work and in your organisation specifically: the pace of change, the pressure on people, the gap between what wellbeing programs promise and what they deliver. It’s a candid conversation, not a slide deck.'],
  ['The Five Pillars of Fulfilment', 'A clear, grounded introduction to the framework: what the five dimensions are, why they were chosen and how they work as a system. People stop hearing about wellbeing in the abstract and start seeing it in their own lives.'],
  ['The Fulfilment Score', 'Each participant completes a short self-assessment, five questions per pillar. The room gets a real picture of where energy is strong and where it’s quietly depleted. This is often the moment the session shifts, when people recognise themselves in the data.'],
  ['The culture conversation', 'With a shared framework and a common language, the leadership team talks honestly about how the organisation is really doing. Not what the last survey suggested: what’s going on, and what it’s costing.'],
  ['What comes next', 'We close with what the team’s results suggest, the options for going deeper and what a realistic next step looks like for your organisation. No pressure, just an honest conversation about where to go from here.'],
];

const WHO = [
  ['HR and People & Culture leaders', 'You know the team needs something, but you want to experience the approach before committing to a full program. The Masterclass gives you direct exposure to the framework, so you can make the case internally with confidence.'],
  ['Executive and senior leadership teams', 'You want your leaders aligned on what culture and wellbeing actually mean in your organisation, beyond policy and beyond the next engagement survey. One session gives them a shared starting point.'],
  ['Organisations facing psychosocial safety obligations', 'New legislation across Australia, and increasingly elsewhere, is raising the bar on what organisations must show about employee wellbeing. The Masterclass is the fastest way to see whether the Five Pillars are the right tool for what you now need to build.'],
];

const STEPS = [
  ['Tell us about your organisation', 'Fill in the short form with a brief sense of where your team is right now. It takes two minutes, and we’ll come back to you within one business day.'],
  ['A quick 15-minute call', 'We get to know each other, understand your context and agree on what would be most valuable for your team. This is where the session is shaped around you, not delivered off a template.'],
  ['Your Masterclass', 'Ian runs a 60–90 minute session with your leadership team, at your office or virtually, wherever you are in the world.'],
];
---
<Base title="Free Masterclass for leadership teams · The Artistry of Humanity" description="A free, tailored 60–90 minute session with Ian Williams for your leadership team. See where your culture stands across the Five Pillars of Fulfilment, and what to do about it. In person or virtual." path="/what-we-do/masterclass">

  <!-- Hero -->
  <section class="bg-dark" style="overflow:hidden">
    <div class="glow" style="right:-18%;top:-30%;width:70%;background:radial-gradient(closest-side,rgba(217,234,110,.14),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap split" style="padding-top:clamp(48px,7vw,96px);padding-bottom:clamp(120px,14vw,190px)">
      <div style="max-width:610px">
        <span class="eyebrow">Masterclass</span>
        <h1 style="color:var(--on-dark)">A session that shows you exactly where your culture stands, and <span class="mk mk-d">what to do about it</span>.</h1>
        <p class="lead">Ian Williams comes to your leadership team, in person or virtually, for a 60–90 minute session grounded in the Five Pillars of Fulfilment. Tailored to your organisation, and free of any commitment.</p>
        <div class="tags">
          <span class="pill">Free</span><span class="pill">60–90 minutes</span><span class="pill">In person or virtual</span>
        </div>
        <div class="btns">
          <a class="btn btn-lime" href="#book">Book a Masterclass</a>
          <a class="btn btn-ghost" href="#room">See how it works</a>
        </div>
      </div>
      <figure style="margin:0;flex:0 1 440px">
        <div class="arch" style="aspect-ratio:440/520;box-shadow:0 50px 90px -40px rgba(0,0,0,.7)"><img src="/assets/ian-presenting.jpg" alt="Ian Williams facilitating a session with a leadership team" width="1024" height="683" style="width:100%;height:100%;object-fit:cover;object-position:52% 40%" /></div>
      </figure>
    </div>
  </section>

  <!-- Why it is different, and what the team leaves with -->
  <section class="lift" style="background:var(--cream)">
    <div class="wrap sec split" style="align-items:flex-start">
      <div>
        <span class="eyebrow">Why it’s different</span>
        <h2>Not a presentation. <span class="mk">A diagnosis.</span></h2>
        <p class="lead">Most leadership teams have sat through enough wellbeing presentations to last a lifetime. A speaker arrives, shares the research, offers a framework and leaves. People feel engaged for a day. Then Monday happens.</p>
        <p class="body">The Masterclass is a working session, facilitated by Ian directly, where your leadership team experiences the Five Pillars of Fulfilment first-hand. Not as an abstract concept, but as a lens they apply to themselves and to your organisation in real time.</p>
        <p class="body">Every session is shaped around what you’re dealing with right now. The conversation beforehand is where Ian learns your context, your team and what would be most valuable to focus on.</p>
        <a class="link" href="/framework">The Five Pillars framework in full ›</a>
      </div>
      <div class="card" data-rv>
        <span class="eyebrow">What your team leaves with</span>
        <ul class="list" style="margin-top:18px">
          <li>A shared language for conversations that often don’t have one</li>
          <li>A clearer picture of where the culture is strong, and where it’s quietly under strain</li>
          <li>Each person’s own Fulfilment Score across the Five Pillars</li>
          <li>A sense of what a realistic next step looks like</li>
        </ul>
        <p class="quote" style="margin-top:28px;font-size:clamp(20px,1.9vw,24px)">“The best way to understand what the Five Pillars can do for your culture is to experience it.”</p>
        <p class="small" style="margin-top:18px">No commitment required. The only thing we ask in return is honest feedback after the session.</p>
      </div>
    </div>
  </section>

  <!-- What happens in the room -->
  <section id="room" class="bg-dark lift-b">
    <div class="glow" style="left:-16%;bottom:-20%;width:56%;background:radial-gradient(closest-side,rgba(217,234,110,.1),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap sec">
      <div class="split" style="align-items:flex-start">
        <div class="room-side">
          <span class="eyebrow">Inside the session</span>
          <h2>What happens <span class="mk mk-d">in the room</span>.</h2>
          <p class="lead">Every session is tailored to the organisation. The structure that makes it valuable stays the same.</p>
          <div class="photo" data-rv style="margin-top:36px;aspect-ratio:4/3"><img src="/assets/workshop.jpg" alt="A leadership group in a Masterclass session with Ian" width="1024" height="683" loading="lazy" /></div>
          <p class="small" style="margin-top:20px;color:var(--on-dark-muted)">Sessions run 60–90 minutes, facilitated by Ian Williams. In person or virtual, across Australia and internationally.</p>
        </div>
        <ol class="steps">
          {ROOM.map(([t, d], i) => (
            <li data-rv><span class="num">0{i + 1}</span><div><h3>{t}</h3><p class="body">{d}</p></div></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Who it is for -->
  <section class="bg-sand lift">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">Who it’s for</span><h2>Who gets the most from a <span class="mk">Masterclass</span>.</h2></div>
        <p class="lead" style="margin-top:0">It suits teams who want to experience the approach before committing to anything bigger, and leaders who need a shared starting point fast.</p>
      </div>
      <div class="grid g3" style="margin-top:clamp(44px,5vw,64px)">
        {WHO.map(([t, d]) => (
          <div class="card" data-rv><h3>{t}</h3><p class="body">{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Where organisations go from here -->
  <section class="lift-b" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">After the Masterclass</span><h2>Where organisations <span class="mk">go from here</span>.</h2></div>
        <p class="lead" style="margin-top:0">The Masterclass opens the conversation. For most teams it leads somewhere deeper.</p>
      </div>
      <div class="grid g2x2" style="margin-top:clamp(44px,5vw,64px)">
        <a class="card-dark" href="/what-we-do/wellness-accelerator" data-rv><span class="pill">Most common next step</span><h3 style="margin-top:16px">The Wellness Accelerator</h3><p class="body">The six-week program that takes the framework from introduction to everyday practice, one pillar a week, with your leadership team.</p><span class="link">See the program ›</span></a>
        <a class="card" href="/what-we-do/leadership-coaching" data-rv><span class="pill">1:1</span><h3 style="margin-top:16px">Leadership coaching</h3><p class="body">For individual leaders who want to go deeper on their own development, and model what they’re asking of their teams.</p><span class="link">About coaching ›</span></a>
        <a class="card" href="/what-we-do/keynotes-workshops" data-rv><span class="pill">Keynotes</span><h3 style="margin-top:16px">Bring the whole organisation in</h3><p class="body">Once the leaders have felt it, Ian can take the same conversation to everyone else: a keynote or workshop, in person or virtual.</p><span class="link">See the keynotes ›</span></a>
        <a class="card" href="/what-we-do/norma" data-rv><span class="pill">nørma</span><h3 style="margin-top:16px">Keep it going every month</h3><p class="body">nørma makes the Five Pillars a living system inside your organisation: an app for your people and a dashboard for you, so the picture from the room stays current.</p><span class="link">How nørma fits ›</span></a>
      </div>
    </div>
  </section>

  <!-- Book: three steps and the form -->
  <section id="book" class="bg-sand lift">
    <div class="wrap sec split" style="align-items:flex-start">
      <div>
        <span class="eyebrow">Book your Masterclass</span>
        <h2>Three steps. <span class="mk">No strings attached.</span></h2>
        <ol class="steps steps-light">
          {STEPS.map(([t, d], i) => (
            <li><span class="num">0{i + 1}</span><div><h3>{t}</h3><p class="body">{d}</p></div></li>
          ))}
        </ol>
        <p class="body">Rather talk first? <a class="link" style="margin-top:0" href="/contact">Book a call</a> or email <a class="link" style="margin-top:0" href="mailto:ian@artistry-of-humanity.com">ian@artistry-of-humanity.com</a>.</p>
      </div>
      <form class="card form" name="masterclass" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks" data-rv>
        <input type="hidden" name="form-name" value="masterclass" />
        <input type="hidden" name="interest" value="Free Masterclass" />
        <p hidden><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <h3>Tell us about your organisation</h3>
        <p class="body" style="margin-top:8px">Two minutes. We’ll reply within one business day.</p>
        <div class="fields" style="margin-top:24px">
          <label class="field"><span>Your name</span><input type="text" name="name" autocomplete="name" maxlength="100" required /></label>
          <label class="field"><span>Work email</span><input type="email" name="email" autocomplete="email" maxlength="255" required /></label>
          <label class="field"><span>Company</span><input type="text" name="company" autocomplete="organization" maxlength="150" required /></label>
          <label class="field"><span>Phone (optional)</span><input type="tel" name="phone" autocomplete="tel" maxlength="30" /></label>
          <label class="field wide"><span>Where is your team right now? (optional)</span><textarea name="message" rows="4" maxlength="1000" placeholder="A few lines is plenty. The more context, the better."></textarea></label>
        </div>
        <div class="btns" style="margin-top:24px"><button class="btn btn-lime" type="submit">Book a Masterclass</button></div>
        <p class="small" style="margin-top:16px">One business day reply · No sales pressure · Private and secure</p>
      </form>
    </div>
  </section>
</Base>

<style>
  /* .sec resets .wrap's side padding when both sit on one element; keep the gutter. */
  .wrap.sec{padding-left:var(--gut);padding-right:var(--gut)}
  .tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:26px}
  .room-side{flex:1 1 380px}
  .steps{flex:1.2 1 420px;list-style:none;margin:0;padding:0}
  .steps li{display:grid;grid-template-columns:52px minmax(0,1fr);gap:16px;padding:26px 0;border-top:1px solid var(--line-dark)}
  .steps li:first-child{border-top:0;padding-top:4px}
  .steps h3{font-size:clamp(22px,2vw,26px)}
  .steps .body{margin-top:8px}
  .num{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:16px 12px 16px 10px / 12px 16px 10px 16px;background:rgba(217,234,110,.14);color:#EAF79B;font:600 13px var(--sans);letter-spacing:.5px}
  .steps-light{margin:30px 0 22px}
  .steps-light li{border-color:var(--line);padding:20px 0}
  .steps-light li:first-child{padding-top:0}
  .steps-light .num{background:var(--dark);color:var(--lime)}
  .form{flex:1 1 400px}
  .form .wide{grid-column:1 / -1}
  .form textarea::placeholder{color:var(--muted-2)}
</style>
