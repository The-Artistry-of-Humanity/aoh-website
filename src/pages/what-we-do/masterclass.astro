---
/* The Masterclass: a tailored 60–90 minute working session for a leadership
   team. No longer free, and the price is not given on the site. Copy from the
   previous site's Masterclass page; the booking form keeps the old contact
   form's fields (name, work email, company, phone, interest, message). */
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { PILLARS } from '../../data/aoh';

/** The five parts of the session, in order. */
const ROOM = [
  { short: 'Context', title: 'Context and the real picture', icon: 'globe',
    text: 'We open by naming what’s actually happening, in the wider world of work and in your organisation: the pace of change, the pressure on people, the gap between what wellbeing programs promise and what they deliver.',
    line: 'A candid conversation, not a slide deck.' },
  { short: 'Five Pillars', title: 'The Five Pillars of Fulfilment', icon: 'pillars',
    text: 'A clear, grounded introduction to the framework: what the five dimensions are, why they were chosen and how they work as a system.',
    line: 'People stop hearing about wellbeing in the abstract and start seeing it in their own lives.' },
  { short: 'Your score', title: 'The Fulfilment Score', icon: 'score',
    text: 'Each participant completes a short self-assessment, five questions per pillar. The room gets a real picture of where energy is strong and where it’s quietly depleted.',
    line: 'Often the moment the session shifts, when people recognise themselves in the data.' },
  { short: 'Culture', title: 'The culture conversation', icon: 'talk',
    text: 'With a shared framework and a common language, the leadership team talks honestly about how the organisation is really doing. Not what the last survey suggested.',
    line: 'What’s really going on, and what it’s costing.' },
  { short: 'Next', title: 'What comes next', icon: 'arrow',
    text: 'We close with what the team’s results suggest, the options for going deeper and what a realistic next step looks like for your organisation.',
    line: 'No pressure. Just an honest conversation about where to go from here.' },
] as const;

const LEAVE = [
  { icon: 'talk', title: 'A shared language', text: 'For conversations that often don’t have one.' },
  { icon: 'search', title: 'A clearer picture', text: 'Of where the culture is strong, and where it’s quietly under strain.' },
  { icon: 'target', title: 'Everyone’s own score', text: 'Each person’s Fulfilment Score across the Five Pillars.' },
  { icon: 'arrow', title: 'A realistic next step', text: 'A sense of what to do next, for your organisation.' },
] as const;

const WHO = [
  { tab: 'HR and People & Culture', icon: 'users', title: 'HR and People & Culture leaders',
    text: 'You know the team needs something, but you want to experience the approach before committing to a full program. The Masterclass gives you direct exposure to the framework, so you can make the case internally with confidence, backed by your own experience of it.' },
  { tab: 'Executive teams', icon: 'board', title: 'Executive and senior leadership teams',
    text: 'You want your leaders aligned on what culture and wellbeing actually mean in your organisation, beyond policy and beyond the next engagement survey. One session gives them a shared starting point.' },
  { tab: 'Psychosocial safety', icon: 'shield', title: 'Organisations facing psychosocial safety obligations',
    text: 'New legislation across Australia, and increasingly elsewhere, is raising the bar on what organisations must show about employee wellbeing. The Masterclass is the fastest way to see whether the Five Pillars are the right tool for what you now need to build.' },
] as const;

const NEXT = [
  { href: '/what-we-do/wellness-accelerator', icon: 'climb', tag: 'Most common next step', title: 'The Wellness Accelerator', text: 'Six weeks with your leadership team, one pillar at a time, from introduction to everyday practice.', main: true },
  { href: '/what-we-do/leadership-coaching', icon: 'talk', tag: '1:1', title: 'Leadership coaching', text: 'For individual leaders who want to go deeper, and model what they ask of their teams.' },
  { href: '/what-we-do/keynotes-workshops', icon: 'mic', tag: 'Everyone', title: 'Keynotes & workshops', text: 'Once the leaders have felt it, Ian takes the same conversation to everyone else.' },
  { href: '/what-we-do/norma', icon: 'norma', tag: 'Wellbeing at scale', title: 'nørma', text: 'The room was your leaders. nørma reaches every person and every team, every month, so the picture stays current.' },
] as const;

const STEPS = [
  ['Tell us about your organisation', 'The short form below, with a brief sense of where your team is right now. Two minutes, and we reply within one business day.'],
  ['A quick 15-minute call', 'We get to know each other, understand your context and agree on what would be most valuable. This is where the session is shaped around you.'],
  ['Your Masterclass', 'Ian runs 60–90 minutes with your leadership team, at your office or virtually, wherever you are in the world.'],
];

const FAQ = [
  ['How long is a Masterclass?', '60 to 90 minutes, facilitated by Ian Williams.'],
  ['Can it run virtually?', 'Yes. Ian runs it at your office or virtually, wherever you are in the world, across Australia and internationally.'],
  ['Who should be in the room?', 'Your leadership team. It suits executive and senior leadership teams, and HR and People & Culture leaders who want to experience the approach before committing to a full program.'],
  ['How is it tailored to us?', 'The 15-minute call beforehand is where Ian learns your context, your team and what would be most valuable to focus on. The session is built around that, not delivered off a template. The structure that makes it valuable stays the same.'],
  ['What is the Fulfilment Score?', 'A short self-assessment each participant completes during the session: five questions for each of the Five Pillars. It shows where energy is strong and where it’s quietly depleted, for each person and for the room.'],
  ['What happens afterwards?', 'We close with what your team’s results suggest and the options for going deeper. For most teams the next step is the six-week Wellness Accelerator. There’s no pressure either way.'],
];

// Five dots per pillar: the five questions each pillar gets in the score.
const Q = [0, 1, 2, 3, 4];
---
<Base title="Masterclass for leadership teams · The Artistry of Humanity" description="A tailored 60–90 minute working session with Ian Williams for your leadership team. See where your culture stands across the Five Pillars of Fulfilment, and what to do about it. In person or virtual." path="/what-we-do/masterclass">

  <!-- Hero -->
  <section class="bg-dark" style="overflow:hidden">
    <div class="glow" style="right:-18%;top:-30%;width:70%;background:radial-gradient(closest-side,rgba(217,234,110,.14),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap split" style="padding-top:clamp(48px,7vw,96px);padding-bottom:clamp(120px,14vw,190px)">
      <div style="max-width:610px">
        <span class="eyebrow">Masterclass · For leadership teams</span>
        <h1 style="color:var(--on-dark)">A session that shows you where your culture stands, and <span class="mk mk-d">what to do about it</span>.</h1>
        <p class="lead">Ian Williams comes to your leadership team, in person or virtually, for a working session grounded in the Five Pillars of Fulfilment and shaped around your organisation.</p>
        <div class="tags">
          <span class="pill"><Icon name="clock" size={15} width={2} />60–90 minutes</span><span class="pill"><Icon name="tune" size={15} width={2} />Tailored to you</span><span class="pill"><Icon name="globe" size={15} width={2} />In person or virtual</span>
        </div>
        <div class="btns">
          <a class="btn btn-lime" href="#book">Book a Masterclass</a>
          <a class="btn btn-ghost" href="#room">What happens in the room</a>
        </div>
      </div>
      <figure class="hero-fig">
        <div class="arch" style="aspect-ratio:440/520;box-shadow:0 50px 90px -40px rgba(0,0,0,.7)"><img src="/assets/ian-presenting.jpg" alt="Ian Williams facilitating a session with a leadership team" width="1024" height="683" style="width:100%;height:100%;object-fit:cover;object-position:52% 40%" /></div>
        <a class="hero-bar" href="#room" data-rv>
          <span class="eyebrow">Inside the 60–90 minutes</span>
          <span class="hb-track" aria-hidden="true">{ROOM.map((r, i) => <i style={`--d:${(0.3 + i * 0.12).toFixed(2)}s`}><b>{i + 1}</b></i>)}</span>
          <span class="hb-k">{ROOM.map(r => r.short).join(' · ')}</span>
        </a>
      </figure>
    </div>
  </section>

  <!-- A presentation versus a diagnosis -->
  <section class="lift" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="narrow center">
        <span class="eyebrow">Why it’s different</span>
        <h2>Not a presentation. <span class="mk">A diagnosis.</span></h2>
        <p class="lead" style="margin-left:auto;margin-right:auto">Most leadership teams have sat through enough wellbeing presentations to last a lifetime. This is a working session, facilitated by Ian directly.</p>
      </div>
      <div class="vs" data-rv>
        <div class="vs-col vs-old">
          <span class="vs-k">The usual wellbeing presentation</span>
          <ol>
            <li>A speaker arrives</li>
            <li>Shares the research</li>
            <li>Offers a framework</li>
            <li>Leaves</li>
          </ol>
          <p class="vs-end">People feel engaged for a day. Then Monday happens.</p>
        </div>
        <div class="vs-mid" aria-hidden="true"><span>vs</span></div>
        <div class="vs-col vs-new">
          <span class="vs-k">The Masterclass</span>
          <ol>
            <li>Shaped around your context first</li>
            <li>Your leaders apply the Five Pillars to themselves</li>
            <li>Then to your organisation, in real time</li>
            <li>You leave with a realistic next step</li>
          </ol>
          <p class="vs-end">“The best way to understand what the Five Pillars can do for your culture is to <span class="mk">experience it</span>.”</p>
        </div>
      </div>

      <h3 class="leave-h">What your team leaves with</h3>
      <div class="leave">
        {LEAVE.map(l => (
          <div class="feat" data-rv><span class="ico"><Icon name={l.icon} /></span><div><h3>{l.title}</h3><p class="body">{l.text}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- What happens in the room: the session as a timeline -->
  <section id="room" class="bg-dark lift-b">
    <div class="glow" style="left:-16%;bottom:-20%;width:56%;background:radial-gradient(closest-side,rgba(217,234,110,.1),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap sec" style="position:relative">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">Inside the session</span><h2>What happens <span class="mk mk-d">in the room</span>.</h2></div>
        <p class="lead" style="margin-top:0">Every session is tailored to the organisation. The structure that makes it valuable stays the same: five parts, in order.</p>
      </div>

      <div class="rm" data-tabs data-auto="8000">
        <div class="rm-track" role="tablist" aria-label="The five parts of the session">
          {ROOM.map((r, i) => (
            <button type="button" class="rm-tab" role="tab" id={`rm-t${i}`} aria-controls={`rm-p${i}`}>
              <span class="rm-n">0{i + 1}</span><span class="rm-l">{r.short}</span>
              <i class="v-bar" aria-hidden="true"></i>
            </button>
          ))}
        </div>
        <div class="rm-ends" aria-hidden="true"><span>Start</span><span>60–90 minutes</span></div>
        <div class="rm-stage">
          {ROOM.map((r, i) => (
            <div class="rm-panel" role="tabpanel" id={`rm-p${i}`} aria-labelledby={`rm-t${i}`}>
              <div class="rm-vis" aria-hidden="true">
                {r.icon === 'pillars' ? (
                  <div class="rm-pl">{PILLARS.map(p => <span style={`background:${p.tint}`}><Icon paths={p.paths} size={24} stroke="#14231A" width={1.5} /></span>)}</div>
                ) : r.icon === 'score' ? (
                  <div class="rm-q">{PILLARS.map(p => (
                    <div><span style={`background:${p.tint}`}><Icon paths={p.paths} size={18} stroke="#14231A" width={1.6} /></span>{Q.map(() => <i style={`background:${p.tint}`}></i>)}</div>
                  ))}</div>
                ) : (
                  <span class="rm-ico"><Icon name={r.icon} size={44} width={1.4} /></span>
                )}
              </div>
              <div>
                <span class="eyebrow">Part {i + 1} of 5</span>
                <h3>{r.title}</h3>
                <p class="body">{r.text}</p>
                <p class="rm-line">{r.line}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="rm-foot">
        <div class="photo" data-rv><img src="/assets/workshop.jpg" alt="A leadership group in a session with Ian" width="1024" height="683" loading="lazy" /></div>
        <ul class="rm-facts">
          <li><Icon name="clock" size={22} /><span><b>60–90 minutes</b>One session, five parts</span></li>
          <li><Icon name="users" size={22} /><span><b>Facilitated by Ian Williams</b>With your leadership team</span></li>
          <li><Icon name="globe" size={22} /><span><b>In person or virtual</b>Across Australia and internationally</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Who it is for -->
  <section class="bg-sand lift">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">Who it’s for</span><h2>Who gets the most from a <span class="mk">Masterclass</span>.</h2></div>
        <p class="lead" style="margin-top:0">Teams who want to experience the approach before committing to anything bigger, and leaders who need a shared starting point fast.</p>
      </div>
      <div class="aud" data-tabs>
        <div class="tablist" role="tablist" aria-label="Who it’s for">
          {WHO.map((w, i) => (
            <button type="button" class="tab" role="tab" id={`who-t${i}`} aria-controls={`who-p${i}`}><Icon name={w.icon} size={18} />{w.tab}</button>
          ))}
        </div>
        <div class="who-stage">
          {WHO.map((w, i) => (
            <div class="who-panel" role="tabpanel" id={`who-p${i}`} aria-labelledby={`who-t${i}`}>
              <span class="ico"><Icon name={w.icon} size={30} /></span>
              <div><h3>{w.title}</h3><p>{w.text}</p></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Where organisations go from here: one session, four directions -->
  <section class="lift-b" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">After the Masterclass</span><h2>Where organisations <span class="mk">go from here</span>.</h2></div>
        <p class="lead" style="margin-top:0">The Masterclass opens the conversation. For most teams it leads somewhere deeper.</p>
      </div>
      <div class="br">
        <div class="br-origin" data-rv>
          <span class="ico"><Icon name="board" size={30} /></span>
          <b>Your Masterclass</b>
          <span>60–90 minutes with your leadership team</span>
        </div>
        <div class="br-list">
          {NEXT.map(n => (
            <a class:list={['br-item', { 'br-main': 'main' in n }]} href={n.href} data-rv>
              {n.icon === 'norma' ? <img src="/assets/norma-app-icon.png" alt="" width="44" height="44" class="br-nicon" /> : <span class="ico"><Icon name={n.icon} size={22} /></span>}
              <span class="br-txt"><span class="pill">{n.tag}</span><b>{n.title}</b><span>{n.text}</span></span>
              <span class="br-go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Book: three steps, questions, the form -->
  <section id="book" class="bg-sand lift">
    <div class="wrap sec">
      <span class="eyebrow">Book your Masterclass</span>
      <h2>Three steps to <span class="mk">the room</span>.</h2>
      <ol class="steps" style="--n:3;margin-top:clamp(40px,5vw,60px)">
        {STEPS.map(([t, d]) => <li data-rv><h3>{t}</h3><p class="body">{d}</p></li>)}
      </ol>
      <div class="bk">
        <div class="bk-faq">
          <h3>Questions people ask</h3>
          <div class="accs" style="margin-top:18px">
            {FAQ.map(([q, a]) => <details class="acc"><summary>{q}</summary><div class="acc-body"><p>{a}</p></div></details>)}
          </div>
          <p class="body" style="margin-top:26px">Rather talk first? <a class="link" style="margin-top:0" href="/contact">Book a call</a> or email <a class="link" style="margin-top:0" href="mailto:ian@artistry-of-humanity.com">ian@artistry-of-humanity.com</a>.</p>
        </div>
        <form class="card form" name="masterclass" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks" data-rv>
          <input type="hidden" name="form-name" value="masterclass" />
          <input type="hidden" name="interest" value="Masterclass" />
          <p hidden><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <h3>Tell us about your organisation</h3>
          <p class="body" style="margin-top:8px">Two minutes. We’ll reply within one business day.</p>
          <div class="fields" style="margin-top:24px">
            <label class="field"><span>Your name</span><input type="text" name="name" autocomplete="name" maxlength="100" required /></label>
            <label class="field"><span>Work email</span><input type="email" name="email" autocomplete="email" maxlength="255" required /></label>
            <label class="field"><span>Company</span><input type="text" name="company" autocomplete="organization" maxlength="150" required /></label>
            <label class="field"><span>Phone (optional)</span><input type="tel" name="phone" autocomplete="tel" maxlength="30" /></label>
            <label class="field wide"><span>Where is your team right now? (optional)</span><textarea name="message" rows="4" maxlength="1000" placeholder="A few lines is plenty. The more context, the better."></textarea></label>
          </div>
          <div class="btns" style="margin-top:24px"><button class="btn btn-lime" type="submit">Book a Masterclass</button></div>
          <p class="small" style="margin-top:16px">One business day reply · No sales pressure · Private and secure</p>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
  .tags .pill { gap: 7px; }

  /* Hero: the arch, with the session's five parts as a small bar. */
  .hero-fig { position: relative; margin: 0; flex: 0 1 440px; padding-bottom: 40px; }
  .hero-bar { position: absolute; left: -10%; right: 14%; bottom: 0; display: flex; flex-direction: column; gap: 12px; padding: 16px 18px; border-radius: 22px 16px 22px 14px / 16px 22px 14px 22px; background: rgba(15, 32, 21, .82); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .1), 0 0 0 1px rgba(228, 240, 214, .1), 0 30px 60px -20px rgba(0, 0, 0, .7); }
  .hb-track { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; }
  .hb-track i { display: flex; align-items: center; height: 26px; padding-left: 8px; border-radius: 8px; background: rgba(217, 234, 110, .9); color: #152213; font: normal 600 11px var(--sans); }
  .hb-track i:first-child { border-radius: 13px 8px 8px 13px; }
  .hb-track i:last-child { border-radius: 8px 13px 13px 8px; }
  :global(.js) .hero-bar .hb-track i { opacity: .2; transition: opacity .5s ease var(--d); }
  :global(.js) .hero-bar.on .hb-track i { opacity: 1; }
  .hb-k { font: 500 12.5px/1.4 var(--sans); color: var(--on-dark-muted); }
  @media (max-width: 860px) { .hero-bar { left: 0; right: 0; } }

  /* The usual presentation against the Masterclass */
  .vs { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: clamp(16px, 2vw, 28px); align-items: stretch; margin-top: clamp(44px, 5vw, 64px); }
  .vs-col { padding: clamp(26px, 3vw, 40px); border-radius: var(--r-b); }
  .vs-old { background: rgba(20, 35, 26, .04); box-shadow: inset 0 0 0 1px var(--line); }
  .vs-new { background: var(--dark); color: var(--on-dark); border-radius: var(--r-a); box-shadow: 0 36px 70px -30px rgba(20, 35, 26, .5); }
  .vs-k { display: block; font: 600 11px var(--sans); letter-spacing: 2.2px; text-transform: uppercase; color: var(--muted-2); }
  .vs-new .vs-k { color: #DCEC85; }
  .vs ol { list-style: none; margin: 22px 0 0; padding: 0; position: relative; }
  .vs ol::before { content: ''; position: absolute; left: 7px; top: 12px; bottom: 12px; width: 2px; background: repeating-linear-gradient(180deg, rgba(20, 35, 26, .2) 0 4px, transparent 4px 9px); }
  .vs-new ol::before { background: repeating-linear-gradient(180deg, rgba(217, 234, 110, .45) 0 4px, transparent 4px 9px); }
  .vs li { position: relative; padding: 9px 0 9px 32px; font: 500 16.5px/1.4 var(--sans); color: var(--muted); }
  .vs li::before { content: ''; position: absolute; left: 0; top: 13px; width: 16px; height: 16px; border-radius: 50%; background: var(--cream); box-shadow: inset 0 0 0 2px rgba(20, 35, 26, .25); }
  .vs-old li:last-child { color: var(--muted-2); text-decoration: line-through; text-decoration-color: rgba(20, 35, 26, .35); }
  .vs-new li { color: var(--on-dark); }
  .vs-new li::before { background: var(--lime); box-shadow: 0 0 0 4px rgba(217, 234, 110, .18); }
  .vs-end { margin: 22px 0 0; padding-top: 20px; border-top: 1px solid var(--line); font: 500 17px/1.45 var(--sans); color: var(--ink); }
  .vs-new .vs-end { border-color: var(--line-dark); color: var(--on-dark); font-size: clamp(18px, 1.6vw, 21px); }
  .vs-new .mk { --mk: rgba(217, 234, 110, .4); }
  .vs-mid { display: flex; align-items: center; }
  .vs-mid span { display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 50%; background: var(--lime); font: 400 20px/1 var(--serif); font-style: italic; color: #152213; }
  @media (max-width: 760px) {
    .vs { grid-template-columns: 1fr; }
    .vs-mid { justify-content: center; margin: -8px 0; position: relative; z-index: 1; }
  }
  .leave-h { margin-top: clamp(64px, 7vw, 96px); font-size: clamp(26px, 2.6vw, 32px); }
  .leave { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 28px; margin-top: 28px; }
  .leave .feat h3 { font-size: clamp(20px, 1.8vw, 22px); }

  /* The session as a five-part track */
  .rm { margin-top: clamp(44px, 5vw, 64px); }
  .rm-track { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
  .rm-tab { position: relative; display: flex; align-items: center; gap: 10px; min-height: 60px; padding: 0 16px; border: 0; border-radius: 10px; background: rgba(228, 240, 214, .07); box-shadow: inset 0 0 0 1px rgba(228, 240, 214, .1); color: var(--on-dark); font: inherit; text-align: left; cursor: pointer; overflow: hidden; transition: background .25s ease; }
  .rm-tab:first-child { border-radius: 24px 10px 10px 24px; }
  .rm-tab:last-child { border-radius: 10px 24px 24px 10px; }
  .rm-tab:hover { background: rgba(228, 240, 214, .12); }
  .rm-tab[aria-selected=true] { background: var(--lime); color: #152213; box-shadow: none; }
  .rm-n { font: 600 12px var(--sans); letter-spacing: .5px; opacity: .7; }
  .rm-l { font: 600 14.5px/1.25 var(--sans); }
  .rm-tab .v-bar { left: 12px; right: 12px; bottom: 6px; background: #152213; opacity: .5; }
  .rm-tab[aria-selected=true] .v-bar.run { animation: v-run var(--t, 8s) linear forwards; }
  .rm-ends { display: flex; justify-content: space-between; margin-top: 10px; font: 600 11px var(--sans); letter-spacing: 1.6px; text-transform: uppercase; color: rgba(246, 244, 233, .5); }
  .rm-stage { margin-top: clamp(28px, 3vw, 40px); }
  .rm-stage > .rm-panel + .rm-panel { margin-top: 40px; }
  @media (min-width: 761px) {
    .tabs-on .rm-stage { display: grid; }
    .tabs-on .rm-stage > .rm-panel { grid-area: 1 / 1; margin-top: 0; }
    .tabs-on .rm-stage > .rm-panel[hidden] { display: grid !important; visibility: hidden; }
  }
