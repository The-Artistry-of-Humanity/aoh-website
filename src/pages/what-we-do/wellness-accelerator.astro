---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { TESTIMONIALS, PILLARS, SHERPANY_SCORES, VIDEO } from '../../data/aoh';

// The Wellness Accelerator: six facilitated weeks through the Five Pillars.
// Copy and the Sherpany by Datasite results from the previous site's Wellness
// Accelerator page. The enquiry form keeps the old contact form's fields, with
// the interest fixed to the Accelerator.

const sorin = TESTIMONIALS.find(t => t.name === 'Sorin Popa')!;

// The six weeks. Weeks one to five each open one pillar (week one also sets up
// the framework); week six brings them together.
const LIME = '#D9EA6E';
const WEEKS = [
  { short: 'Foundations', pillar: 0, title: 'Foundations, and Health & Fitness', text: 'We set up the framework: what the Five Pillars are, how they work as a system and why this approach is different. Then the first pillar, physical vitality. Teams assess where they are, name the habits that serve them and set a practical direction for the weeks ahead.' },
  { short: 'Internal Work', pillar: 1, title: 'Internal Work', text: 'The hardest week, and often the most powerful. Self-awareness, values, purpose and the internal narratives that shape how people show up. This is where the most honest conversations happen.' },
  { short: 'Love & Relationships', pillar: 2, title: 'Love & Relationships', text: 'The connections closest to us. Almost never addressed in workplace wellbeing, which is exactly why it has such an impact when it is. Teams explore how their closest relationships affect their capacity, energy and presence at work.' },
  { short: 'Social Connection', pillar: 3, title: 'Social Connection', text: 'Belonging, friendship and community, at work and beyond. The social fabric of the team and of people’s wider lives, and the often invisible cost of loneliness in a world that has never been more connected online.' },
  { short: 'Work & Life Flow', pillar: 4, title: 'Work & Life Flow', text: 'Not balance: integration. How professional ambition and personal fulfilment can reinforce each other rather than compete. Purpose, boundaries and the design of a working life that lasts.' },
  { short: 'Integration', pillar: -1, title: 'Integration & Accountability', text: 'Teams revisit their Fulfilment Scores, name the shifts that have already happened and build an accountability structure that carries the work forward after the program ends.' },
].map(w => ({ ...w, tint: w.pillar < 0 ? LIME : PILLARS[w.pillar].tint, paths: w.pillar < 0 ? null : PILLARS[w.pillar].paths, tag: w.pillar === 0 ? 'Framework + pillar one' : w.pillar < 0 ? 'All five pillars' : `Pillar ${w.pillar + 1} of 5` }));

const EVERY_WEEK = [
  { icon: 'users', text: 'A facilitated session' },
  { icon: 'pen', text: 'Structured individual reflection' },
  { icon: 'tune', text: 'A practical tool to use between sessions' },
  { icon: 'check', text: 'A shared team accountability moment' },
] as const;

const FOR = [
  { icon: 'search', title: 'Leadership teams who know something is off', sub: 'Engagement down, turnover up, nobody can say why.', text: 'Engagement is dropping, turnover is higher than it should be, and the culture feels strained without anyone being able to say why. You’re ready to give the team a real framework, not another awareness session.' },
  { icon: 'shield', title: 'Organisations ahead of the legislative curve', sub: 'Psychosocial safety obligations are tightening.', text: 'Psychosocial safety obligations are tightening across Australia and beyond. The Accelerator gives you what the legislation is asking for: a structured, documented and evidenced approach.' },
  { icon: 'open', title: 'Leaders who want to model what they ask', sub: 'Leaders go through it first.', text: 'You can’t build a culture of openness and accountability if the people at the top won’t do the work. The program is experienced by leaders first, so they know what they’re asking of their people.' },
] as const;

const INCLUDED = [
  { group: 'In the six weeks', items: [
    { icon: 'calendar', title: 'Six facilitated sessions', text: 'One a week, in person or virtual.' },
    { icon: 'mic', title: 'Full facilitation', text: 'Every session run by an AOH practitioner.' },
    { icon: 'tune', title: 'Practical tools', text: 'For each of the Five Pillars.' },
    { icon: 'pen', title: 'Weekly reflection', text: 'Structured, for every participant.' },
    { icon: 'users', title: 'Accountability partners', text: 'A partner system within the team.' },
  ] },
  { group: 'Measured and reported', items: [
    { icon: 'chart', title: 'The Fulfilment Score, twice', text: 'The assessment before the program and after it.' },
    { icon: 'target', title: 'Team baseline and progress report', text: 'A shared Fulfilment baseline for the team.' },
    { icon: 'talk', title: 'Debrief and recommendations', text: 'A session once the program ends.' },
    { icon: 'doc', title: 'Program summary', text: 'A document for internal reporting.' },
    { icon: 'norma', title: 'nørma, if you want it', text: 'Optional integration for ongoing tracking.' },
  ] },
] as const;

const CASE = [
  { k: 'The weakest pillar', tint: PILLARS[1].tint, text: 'Internal Work was the team’s weakest pillar, and it triggered the most honest conversations they had ever had.' },
  { k: 'The hard conversations', tint: LIME, text: 'Leaders who had been working around certain dynamics for months finally had a structure that made the conversation possible.' },
  { k: 'After six weeks', tint: LIME, text: 'Measurable shifts across all Five Pillars, accountability rituals they’d built themselves, and a culture that finally had a name for what it had been missing.' },
];

// Pentagon geometry (as on the home page), for the week-by-week progress.
const corner = (cx: number, cy: number, r: number, i: number) => {
  const a = (Math.PI * 2 * i) / 5 - Math.PI / 2;
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
};
const WP = { cx: 160, cy: 168, r: 112 };
const wpCorners = [0, 1, 2, 3, 4].map(i => corner(WP.cx, WP.cy, WP.r, i));
const svgPts = (p: number[][]) => p.map(([x, yy]) => `${x.toFixed(1)},${yy.toFixed(1)}`).join(' ');
// How many pillars a week has opened so far, and which one is new that week.
const opened = (wi: number) => (WEEKS[wi].pillar < 0 ? 5 : WEEKS[wi].pillar + 1);
const trail = (n: number) => wpCorners.slice(0, n).map(([x, yy], k) => `${k ? 'L' : 'M'}${x.toFixed(1)} ${yy.toFixed(1)}`).join(' ') + (n === 5 ? ' Z' : '');

// Sherpany: one line per leader, start of the program vs after six weeks (the home page's chart).
const SC = { x0: 64, x1: 420, top: 26, bottom: 262 };
const y = (s: number) => SC.bottom - (s / 100) * (SC.bottom - SC.top);
const spread = (vals: number[]) => {
  const order = vals.map((v, i) => ({ i, y: y(v) })).sort((a, b) => a.y - b.y);
  for (let k = 1; k < order.length; k++) if (order[k].y - order[k - 1].y < 15) order[k].y = order[k - 1].y + 15;
  const out: number[] = [];
  order.forEach(o => (out[o.i] = o.y));
  return out;
};
const startY = spread(SHERPANY_SCORES.map(s => s[0]));
const endY = spread(SHERPANY_SCORES.map(s => s[1]));
const lines = SHERPANY_SCORES.map(([a, b], i) => ({ a, b, y0: y(a), y1: y(b), ly0: startY[i], ly1: endY[i], len: Math.hypot(SC.x1 - SC.x0, y(b) - y(a)) }));

// Team size: six minimum, eight to twenty recommended.
const TS = Array.from({ length: 20 }, (_, i) => i + 1);
const tsX = (n: number) => 12 + (n - 1) * 20;
---
<Base title="The Wellness Accelerator · The Artistry of Humanity" description="A six-week facilitated program that takes your leadership team through the Five Pillars of Fulfilment, one pillar a week. With Sherpany by Datasite, the team fulfilment score rose 29% from the start of the program to after six weeks." path="/what-we-do/wellness-accelerator">

  <!-- Hero -->
  <section class="bg-dark" style="overflow:hidden">
    <div class="glow" style="right:-18%;top:-30%;width:70%;background:radial-gradient(closest-side,rgba(217,234,110,.14),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap split" style="padding-top:clamp(48px,7vw,96px);padding-bottom:clamp(120px,14vw,190px)">
      <div style="max-width:600px">
        <span class="eyebrow">The Wellness Accelerator</span>
        <h1 style="color:var(--on-dark)">Six weeks. Five pillars. A culture that <span class="mk mk-d">actually changes</span>.</h1>
        <p class="lead">Our flagship program: six facilitated weeks through the Five Pillars of Fulfilment, for leadership teams ready to move beyond good intentions.</p>
        <div class="btns">
          <a class="btn btn-lime" href="#enquire">Enquire about the program</a>
          <a class="btn btn-ghost" href="#program">See the six weeks</a>
        </div>
        <div class="hero-chips">
          <span><b>+29%</b>team fulfilment score with Sherpany by Datasite, start of the program vs after six weeks</span>
          <span><b>6</b>weeks, one pillar at a time</span>
        </div>
      </div>
      <figure class="hero-fig">
        <div class="photo" style="aspect-ratio:480/560;box-shadow:0 50px 90px -40px rgba(0,0,0,.7)"><img src="/assets/program-delivery.jpg" alt="A Wellness Accelerator session in progress, with Ian at the front of the room" width="1024" height="683" style="object-position:58% 50%" /></div>
        <a class="hero-strip" href="#program" aria-label="The six weeks, one pillar at a time">
          <span class="eyebrow">Week by week</span>
          <span class="hs-dots">
            {WEEKS.map((w, i) => (
              <span class="hs-dot" style={`--tint:${w.tint}`}>
                {w.paths ? <Icon paths={w.paths} size={17} stroke="#14231A" width={1.6} /> : <Icon name="check" size={17} stroke="#14231A" width={2} />}
                <small>{i + 1}</small>
              </span>
            ))}
          </span>
        </a>
      </figure>
    </div>
  </section>

  <!-- Event or system -->
  <section class="lift" style="background:var(--cream)">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">Why it works</span><h2>Not a workshop. <span class="mk">A system.</span></h2></div>
        <p class="lead" style="margin-top:0">Most wellbeing programs are events. The Accelerator is a working framework your leaders apply to themselves, their teams and the way the organisation runs.</p>
      </div>
      <div class="vs" style="margin-top:clamp(40px,5vw,60px)">
        <div class="card vs-event" data-rv>
          <span class="pill">Most wellbeing programs</span>
          <h3 style="margin-top:16px">An event.</h3>
          <svg viewBox="0 0 400 84" role="img" aria-label="An event: one day in the room, then nothing after it">
            <defs><linearGradient id="vs-fade" x1="0" x2="1"><stop offset="0" stop-color="#14231A" stop-opacity=".35" /><stop offset=".7" stop-color="#14231A" stop-opacity=".06" /><stop offset="1" stop-color="#14231A" stop-opacity="0" /></linearGradient></defs>
            <line x1="40" y1="34" x2="390" y2="34" stroke="url(#vs-fade)" stroke-width="2" stroke-dasharray="4 6" />
            {[96, 152, 208, 264, 320].map(x => <circle cx={x} cy="34" r="6" fill="#F4F2E6" stroke="rgba(20,35,26,.16)" stroke-width="1.2" />)}
            <circle cx="40" cy="34" r="16" fill="rgba(20,35,26,.18)" />
            <circle cx="40" cy="34" r="6" fill="rgba(20,35,26,.5)" />
            <text x="24" y="74" text-anchor="start" font-family="'DM Sans', system-ui, sans-serif" font-size="10.5" font-weight="600" letter-spacing="1.2" fill="rgba(20,35,26,.55)">THE DAY</text>
            <text x="152" y="74" text-anchor="middle" font-family="'DM Sans', system-ui, sans-serif" font-size="10.5" font-weight="600" letter-spacing="1.2" fill="rgba(20,35,26,.4)">MONDAY</text>
          </svg>
          <ol class="vs-flow">
            <li>A speaker comes in</li>
            <li>People feel inspired</li>
            <li>Monday arrives</li>
            <li class="vs-end">Nothing changes</li>
          </ol>
        </div>
        <div class="card-dark vs-system" data-rv>
          <span class="pill">The Wellness Accelerator</span>
          <h3 style="margin-top:16px">A system.</h3>
          <svg viewBox="0 0 400 84" role="img" aria-label="A system: six weekly sessions, each building on the last, and work that carries on after week six">
            <line class="vs-climb" x1="40" y1="34" x2="320" y2="34" stroke="#D9EA6E" stroke-width="2.4" stroke-linecap="round" pathLength="100" />
            <line x1="320" y1="34" x2="384" y2="34" stroke="#D9EA6E" stroke-opacity=".55" stroke-width="2" stroke-dasharray="4 5" stroke-linecap="round" />
            <path d="M378 28 L386 34 L378 40" fill="none" stroke="#D9EA6E" stroke-opacity=".8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            {WEEKS.map((w, i) => <circle cx={40 + i * 56} cy="34" r="9" fill={w.tint} stroke="#0F2015" stroke-width="3" />)}
            {WEEKS.map((_, i) => <text x={40 + i * 56} y="74" text-anchor="middle" font-family="'DM Sans', system-ui, sans-serif" font-size="10.5" font-weight="600" letter-spacing="1" fill="rgba(246,244,233,.55)">W{i + 1}</text>)}
          </svg>
          <ul class="vs-flow vs-on">
            <li>Education, every week</li>
            <li>Structured reflection</li>
            <li>Tools to use between sessions</li>
            <li class="vs-end">Accountability as structure, not pressure</li>
          </ul>
        </div>
      </div>
      <div class="w6" data-rv>
        <span class="eyebrow">After six weeks, the team has</span>
        <div class="w6-row">
          <span><Icon name="talk" size={22} />A shared language</span>
          <span><Icon name="loop" size={22} />Accountability rituals of its own</span>
          <span><Icon name="target" size={22} />A measurable baseline</span>
        </div>
        <p class="body" style="margin-top:18px;max-width:40em">Leaders who go through it say they’re better equipped for the conversations they’d been avoiding: how people are actually doing, not just how the project is tracking.</p>
      </div>
    </div>
  </section>

  <!-- Who it is for -->
  <section class="bg-sand lift-b">
    <div class="wrap sec">
      <div class="split" style="align-items:flex-start">
        <div class="video" data-rv style="flex:1 1 420px">
          <img src="/assets/happy-participants.jpg" alt="" width="1024" height="683" loading="lazy" />
          <button type="button" data-yt={VIDEO} aria-label="Watch Ian live"><span><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5 18 12 8 18.5Z" /></svg></span>Watch Ian live</button>
        </div>
        <div style="flex:1 1 440px">
          <span class="eyebrow">Who it’s for</span>
          <h2 style="font-size:clamp(30px,3.4vw,44px)">Is this the right program for your organisation?</h2>
          <div class="accs" style="margin-top:28px">
            {FOR.map((f, i) => (
              <details class="acc" open={i === 0}>
                <summary><span class="ico"><Icon name={f.icon} size={22} /></span><span>{f.title}<span class="acc-sub">{f.sub}</span></span></summary>
                <div class="acc-body"><p>{f.text}</p></div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The six weeks, one at a time -->
  <section id="program" class="bg-dark lift">
    <div class="glow" style="left:-16%;bottom:-20%;width:56%;background:radial-gradient(closest-side,rgba(217,234,110,.1),rgba(217,234,110,0) 70%)"></div>
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div><span class="eyebrow">The program</span><h2>Six weeks. <span class="mk mk-d">One pillar at a time.</span></h2></div>
        <p class="lead" style="margin-top:0">Each week builds on the last. Pick a week to see what the team works on.</p>
      </div>
      <div class="wk" data-tabs style="margin-top:clamp(44px,5vw,64px)">
        <div class="wk-line" role="tablist" aria-label="The six weeks">
          {WEEKS.map((w, i) => (
            <button type="button" class="wk-tab" role="tab" id={`wk-t${i}`} aria-controls={`wk-p${i}`} style={`--tint:${w.tint}`}>
              <span class="wk-dot">{w.paths ? <Icon paths={w.paths} size={24} /> : <Icon name="check" size={24} width={2} />}</span>
              <span class="wk-n" data-n={`W${i + 1}`}>Week {i + 1}</span>
              <span class="wk-name">{w.short}</span>
            </button>
          ))}
        </div>
        {WEEKS.map((w, i) => {
          const n = opened(i);
          return (
            <div class="wk-p" role="tabpanel" id={`wk-p${i}`} aria-labelledby={`wk-t${i}`}>
              <figure class="wk-fig">
                <svg viewBox="0 0 320 330" role="img" aria-label={w.pillar < 0 ? 'All Five Pillars worked through, brought together in week six' : `Week ${i + 1}: ${PILLARS[w.pillar].name}, pillar ${w.pillar + 1} of the Five Pillars`}>
                  <polygon points={svgPts(wpCorners)} fill="rgba(228,240,214,.03)" stroke="rgba(228,240,214,.14)" stroke-width="1.2" stroke-dasharray="3 6" stroke-linejoin="round" />
                  {n > 1 && <path d={trail(n)} fill={n === 5 && w.pillar < 0 ? 'rgba(217,234,110,.12)' : 'none'} stroke="#D9EA6E" stroke-opacity=".75" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />}
                  <text x={WP.cx} y={WP.cy - 2} text-anchor="middle" font-family="'DM Serif Display', Georgia, serif" font-size="40" fill="#F6F4E9">W{i + 1}</text>
                  <text x={WP.cx} y={WP.cy + 22} text-anchor="middle" font-family="'DM Sans', system-ui, sans-serif" font-size="10.5" font-weight="600" letter-spacing="2" fill="#DCEC85">{w.pillar < 0 ? 'ALL FIVE' : `${n} OF 5`}</text>
                  {PILLARS.map((p, k) => {
                    const [cx, cy] = wpCorners[k];
                    const done = k < n;
                    const now = k === w.pillar;
                    return (
                      <g>
                        {now && <circle cx={cx} cy={cy} r="38" fill="none" stroke={p.tint} stroke-opacity=".45" stroke-width="1.5" />}
                        <circle cx={cx} cy={cy} r={now ? 30 : 25} fill={done ? p.tint : 'rgba(228,240,214,.05)'} stroke={done ? '#0F2015' : 'rgba(228,240,214,.28)'} stroke-width={done ? 4 : 1.2} stroke-dasharray={done ? undefined : '3 4'} />
                        <g transform={`translate(${(cx - (now ? 15 : 12)).toFixed(1)} ${(cy - (now ? 15 : 12)).toFixed(1)}) scale(${now ? 1.25 : 1})`} fill="none" stroke={done ? '#14231A' : 'rgba(246,244,233,.4)'} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">{p.paths.map(d => <path d={d} />)}</g>
                      </g>
                    );
                  })}
                </svg>
              </figure>
              <div class="wk-copy">
                <span class="pill">Week 0{i + 1} · {w.tag}</span>
                <h3>{w.title}</h3>
                <p class="body">{w.text}</p>
                <div class="wk-nav">
                  {i > 0 && <button type="button" class="btn btn-ghost" data-go={i - 1}>‹ Week {i}</button>}
                  {i < WEEKS.length - 1 ? <button type="button" class="btn btn-lime" data-go={i + 1}>Week {i + 2} ›</button> : <a class="btn btn-lime" href="#enquire">Bring it to your team</a>}
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <div class="every">
        <span class="eyebrow">Every week includes</span>
        <ul>{EVERY_WEEK.map(e => <li><span class="ico"><Icon name={e.icon} size={22} /></span>{e.text}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- Case study: Sherpany by Datasite -->
  <section class="bg-sand lift-b">
    <div class="wrap sec">
      <div class="split" style="align-items:end">
        <div>
          <img src="/assets/sherpany-logo.png" alt="Sherpany by Datasite" width="230" height="112" style="width:150px" />
          <span class="eyebrow" style="margin-top:22px">Case study</span>
          <h2>When people can see their fulfilment, <span class="mk">things shift fast</span>.</h2>
        </div>
        <div>
          <p class="lead" style="margin-top:0">In six weeks, Sherpany’s leadership team went from quiet disconnection to a shared language for how their people were actually doing.</p>
          <div class="cs-stats">
            <div><div class="stat">+29%</div><p class="small">team fulfilment score, start of the program vs after six weeks</p></div>
            <div><div class="stat">6</div><p class="small">weeks, full program</p></div>
          </div>
        </div>
      </div>

      <div class="cs-grid" style="margin-top:clamp(40px,5vw,60px)">
        <figure class="card-dark sc" data-rv>
          <span class="eyebrow">Fulfilment Score, start of the program vs after six weeks</span>
          <svg viewBox="0 0 500 300" role="img" aria-label={'Fulfilment Scores for five Sherpany leaders, start of the program and after six weeks: ' + SHERPANY_SCORES.map(([a, b]) => `${a} to ${b}`).join(', ')}>
            {[25, 50, 75, 100].map(s => <line x1={SC.x0} x2={SC.x1} y1={y(s)} y2={y(s)} stroke="rgba(228,240,214,.08)" stroke-width="1" />)}
            <line x1={SC.x0} x2={SC.x0} y1={SC.top - 6} y2={SC.bottom} stroke="rgba(228,240,214,.22)" stroke-width="1" />
            <line x1={SC.x1} x2={SC.x1} y1={SC.top - 6} y2={SC.bottom} stroke="rgba(228,240,214,.22)" stroke-width="1" />
            {lines.map((l, i) => (
              <g class="sc-l" style={`--len:${l.len.toFixed(0)};--d:${(i * 0.12).toFixed(2)}s`}>
                <line x1={SC.x0} y1={l.y0} x2={SC.x1} y2={l.y1} stroke="#D9EA6E" stroke-opacity=".85" stroke-width="2.4" stroke-linecap="round" stroke-dasharray={l.len.toFixed(0)} />
                <circle cx={SC.x0} cy={l.y0} r="4.5" fill="#0F2015" stroke="#D9EA6E" stroke-width="2" />
                <circle class="sc-end" cx={SC.x1} cy={l.y1} r="5" fill="#D9EA6E" />
                <text x={SC.x0 - 14} y={l.ly0 + 4.5} text-anchor="end" font-family="'DM Sans', system-ui, sans-serif" font-size="13" font-weight="500" fill="rgba(246,244,233,.6)">{l.a}</text>
                <text class="sc-end" x={SC.x1 + 14} y={l.ly1 + 5} text-anchor="start" font-family="'DM Serif Display', Georgia, serif" font-size="17" fill="#EAF79B">{l.b}</text>
              </g>
            ))}
            <text x={SC.x0 - 6} y="292" text-anchor="start" font-family="'DM Sans', system-ui, sans-serif" font-size="11" font-weight="600" letter-spacing="1.6" fill="rgba(246,244,233,.55)">START OF PROGRAM</text>
            <text x={SC.x1 + 6} y="292" text-anchor="end" font-family="'DM Sans', system-ui, sans-serif" font-size="11" font-weight="600" letter-spacing="1.6" fill="#DCEC85">AFTER SIX WEEKS</text>
          </svg>
          <figcaption class="small" style="color:var(--on-dark-muted)">Each line is one leader on the team, from the start of the program to after six weeks. Every line goes up.</figcaption>
        </figure>
        <figure class="cs-shot" data-rv>
          <div class="photo"><img src="/assets/sherpany-scores.png" alt="Sherpany’s leadership team on a video call, each with their Five Pillars score" width="946" height="582" loading="lazy" /></div>
          <figcaption class="small">The real session: each leader with their own Five Pillars score.</figcaption>
        </figure>
      </div>

      <div class="split cs-bottom" style="margin-top:clamp(56px,6vw,88px);align-items:flex-start">
        <figure class="cs-q" data-rv>
          <svg class="cs-mark" width="46" height="34" viewBox="0 0 64 48" aria-hidden="true"><path d="M0 48V28C0 12 8 3 24 0l3 6C17 9 13 15 12.5 22H26v26zm36 0V28c0-16 8-25 24-28l3 6c-10 3-14 9-14.5 16H62v26z" /></svg>
          <blockquote>This wasn’t another wellbeing workshop. It was <span class="mk">a genuine shift</span> in how our leadership team thinks about culture, people, and performance.</blockquote>
          <figcaption class="person">
