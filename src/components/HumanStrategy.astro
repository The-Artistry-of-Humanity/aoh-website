---
/* The human strategy landing page, used by /human-strategy and
   /build-a-human-strategy, and shared with clients. Written in Ian's voice
   (first person), as on the previous site. The cost calculator runs in the
   browser; its benchmarks are the previous site's. */
import Icon from './Icon.astro';
import { PILLARS } from '../data/aoh';

const BOOKING_URL = 'https://calendar.app.google/P14aVTpPNqgrVAbHA';
const INTERESTS = ['Consulting', 'Masterclass', 'Wellness Accelerator', 'Leadership Coaching', 'Keynote or Workshop', 'nørma', 'Just exploring'];

const PILLAR_TEXT = [
  'The energy your team actually shows up with.',
  'How they handle pressure, clarity and self-leadership.',
  'The lives behind the role, and what they bring in with them.',
  'The trust between people on your team.',
  'Whether the way you work is sustainable, or quietly burning them out.',
];

const FORMATS = [
  { icon: 'compass', flag: 'Deepest engagement', title: 'Consulting', text: 'I come in alongside your leadership team and build your human strategy with you. We map where your team actually stands across the Five Pillars, design the operating model, and embed it as a system you run, not a program you launch.', href: '/what-we-do/culture-consulting' },
  { icon: 'board', flag: 'Best starting point', title: 'Masterclass', text: 'A focused 60 to 90 minute session for your leadership team. You leave with a shared language for the human side of the business and a clear read on where your team is strong, and where it is quietly under strain.', href: '/what-we-do/masterclass' },
  { icon: 'climb', flag: '6 weeks', title: 'Wellness Accelerator', text: 'A facilitated six-week program that takes a team through each of the Five Pillars with structured exercises, accountability and visible progress. The fastest way to move a team from idea to practice.', href: '/what-we-do/wellness-accelerator' },
  { icon: 'talk', flag: '1:1', title: 'Leadership coaching', text: 'Private coaching for senior leaders who want to model what they are asking of their teams. Grounded in the same framework, applied to your own life and your own leadership.', href: '/what-we-do/leadership-coaching' },
  { icon: 'mic', flag: 'Events', title: 'Keynotes and workshops', text: 'From a 45-minute keynote to a full-day immersive session. Tailored to your event, your audience and the conversation you want to start.', href: '/what-we-do/keynotes-workshops' },
] as const;

const CALL = [
  { icon: 'users', t: 'Get to know each other' },
  { icon: 'search', t: 'Unpack the challenges you are facing' },
  { icon: 'compass', t: 'Explore how a human strategy might help' },
  { icon: 'check', t: 'Leave with something useful, either way' },
] as const;

/* Calculator benchmarks, from the previous site. Keep in step with the script
   at the bottom of this file. */
const INDUSTRIES: Record<string, { label: string; t: number; a: number; p: number; c: number; salary: number; note: string }> = {
  technology:    { label: 'Technology & Software',          t: 1.40, a: 0.90, p: 1.15, c: 1.10, salary: 135000, note: 'High turnover, chronic cognitive load, heavy presenteeism.' },
  financial:     { label: 'Financial Services & Banking',   t: 1.15, a: 1.00, p: 1.25, c: 1.15, salary: 140000, note: 'Long-hours culture, elevated psychosocial claim rates.' },
  professional:  { label: 'Consulting, Legal & Accounting', t: 1.35, a: 0.95, p: 1.30, c: 1.20, salary: 125000, note: 'Utilisation pressure and burnout-driven exits.' },
  healthcare:    { label: 'Healthcare & Social Care',       t: 1.30, a: 1.45, p: 1.20, c: 1.35, salary: 95000,  note: 'Highest burnout and absence rates in the economy.' },
  retail:        { label: 'Retail & Hospitality',           t: 2.30, a: 1.20, p: 1.00, c: 1.05, salary: 65000,  note: 'Volatile workforce, replacement cost dominates.' },
  construction:  { label: 'Construction & Trades',          t: 1.35, a: 1.30, p: 0.90, c: 1.40, salary: 100000, note: 'Highest suicide rate of any Australian sector.' },
  education:     { label: 'Education',                      t: 0.95, a: 1.30, p: 1.20, c: 1.25, salary: 95000,  note: 'Lower turnover, high emotional load, rising burnout.' },
  government:    { label: 'Government & Public Sector',     t: 0.70, a: 1.20, p: 1.15, c: 1.10, salary: 105000, note: 'Low turnover, elevated absence, cultural stagnation risk.' },
  manufacturing: { label: 'Manufacturing & Logistics',      t: 1.20, a: 1.30, p: 1.00, c: 1.10, salary: 90000,  note: 'Physical demand and shift work drive absence.' },
  media:         { label: 'Media, Marketing & Creative',    t: 1.50, a: 0.90, p: 1.25, c: 1.15, salary: 95000,  note: 'Deadline culture, high turnover, presenteeism heavy.' },
  other:         { label: 'Other / Mixed',                  t: 1.00, a: 1.00, p: 1.00, c: 1.00, salary: 110000, note: 'Blended Australian baseline.' },
};

function calc(n: number, key: string, salary: number) {
  const ind = INDUSTRIES[key] || INDUSTRIES.other;
  const absenceDays = 3.1 * ind.a;                    // Safe Work Australia 2024
  const turnoverRate = 0.13 * ind.t;                  // AHRI 2024
  const presRate = 0.09 * ind.p;                      // Deloitte AU 2024
  const absenteeism = n * (salary / 230) * absenceDays;
  const turnover = n * turnoverRate * salary * 0.5;   // Gallup / SHRM replacement midpoint
  const presenteeism = n * salary * presRate;
  const visible = absenteeism + turnover;
  const total = visible + presenteeism;
  const disengaging = Math.round(Math.round(n * 0.85) * 0.6);
  const burnout = Math.round(disengaging * 0.35 * ind.c);
  const crisis = Math.round(burnout * 0.04 * ind.c);
  const claims = crisis * 0.08;                       // claim conversion from crisis
  return {
    absenceDays, turnoverRate, presRate, absenteeism, turnover, presenteeism, visible, total,
    hiddenPct: total > 0 ? Math.round((presenteeism / total) * 100) : 0,
    disengaging, heading: Math.max(0, burnout - crisis), burnout, crisis, claims,
    low: claims * 379157 * 0.6, high: claims * 379157 * 1.4,
    risk: n >= 500 ? 'Significant' : n >= 100 ? 'Material' : 'Emerging',
    note: ind.note,
  };
}
const aud = (v: number) => v >= 1e9 ? `$${(v / 1e9).toFixed(2)}B` : v >= 1e6 ? `$${(v / 1e6).toFixed(2)}M` : v >= 1e3 ? `$${Math.round(v / 1e3)}k` : `$${Math.round(v)}`;
const num = (v: number) => new Intl.NumberFormat('en-AU', { maximumFractionDigits: 0 }).format(Math.max(0, Math.round(v)));
const pct = (c: number, n: number) => { const x = n > 0 ? (c / n) * 100 : 0; return (x < 0.1 ? '<0.1' : x.toFixed(1)) + '% of team'; };
const claimText = (x: number) => x < 1 ? 'less than one expected psychosocial claim a year.' : `${x.toFixed(1)} expected psychosocial claims a year.`;

const N0 = 250, S0 = INDUSTRIES.other.salary;
const r = calc(N0, 'other', S0);
---

<!-- Hero: Ian, and the strategy most companies are missing. -->
<section style="background:var(--cream);overflow:hidden">
  <div class="glow" style="right:-12%;top:-20%;width:56%;background:radial-gradient(closest-side,rgba(217,234,110,.28),rgba(217,234,110,0) 70%)"></div>
  <div class="wrap split" style="padding-top:clamp(40px,6vw,88px);padding-bottom:clamp(120px,13vw,180px)">
    <div style="max-width:620px">
      <span class="eyebrow">Human strategy, with Ian Williams</span>
      <h1>Most companies have a business strategy. Few have a <span class="mk">human strategy</span>.</h1>
      <p class="lead">I help leadership teams build theirs.</p>
      <div class="btns">
        <a class="btn btn-lime" href="#contact">Book time with us</a>
        <a class="btn btn-ghost" href="#calculator">See what it’s costing you</a>
      </div>
    </div>
    <figure class="hs-hero">
      <div class="arch" style="aspect-ratio:420/520;background:radial-gradient(64% 42% at 50% 22%,rgba(217,234,110,.6),rgba(217,234,110,.16) 55%,rgba(217,234,110,0) 82%),linear-gradient(180deg,#E8EACB,#ECE8D7 52%,#E4DFCA);position:relative">
        <img src="/assets/ian-portrait.webp" alt="Ian Williams" width="900" height="802" style="position:absolute;left:50%;bottom:0;width:128%;max-width:none;transform:translateX(-50%)" />
      </div>
      <div class="hs-card" aria-hidden="true">
        <p class="hs-row"><span class="hs-ok"><Icon name="check" size={16} width={2.2} /></span><span><b>Business strategy</b><small>Market · product · numbers · plan</small></span></p>
        <p class="hs-row hs-miss"><span class="hs-q">?</span><span><b>Human strategy</b><small>Energy · clarity · trust</small></span></p>
      </div>
      <figcaption><b>Ian Williams</b><span class="who">Founder &amp; CEO</span></figcaption>
    </figure>
  </div>
</section>

<!-- The idea: the plan stands on the people. -->
<section class="bg-sand lift">
  <div class="wrap sec">
    <div class="split" style="align-items:end">
      <div style="flex:1 1 520px"><span class="eyebrow">The idea</span><h2>You have a business strategy. The thing it actually runs on is <span class="mk">people</span>.</h2></div>
      <p class="lead" style="margin-top:0;flex:1 1 360px">How they are doing, how they connect, whether they trust each other, whether they have anything left to give. That is your human strategy. Most leaders have never named it, let alone built one.</p>
    </div>

    <div class="idea" data-tabs>
      <figure class="bld" role="img" aria-label="A building: your business strategy is the roof, held up by five columns, the Five Pillars of Fulfilment, which together are your human strategy">
        <div class="bld-roof"><span class="eyebrow">Your business strategy</span><b>The market, the product, the numbers, the plan.</b></div>
        <ol class="bld-cols">
          {PILLARS.map((p, i) => (
            <li style={`--t:${p.tint};--d:${i * 0.07}s`}>
              <span class="bc-dot"><Icon paths={p.paths} size={24} stroke="#14231A" width={1.5} /></span>
              <span class="bc-tx"><b>{p.name}</b><small>{PILLAR_TEXT[i]}</small></span>
            </li>
          ))}
        </ol>
        <div class="bld-base"><span class="eyebrow">Your human strategy</span><b>The Five Pillars of Fulfilment</b></div>
      </figure>

      <div class="idea-side">
        <p class="idea-k">The Five Pillars are the dimensions a team actually runs on. Not a wellbeing program. <span class="mk">The operating model itself.</span></p>
        <div class="tablist" role="tablist" aria-label="Built well, or not at all">
          <button type="button" class="tab" role="tab" id="hs-b0" aria-controls="hs-bp0"><Icon name="check" size={18} width={2} />Built well</button>
          <button type="button" class="tab" role="tab" id="hs-b1" aria-controls="hs-bp1"><Icon name="loop" size={18} />Built badly, or not at all</button>
        </div>
        <div class="idea-p" role="tabpanel" id="hs-bp0" aria-labelledby="hs-b0">
          <h3>Quiet and load bearing.</h3>
          <p class="body">It decides whether your team has the energy, clarity and trust to actually execute the plan you have set.</p>
        </div>
        <div class="idea-p" role="tabpanel" id="hs-bp1" aria-labelledby="hs-b1">
          <h3>The reason good strategy quietly stops moving.</h3>
          <p class="body">The plan is still there. The people it stands on are running low on energy, clarity or trust, and nobody is looking.</p>
        </div>
        <div class="accs" style="margin-top:28px">
          <details class="acc">
            <summary>What exactly is a human strategy?</summary>
            <div class="acc-body"><p>A human strategy is the operating model for the part of your business that lives inside the people doing the work. It is the system that decides whether your team has the energy, clarity and trust to actually execute the plan you have set. Built well, it is quiet and load bearing. Built badly, or not at all, it is the reason good strategy quietly stops moving.</p></div>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- The cost: calculator -->
<section class="bg-dark lift-b" id="calculator" style="scroll-margin-top:60px">
  <div class="glow" style="left:20%;top:-20%;width:60%;background:radial-gradient(closest-side,rgba(217,234,110,.09),rgba(217,234,110,0) 70%)"></div>
  <div class="wrap sec">
    <div style="max-width:760px">
      <span class="eyebrow">The cost of standing still</span>
      <h2>What is it costing you, today, not to have a <span class="mk mk-d">human strategy</span>?</h2>
      <p class="lead">Tell me the size of your team. I will show you what the human side looks like in real terms, what it is quietly costing you each year, and the risk you are carrying without knowing it.</p>
    </div>

    <div class="calc" data-calc data-industries={JSON.stringify(INDUSTRIES)}>
      <div class="tile ins">
        <div class="in">
          <div class="in-row"><label for="hs-n">People on your team</label><output for="hs-n" class="big" data-o="n">{num(N0)}</output></div>
          <input class="range" type="range" id="hs-n" min="10" max="5000" step="10" value={N0} style={`--p:${((N0 - 10) / 4990) * 100}%`} />
          <div class="in-ends"><span>10</span><span>5,000</span></div>
        </div>
        <div class="in">
          <div class="in-row"><label for="hs-ind">Industry</label><small>tunes the benchmarks</small></div>
          <select id="hs-ind">{Object.entries(INDUSTRIES).map(([k, v]) => <option value={k} selected={k === 'other'}>{v.label}</option>)}</select>
          <p class="note" data-o="note">{r.note}</p>
          <p class="chips"><span>Turnover <b data-o="turn">{(r.turnoverRate * 100).toFixed(1)}%</b></span><span>Absence <b data-o="abs">{r.absenceDays.toFixed(1)} days</b></span><span>Presenteeism <b data-o="pres">{Math.round(r.presRate * 100)}%</b></span></p>
        </div>
        <div class="in">
          <div class="in-row"><label for="hs-sal">Average salary</label><small>optional</small></div>
          <div class="money"><span aria-hidden="true">$</span><input type="text" id="hs-sal" inputmode="numeric" autocomplete="off" value={S0} /></div>
          <p class="note">Defaults to a sensible blended figure if you skip it.</p>
        </div>
        <p class="fine">Built on Gallup engagement data, SHRM turnover benchmarks and current Australian psychosocial safety regulation. Indicative for a conversation, not a substitute for one.</p>
      </div>

      <div class="outs">
        <div class="tile">
          <span class="eyebrow">The human picture</span>
          <p class="body">Behind every percentage point is a person. Of your <b data-o="n">{num(N0)}</b> people, today the picture looks roughly like this.</p>
          <div class="cells">
            <div class="cell"><b data-o="c1">{num(r.disengaging)}</b><small data-o="p1">{pct(r.disengaging, N0)}</small><h4>Quietly disengaging</h4><span>Showing up. Holding back.</span></div>
            <div class="cell"><b data-o="c2">{num(r.heading)}</b><small data-o="p2">{pct(r.heading, N0)}</small><h4>Heading toward burnout</h4><span>Sleep, focus, mood slipping.</span></div>
            <div class="cell hot"><b data-o="c3">{num(r.burnout)}</b><small data-o="p3">{pct(r.burnout, N0)}</small><h4>Already in burnout</h4><span>Exhausted, often hiding it.</span></div>
            <div class="cell hot"><b data-o="c4">{num(r.crisis)}</b><small data-o="p4">{pct(r.crisis, N0)}</small><h4>In genuine crisis</h4><span>Where harm and liability start.</span></div>
          </div>
          <p class="fine">Gallup 2024 · Deloitte AU Mental Health &amp; Employers 2024 · Black Dog Institute.</p>
        </div>

        <div class="tile">
          <div class="cost-hd">
            <div>
              <span class="eyebrow">Annual cost to you</span>
              <p class="body">Around <b class="hot-t" data-o="hid">{r.hiddenPct}%</b> of this never reaches the dashboard. It compounds quietly until it surfaces.</p>
            </div>
            <div class="cost-total"><b data-o="total">{aud(r.total)}</b><small>per year, indicative</small></div>
          </div>
          <div class="ice" data-ice style={`--hid:${r.hiddenPct}%`} aria-hidden="true"><span class="ice-v"><i>Visible</i></span><span class="ice-h"><i>Hidden</i></span></div>
          <div class="buckets">
            <div class="bucket">
              <span class="b-k">Visible</span><span class="b-t">In the books</span>
              <p><span>Absenteeism</span><b data-o="absc">{aud(r.absenteeism)}</b></p>
              <p><span>Turnover and replacement</span><b data-o="turnc">{aud(r.turnover)}</b></p>
              <p class="sub"><span>Subtotal</span><b data-o="vis">{aud(r.visible)}</b></p>
            </div>
            <div class="bucket hidden-b">
              <span class="b-k">Hidden</span><span class="b-t">Off the dashboard</span>
              <p><span>Presenteeism and lost focus</span><b data-o="presc">{aud(r.presenteeism)}</b></p>
              <p class="sub"><span>Subtotal</span><b data-o="presc">{aud(r.presenteeism)}</b></p>
            </div>
          </div>
        </div>

        <div class="tile risk">
          <p class="risk-hd"><span class="eyebrow">Regulatory exposure · Victoria</span><span class="risk-pill" data-o="risk">{r.risk}</span></p>
          <p class="risk-line"><span data-o="crisis-n">{num(r.crisis)} {r.crisis === 1 ? 'person' : 'people'}</span> in crisis is <span class="hot-t" data-o="claims">{claimText(r.claims)}</span></p>
          <p class="range-out"><b data-o="low">{aud(r.low)}</b><span>to</span><b data-o="high">{aud(r.high)}</b></p>
          <div class="accs risk-acc">
            <details class="acc">
              <summary>Where this range comes from</summary>
              <div class="acc-body">
                <p>Anchored to <i>WorkSafe Victoria v Court Services Victoria</i>, 2023: AU$379,157 for a single psychosocial safety breach. Applied to your at-risk group at an 8% claim conversion rate.</p>
                <p>Since 1 December 2025, Victoria’s amended OHS Regulations make managing psychosocial hazards an explicit legal duty. Maximum body-corporate penalties reach AU$3.85M per offence. Equivalent duties now apply in NSW, QLD, WA, SA and the UK.</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>

    <p class="calc-end">This is the cost of not having a human strategy.<br /><span>Here is how we build one.</span></p>
  </div>
</section>

<!-- How I can help: five formats as tabs, and the platform that keeps it going. -->
<section class="lift" style="background:var(--cream)">
  <div class="wrap sec">
    <div class="split" style="align-items:end">
      <div><span class="eyebrow">How I can help</span><h2>Five ways I work with leaders. <span class="mk">One platform</span> that reaches everyone.</h2></div>
      <p class="lead" style="margin-top:0">Every team meets me at a different point. The goal is the same: a human strategy that actually runs inside your organisation, owned by the leaders who built it.</p>
    </div>
    <div class="fm" data-tabs>
      <div class="tablist fm-list" role="tablist" aria-label="Ways to work with Ian">
        {FORMATS.map((f, i) => (
          <button type="button" class="fm-t" role="tab" id={`fm-t${i}`} aria-controls={`fm-p${i}`}>
            <span class="ico"><Icon name={f.icon} size={22} /></span>
            <span><b>{f.title}</b><small>{f.flag}</small></span>
          </button>
        ))}
      </div>
      <div class="fm-panels">
        {FORMATS.map((f, i) => (
          <div class="card fm-p" role="tabpanel" id={`fm-p${i}`} aria-labelledby={`fm-t${i}`}>
            <span class="fm-big"><Icon name={f.icon} size={34} /></span>
