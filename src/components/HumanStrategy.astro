    <div class="card-dark nm" data-rv>
      <div class="glow" style="right:-20%;top:-50%;width:80%;background:radial-gradient(closest-side,rgba(217,234,110,.16),rgba(217,234,110,0) 70%)"></div>
      <div class="nm-tx">
        <p class="live"><span class="pill">Available now</span><span class="dot">Live</span></p>
