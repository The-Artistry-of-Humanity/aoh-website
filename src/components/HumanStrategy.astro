<script>
  type Ind = { label: string; t: number; a: number; p: number; c: number; salary: number; note: string };
  const root = document.querySelector<HTMLElement>('[data-calc]');
  if (root) {
    const I: Record<string, Ind> = JSON.parse(root.dataset.industries || '{}');
    const nIn = root.querySelector<HTMLInputElement>('#hs-n')!;
    const indIn = root.querySelector<HTMLSelectElement>('#hs-ind')!;
    const salIn = root.querySelector<HTMLInputElement>('#hs-sal')!;
    let salary = I.other.salary, touched = false;

    // Same model as the frontmatter calc() above.
    const calc = (n: number, key: string, s: number) => {
      const ind = I[key] || I.other;
      const absenceDays = 3.1 * ind.a, turnoverRate = 0.13 * ind.t, presRate = 0.09 * ind.p;
      const absenteeism = n * (s / 230) * absenceDays, turnover = n * turnoverRate * s * 0.5, presenteeism = n * s * presRate;
      const visible = absenteeism + turnover, total = visible + presenteeism;
      const disengaging = Math.round(Math.round(n * 0.85) * 0.6);
      const burnout = Math.round(disengaging * 0.35 * ind.c);
      const crisis = Math.round(burnout * 0.04 * ind.c);
      const claims = crisis * 0.08;
      return {
        absenceDays, turnoverRate, presRate, absenteeism, turnover, presenteeism, visible, total,
        hiddenPct: total > 0 ? Math.round((presenteeism / total) * 100) : 0,
        disengaging, heading: Math.max(0, burnout - crisis), burnout, crisis, claims,
        low: claims * 379157 * 0.6, high: claims * 379157 * 1.4,
        risk: n >= 500 ? 'Significant' : n >= 100 ? 'Material' : 'Emerging', note: ind.note,
      };
    };
    const aud = (v: number) => v >= 1e9 ? `$${(v / 1e9).toFixed(2)}B` : v >= 1e6 ? `$${(v / 1e6).toFixed(2)}M` : v >= 1e3 ? `$${Math.round(v / 1e3)}k` : `$${Math.round(v)}`;
    const num = (v: number) => new Intl.NumberFormat('en-AU', { maximumFractionDigits: 0 }).format(Math.max(0, Math.round(v)));
    const pct = (c: number, n: number) => { const x = n > 0 ? (c / n) * 100 : 0; return (x < 0.1 ? '<0.1' : x.toFixed(1)) + '% of team'; };
    const claimText = (x: number) => x < 1 ? 'less than one expected psychosocial claim a year.' : `${x.toFixed(1)} expected psychosocial claims a year.`;
    const set = (k: string, v: string) => root.querySelectorAll(`[data-o="${k}"]`).forEach(el => { el.textContent = v; });

    const render = () => {
      const n = Number(nIn.value), r = calc(n, indIn.value, salary);
      nIn.style.setProperty('--p', ((n - 10) / 4990) * 100 + '%');
      set('n', num(n)); set('note', r.note);
      set('turn', (r.turnoverRate * 100).toFixed(1) + '%'); set('abs', r.absenceDays.toFixed(1) + ' days'); set('pres', Math.round(r.presRate * 100) + '%');
      set('c1', num(r.disengaging)); set('p1', pct(r.disengaging, n));
      set('c2', num(r.heading)); set('p2', pct(r.heading, n));
      set('c3', num(r.burnout)); set('p3', pct(r.burnout, n));
      set('c4', num(r.crisis)); set('p4', pct(r.crisis, n));
      set('hid', r.hiddenPct + '%'); set('total', aud(r.total));
      set('absc', aud(r.absenteeism)); set('turnc', aud(r.turnover)); set('vis', aud(r.visible)); set('presc', aud(r.presenteeism));
      set('risk', r.risk); set('crisis-n', `${num(r.crisis)} ${r.crisis === 1 ? 'person' : 'people'}`); set('claims', claimText(r.claims));
      set('low', aud(r.low)); set('high', aud(r.high));
    };

    nIn.addEventListener('input', render);
    indIn.addEventListener('change', () => {
      if (!touched) { salary = (I[indIn.value] || I.other).salary; salIn.value = String(salary); }
      render();
    });
    salIn.addEventListener('focus', () => salIn.select());
    salIn.addEventListener('input', () => {
      const raw = salIn.value.replace(/[^\d]/g, '');
      salIn.value = raw; touched = true;
      if (raw) { salary = Math.min(500000, Number(raw)); render(); }
    });
    salIn.addEventListener('blur', () => {
      const v = Number(salIn.value);
      salary = !salIn.value || Number.isNaN(v) ? I.other.salary : Math.min(500000, Math.max(30000, v));
      salIn.value = String(salary); render();
    });
    render();
  }
</script>

