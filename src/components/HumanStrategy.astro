---
/* The human strategy landing page, used by /human-strategy and
   /build-a-human-strategy. Written in Ian's voice (first person), as on the
   previous site. The cost calculator runs in the browser; its benchmarks are
   the previous site's. */
import { PILLARS } from '../data/aoh';

const BOOKING_URL = 'https://calendar.app.google/P14aVTpPNqgrVAbHA';
const INTERESTS = ['Consulting', 'Free Masterclass', 'Wellness Accelerator', 'Leadership Coaching', 'Keynote or Workshop', 'nørma', 'Just exploring'];

const PILLAR_TEXT = [
  'The energy your team actually shows up with.',
  'How they handle pressure, clarity and self-leadership.',
  'The lives behind the role, and what they bring in with them.',
  'The trust between people on your team.',
  'Whether the way you work is sustainable, or quietly burning them out.',
];

const FORMATS = [
  { flag: 'Deepest engagement', title: 'Consulting', text: 'I come in alongside your leadership team and build your human strategy with you. We map where your team actually stands across the Five Pillars, design the operating model, and embed it as a system you run, not a program you launch.', href: '/what-we-do/culture-consulting' },
  { flag: 'Best starting point', title: 'Masterclass', text: 'A focused 60 to 90 minute session for your leadership team. You leave with a shared language for the human side of the business and a clear read on where your team is strong, and where it is quietly under strain.', href: '/what-we-do/masterclass' },
  { flag: '6 weeks', title: 'Wellness Accelerator', text: 'A facilitated six-week program that takes a team through each of the Five Pillars with structured exercises, accountability and visible progress. The fastest way to move a team from idea to practice.', href: '/what-we-do/wellness-accelerator' },
  { flag: '1:1', title: 'Leadership coaching', text: 'Private coaching for senior leaders who want to model what they are asking of their teams. Grounded in the same framework, applied to your own life and your own leadership.', href: '/what-we-do/leadership-coaching' },
  { flag: 'Events', title: 'Keynotes and workshops', text: 'From a 45-minute keynote to a full-day immersive session. Tailored to your event, your audience and the conversation you want to start.', href: '/what-we-do/keynotes-workshops' },
];

/* Calculator benchmarks, from the previous site. Keep in step with the script
   at the bottom of this file. */
const INDUSTRIES: Record<string, { label: string; t: number; a: number; p: number; c: number; salary: number; note: string }> = {
  technology:    { label: 'Technology & Software',          t: 1.40, a: 0.90, p: 1.15, c: 1.10, salary: 135000, note: 'High turnover, chronic cognitive load, heavy presenteeism.' },
  financial:     { label: 'Financial Services & Banking',   t: 1.15, a: 1.00, p: 1.25, c: 1.15, salary: 140000, note: 'Long-hours culture, elevated psychosocial claim rates.' },
  professional:  { label: 'Consulting, Legal & Accounting', t: 1.35, a: 0.95, p: 1.30, c: 1.20, salary: 125000, note: 'Utilisation pressure and burnout-driven exits.' },
  healthcare:    { label: 'Healthcare & Social Care',       t: 1.30, a: 1.45, p: 1.20, c: 1.35, salary: 95000,  note: 'Highest burnout and absence rates in the economy.' },
  retail:        { label: 'Retail & Hospitality',           t: 2.30, a: 1.20, p: 1.00, c: 1.05, salary: 65000,  note: 'Volatile workforce, replacement cost dominates.' },
  construction:  { label: 'Construction & Trades',          t: 1.35, a: 1.30, p: 0.90, c: 1.40, salary: 100000, note: 'Highest suicide rate of any Australian sector.' },
  education:     { label: 'Education',                      t: 0.95, a: 1.30, p: 1.20, c: 1.25, salary: 95000,  note: 'Lower turnover, high emotional load, rising burnout.' },
  government:    { label: 'Government & Public Sector',     t: 0.70, a: 1.20, p: 1.15, c: 1.10, salary: 105000, note: 'Low turnover, elevated absence, cultural stagnation risk.' },
  manufacturing: { label: 'Manufacturing & Logistics',      t: 1.20, a: 1.30, p: 1.00, c: 1.10, salary: 90000,  note: 'Physical demand and shift work drive absence.' },
  media:         { label: 'Media, Marketing & Creative',    t: 1.50, a: 0.90, p: 1.25, c: 1.15, salary: 95000,  note: 'Deadline culture, high turnover, presenteeism heavy.' },
  other:         { label: 'Other / Mixed',                  t: 1.00, a: 1.00, p: 1.00, c: 1.00, salary: 110000, note: 'Blended Australian baseline.' },
};

function calc(n: number, key: string, salary: number) {
  const ind = INDUSTRIES[key] || INDUSTRIES.other;
  const absenceDays = 3.1 * ind.a;                    // Safe Work Australia 2024
  const turnoverRate = 0.13 * ind.t;                  // AHRI 2024
  const presRate = 0.09 * ind.p;                      // Deloitte AU 2024
  const absenteeism = n * (salary / 230) * absenceDays;
  const turnover = n * turnoverRate * salary * 0.5;   // Gallup / SHRM replacement midpoint
  const presenteeism = n * salary * presRate;
  const visible = absenteeism + turnover;
  const total = visible + presenteeism;
  const disengaging = Math.round(Math.round(n * 0.85) * 0.6);
  const burnout = Math.round(disengaging * 0.35 * ind.c);
  const crisis = Math.round(burnout * 0.04 * ind.c);
  const claims = crisis * 0.08;                       // claim conversion from crisis
  return {
    absenceDays, turnoverRate, presRate, absenteeism, turnover, presenteeism, visible, total,
    hiddenPct: total > 0 ? Math.round((presenteeism / total) * 100) : 0,
    disengaging, heading: Math.max(0, burnout - crisis), burnout, crisis, claims,
    low: claims * 379157 * 0.6, high: claims * 379157 * 1.4,
    risk: n >= 500 ? 'Significant' : n >= 100 ? 'Material' : 'Emerging',
    note: ind.note,
  };
}
const aud = (v: number) => v >= 1e9 ? `$${(v / 1e9).toFixed(2)}B` : v >= 1e6 ? `$${(v / 1e6).toFixed(2)}M` : v >= 1e3 ? `$${Math.round(v / 1e3)}k` : `$${Math.round(v)}`;
const num = (v: number) => new Intl.NumberFormat('en-AU', { maximumFractionDigits: 0 }).format(Math.max(0, Math.round(v)));
const pct = (c: number, n: number) => { const x = n > 0 ? (c / n) * 100 : 0; return (x < 0.1 ? '<0.1' : x.toFixed(1)) + '% of team'; };
const claimText = (x: number) => x < 1 ? 'less than one expected psychosocial claim a year.' : `${x.toFixed(1)} expected psychosocial claims a year.`;

const N0 = 250, S0 = INDUSTRIES.other.salary;
const r = calc(N0, 'other', S0);
---

<!-- Hero -->
<section style="background:var(--cream);overflow:hidden">
  <div class="glow" style="right:-12%;top:-20%;width:56%;background:radial-gradient(closest-side,rgba(217,234,110,.28),rgba(217,234,110,0) 70%)"></div>
  <div class="wrap split" style="padding-top:clamp(40px,6vw,88px);padding-bottom:clamp(120px,13vw,180px)">
    <div style="max-width:620px">
      <span class="eyebrow">Human strategy, with Ian Williams</span>
      <h1>Most companies have a business strategy. Few have a <span class="mk">human strategy</span>.</h1>
      <p class="lead">I help leadership teams build theirs.</p>
      <div class="btns">
        <a class="btn btn-lime" href="#contact">Book time with us</a>
        <a class="btn btn-ghost" href="#calculator">See what it’s costing you</a>
      </div>
    </div>
    <figure style="margin:0;flex:0 1 400px">
      <div class="arch" style="aspect-ratio:420/520;background:radial-gradient(64% 42% at 50% 22%,rgba(217,234,110,.6),rgba(217,234,110,.16) 55%,rgba(217,234,110,0) 82%),linear-gradient(180deg,#E8EACB,#ECE8D7 52%,#E4DFCA);position:relative">
        <img src="/assets/ian-portrait.webp" alt="Ian Williams" width="900" height="802" style="position:absolute;left:50%;bottom:0;width:128%;max-width:none;transform:translateX(-50%)" />
      </div>
      <figcaption style="text-align:center;margin-top:18px"><b style="display:block;font:400 22px/1.1 var(--serif)">Ian Williams</b><span class="who" style="display:block;margin-top:8px">Founder &amp; CEO</span></figcaption>
    </figure>
  </div>
</section>

<!-- The idea -->
<section class="bg-sand lift">
  <div class="wrap sec split" style="align-items:start">
    <div style="flex:1 1 440px">
      <span class="eyebrow">The idea</span>
      <h2>You have a business strategy. The thing it actually runs on is <span class="mk">people</span>.</h2>
      <p class="lead">You have built a strategy for the business. The market, the product, the numbers, the plan. But the thing all of it actually runs on is people. How they are doing, how they connect, whether they trust each other, whether they have anything left to give.</p>
      <p class="body">That is your human strategy. Most leaders have never named it, let alone built one.</p>
      <p class="body">A human strategy is the operating model for the part of your business that lives inside the people doing the work. It is the system that decides whether your team has the energy, clarity and trust to actually execute the plan you have set. Built well, it is quiet and load bearing. Built badly, or not at all, it is the reason good strategy quietly stops moving.</p>
    </div>
    <div class="card hs-pillars" data-rv style="flex:1 1 380px">
      <p class="pl-lead">The Five Pillars of Fulfilment are the dimensions a team actually runs on. Not a wellbeing program. The operating model itself.</p>
      <ol>
        {PILLARS.map((p, i) => <li><span>0{i + 1}</span><div><h3>{p.name}</h3><p class="body">{PILLAR_TEXT[i]}</p></div></li>)}
      </ol>
    </div>
  </div>
</section>

<!-- The cost: calculator -->
<section class="bg-dark lift-b" id="calculator" style="scroll-margin-top:60px">
  <div class="glow" style="left:20%;top:-20%;width:60%;background:radial-gradient(closest-side,rgba(217,234,110,.09),rgba(217,234,110,0) 70%)"></div>
  <div class="wrap sec">
    <div style="max-width:760px">
